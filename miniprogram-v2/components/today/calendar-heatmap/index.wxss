.calendar { display: grid; grid-template-columns: repeat(7, 1fr); gap: 8rpx; }
.calendar__weekday { padding-bottom: 12rpx; color: var(--color-muted); text-align: center; font-size: 20rpx; }
.calendar__day { position: relative; aspect-ratio: 1; display: flex; align-items: center; justify-content: center; border-radius: 12rpx; background: var(--color-surface-secondary); color: var(--color-ink); font-size: 22rpx; font-variant-numeric: tabular-nums; }
.calendar__day--blank { background: transparent; }
.calendar__day--today { box-shadow: inset 0 0 0 2rpx var(--color-ink); font-weight: 700; }
.calendar__heat { position: absolute; right: 6rpx; bottom: 6rpx; width: 8rpx; height: 8rpx; border-radius: 50%; background: var(--color-cyan); opacity: .55; }
.calendar__heat--2 { background: var(--color-primary); opacity: .75; }
.calendar__heat--3 { background: var(--color-primary); opacity: 1; }

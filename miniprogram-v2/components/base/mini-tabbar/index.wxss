.mini-tabbar { position: fixed; z-index: 100; left: 0; right: 0; bottom: 0; height: calc(110rpx + env(safe-area-inset-bottom)); padding: 8rpx 28rpx env(safe-area-inset-bottom); box-sizing: border-box; display: flex; background: rgba(255,255,255,.97); border-top: 1rpx solid #E7E8EA; }.mini-tab { flex: 1; display: flex; align-items: center; flex-direction: column; justify-content: center; gap: 2rpx; color: #6B7280; font-size: 20rpx; }.mini-tab image { width: 44rpx; height: 44rpx; }.mini-tab--active { color: #2868F5; font-weight: 600; }

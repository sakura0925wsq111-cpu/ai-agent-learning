.header { position: relative; z-index: 30; margin: 0 -34rpx 20rpx; padding-left: 34rpx; padding-right: 34rpx; background: transparent; }
.header__bar { min-height: 128rpx; display: flex; align-items: center; gap: 16rpx; }
.header__copy { flex: 1; min-width: 0; display: flex; flex-direction: column; justify-content: center; }
.header__title { overflow: hidden; color: var(--color-ink); font-size: 54rpx; line-height: 1.16; font-weight: 700; letter-spacing: -2rpx; white-space: nowrap; text-overflow: ellipsis; }
.header__eyebrow { display: block; margin-top: 10rpx; color: var(--color-secondary); font-size: 23rpx; line-height: 1.35; font-weight: 450; }
.header__back, .header__action { flex: none; margin: 0; padding: 0; display: flex; align-items: center; justify-content: center; background: transparent; color: var(--color-ink); transition: transform 120ms ease; }
.header__back:active, .header__action:active { transform: scale(.92); }
.header__back { width: 52rpx; height: 64rpx; border-radius: 0; font-size: 58rpx; font-weight: 300; line-height: 1; }
.header__back-icon { transform: translateY(-2rpx); }
.header__action { min-width: 92rpx; height: 64rpx; padding: 0 22rpx; border-radius: 32rpx; background: var(--color-surface); color: var(--color-primary); font-size: 23rpx; font-weight: 600; box-shadow: var(--shadow-module); }
.header--compact { margin-bottom: 22rpx; }
.header--compact .header__bar { min-height: 92rpx; }
.header--compact .header__copy { align-items: center; }
.header--compact .header__title { font-size: 32rpx; letter-spacing: -.5rpx; }
.header--compact .header__eyebrow { margin-top: 3rpx; font-size: 20rpx; }

<view class="question"><view class="question__step">问题 {{question.index || 1}} / {{question.total || 5}}</view><text class="question__title">{{question.title}}</text><view wx:if="{{question.options && question.options.length}}" class="question__options"><button wx:for="{{question.options}}" wx:key="*this" class="question__option" disabled="{{disabled}}" data-value="{{item}}" bindtap="choose"><text>{{item}}</text><text>→</text></button></view></view>

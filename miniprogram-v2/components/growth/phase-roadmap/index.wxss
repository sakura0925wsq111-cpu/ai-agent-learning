.roadmap { width: 100%; overflow: hidden; }.roadmap__inner { width: 100%; display: flex; }.phase { position: relative; flex: 1; min-width: 0; display: flex; align-items: center; flex-direction: column; text-align: center; }.phase__rail { width: 100%; height: 45rpx; display: flex; align-items: center; justify-content: center; }.phase__dot { position: relative; z-index: 2; width: 42rpx; height: 42rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: #D7DAE0; color: #FFFFFF; font-size: 21rpx; font-weight: 650; }.phase__line { position: absolute; left: calc(50% + 21rpx); top: 21rpx; width: calc(100% - 42rpx); height: 3rpx; background: #D7DAE0; }.phase__title { width: 100%; margin-top: 14rpx; overflow: hidden; color: var(--color-ink); font-size: 19rpx; line-height: 1.35; white-space: nowrap; text-overflow: ellipsis; }.phase__count { margin-top: 8rpx; color: var(--color-muted); font-size: 16rpx; }.phase--current .phase__dot { background: var(--color-primary); box-shadow: 0 0 0 7rpx var(--color-primary-soft); }.phase--current .phase__title, .phase--current .phase__count { color: var(--color-primary); }

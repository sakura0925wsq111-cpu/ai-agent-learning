.track__item { min-height: 126rpx; display: grid; grid-template-columns: 104rpx 24rpx 1fr; gap: 14rpx; }
.track__label { padding-top: 2rpx; color: var(--color-primary); font-size: 21rpx; font-weight: 650; }
.track__rail { position: relative; display: flex; justify-content: center; }
.track__dot { position: relative; z-index: 1; width: 12rpx; height: 12rpx; margin-top: 9rpx; border: 5rpx solid var(--color-surface); border-radius: 50%; background: var(--color-primary); box-shadow: 0 0 0 2rpx var(--color-primary); }
.track__line { position: absolute; top: 25rpx; bottom: -2rpx; width: 2rpx; background: var(--color-line); }
.track__text { padding-bottom: 28rpx; color: var(--color-secondary); font-size: 24rpx; line-height: 1.6; }

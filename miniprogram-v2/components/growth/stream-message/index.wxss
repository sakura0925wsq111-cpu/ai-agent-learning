.message { max-width: 92%; display: flex; align-items: flex-start; gap: 12rpx; }
.message__avatar { display: none; }
.message__body { min-width: 0; display: flex; flex-direction: column; gap: 7rpx; }
.message__role { display: none; }
.message__content { padding: 22rpx 25rpx; border-radius: 22rpx; background: var(--color-surface); border: 0; color: var(--color-ink); font-size: 25rpx; line-height: 1.68; white-space: pre-wrap; box-shadow: var(--shadow-module); }
.message--user { align-self: flex-end; justify-content: flex-end; }
.message--user .message__body { align-items: flex-end; }
.message--user .message__content { border: 0; border-radius: 22rpx; background: #E8EEFC; color: var(--color-ink); box-shadow: none; }

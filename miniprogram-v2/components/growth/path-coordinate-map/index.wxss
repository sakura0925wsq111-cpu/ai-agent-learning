.map__grid { display: grid; grid-template-columns: 1fr 1fr; gap: 18rpx; }
.path { position: relative; min-height: 294rpx; box-sizing: border-box; padding: 26rpx 28rpx; overflow: hidden; border: 2rpx solid #E1E3E7; border-radius: 22rpx; background: var(--color-surface); box-shadow: 0 8rpx 25rpx rgba(30,45,70,.035); }
.path__top { display: flex; align-items: flex-start; justify-content: space-between; }.path__icon { width: 66rpx; height: 66rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: var(--color-primary-soft); color: var(--color-primary); font-size: 34rpx; }.path__mark { width: 34rpx; height: 34rpx; display: flex; align-items: center; justify-content: center; border: 2rpx solid #B9BFC8; border-radius: 50%; color: #FFFFFF; font-size: 20rpx; }
.path__title, .path__desc { position: relative; z-index: 2; display: block; }.path__title { margin-top: 24rpx; color: var(--color-ink); font-size: 31rpx; font-weight: 700; }.path__desc { max-width: 250rpx; margin-top: 16rpx; color: var(--color-secondary); font-size: 21rpx; line-height: 1.55; }
.path__watermark { position: absolute; right: -12rpx; bottom: -20rpx; color: var(--color-primary); font-size: 100rpx; opacity: .08; }.path--civil .path__icon, .path--civil .path__watermark { color: var(--color-success); background: var(--color-success-soft); }.path--major .path__icon, .path--major .path__watermark { color: #EF850D; background: var(--color-warning-soft); }
.path--selected { border-color: var(--color-primary); background: #F5F8FF; }.path--selected .path__mark { border-color: var(--color-primary); background: var(--color-primary); }

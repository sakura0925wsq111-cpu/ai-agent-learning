<bottom-sheet visible="{{visible}}" title="{{value.id ? '编辑待办' : '新增待办'}}" submit-label="保存待办" submitting="{{submitting}}" bind:close="close" bind:submit="submit"><view class="form"><text class="label">任务内容</text><textarea class="field area" value="{{title}}" bindinput="titleInput" maxlength="500" placeholder="写下一个可完成的动作"/><text class="label">截止日期（可选）</text><picker mode="date" value="{{deadline}}" bindchange="dateChange"><view class="field">{{deadline || '未安排日期'}}</view></picker></view></bottom-sheet>

<bottom-sheet visible="{{visible}}" title="事项详情" bind:close="close"><view class="detail"><source-badge source="{{event.source || 'manual'}}" label="{{event.typeLabel || ''}}"/><text class="detail__title">{{event.title}}</text><text class="detail__line">时间 · {{event.timeLabel || '未安排'}}</text><text wx:if="{{event.location}}" class="detail__line">地点 · {{event.location}}</text></view></bottom-sheet>

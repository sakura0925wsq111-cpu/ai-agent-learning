<view wx:if="{{visible}}" class="sheet-root"><view class="sheet__mask" bindtap="close"></view><view class="sheet" catchtap="noop"><view class="sheet__handle"></view><view class="sheet__head"><text class="sheet__title">{{title}}</text><button class="sheet__close" bindtap="close">×</button></view><scroll-view class="sheet__body" scroll-y enhanced><slot /></scroll-view><view wx:if="{{submitLabel}}" class="sheet__footer"><button class="sheet__submit {{destructive ? 'sheet__submit--danger' : ''}}" disabled="{{submitting}}" bindtap="submit">{{submitting ? '处理中…' : submitLabel}}</button></view><view class="sheet__safe"></view></view></view>

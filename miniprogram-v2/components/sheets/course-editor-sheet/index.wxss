.form { padding-top: 8rpx; }.label { display: block; margin: 20rpx 0 8rpx; color: var(--color-secondary); font-size: 22rpx; }.field { box-sizing: border-box; width: 100%; min-height: 84rpx; padding: 20rpx; border-radius: var(--radius-control); background: var(--color-surface-secondary); color: var(--color-ink); font-size: 25rpx; }.grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16rpx; }

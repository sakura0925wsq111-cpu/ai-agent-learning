<bottom-sheet visible="{{visible}}" title="新增课程" submit-label="保存课程" submitting="{{submitting}}" bind:close="close" bind:submit="submit"><view class="form"><text class="label">课程名称</text><input class="field" data-key="name" value="{{name}}" bindinput="setField"/><view class="grid"><view><text class="label">教师</text><input class="field" data-key="teacher" value="{{teacher}}" bindinput="setField"/></view><view><text class="label">地点</text><input class="field" data-key="location" value="{{location}}" bindinput="setField"/></view></view><text class="label">上课日</text><picker mode="selector" range="{{weekdays}}" value="{{weekday-1}}" bindchange="weekday"><view class="field">{{weekdayLabel}}</view></picker><view class="grid"><view><text class="label">开始节次</text><input class="field" type="number" data-key="start" value="{{start}}" bindinput="setField"/></view><view><text class="label">结束节次</text><input class="field" type="number" data-key="end" value="{{end}}" bindinput="setField"/></view></view><text class="label">周次</text><input class="field" data-key="weeks" value="{{weeks}}" bindinput="setField"/></view></bottom-sheet>

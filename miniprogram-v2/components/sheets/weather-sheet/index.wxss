.content { padding-top: 16rpx; }.weather { padding: 28rpx; display: flex; align-items: center; gap: 24rpx; border-radius: var(--radius-module); background: var(--color-graphite); color: #F7F8FA; }.weather__temp { font-size: 72rpx; font-weight: 700; }.weather__condition, .weather__meta { display: block; }.weather__condition { font-size: 28rpx; }.weather__meta { margin-top: 8rpx; color: #AAB1BC; font-size: 21rpx; }.advice, .notice { display: block; margin-top: 18rpx; color: var(--color-secondary); font-size: 24rpx; line-height: 1.6; }.label { display: block; margin: 28rpx 0 10rpx; color: var(--color-secondary); font-size: 23rpx; }.field { box-sizing: border-box; width: 100%; padding: 22rpx; border-radius: var(--radius-control); background: var(--color-surface-secondary); color: var(--color-ink); font-size: 27rpx; }

<bottom-sheet visible="{{visible}}" title="天气与城市" submit-label="更新天气" bind:close="close" bind:submit="submit"><view class="content"><view wx:if="{{weather.available}}" class="weather"><text class="weather__temp">{{weather.temp}}°</text><view><text class="weather__condition">{{weather.condition}}</text><text class="weather__meta">湿度 {{weather.humidity}}% · {{weather.location}}</text></view></view><text wx:else class="notice">天气暂不可用，你仍可正常查看日程。</text><text wx:if="{{weather.advice}}" class="advice">{{weather.advice}}</text><text class="label">天气城市</text><input class="field" value="{{draftCity}}" bindinput="input" maxlength="30" /></view></bottom-sheet>

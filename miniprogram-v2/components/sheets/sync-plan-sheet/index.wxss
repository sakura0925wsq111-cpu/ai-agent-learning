.sync { padding: 22rpx 0 36rpx; }.sync__title { display: block; color: var(--color-ink); font-size: 31rpx; font-weight: 680; }.sync__copy { display: block; margin-top: 14rpx; color: var(--color-secondary); font-size: 24rpx; line-height: 1.65; }.label { display: block; margin: 30rpx 0 10rpx; color: var(--color-secondary); font-size: 22rpx; }.field { box-sizing: border-box; width: 100%; padding: 22rpx; border-radius: var(--radius-control); background: var(--color-surface-secondary); color: var(--color-ink); font-size: 26rpx; }.note { display: block; margin-top: 14rpx; color: var(--color-muted); font-size: 20rpx; }

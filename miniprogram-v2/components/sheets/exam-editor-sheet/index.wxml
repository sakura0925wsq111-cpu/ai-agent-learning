<bottom-sheet visible="{{visible}}" title="新增考试" submit-label="保存考试" submitting="{{submitting}}" bind:close="close" bind:submit="submit"><view class="form"><text class="label">考试科目</text><input class="field" data-key="subject" value="{{subject}}" bindinput="input"/><text class="label">考试日期</text><picker mode="date" data-key="examDate" value="{{examDate}}" bindchange="change"><view class="field">{{examDate || '请选择日期'}}</view></picker><view class="grid"><view><text class="label">开始时间</text><picker mode="time" data-key="startTime" value="{{startTime}}" bindchange="change"><view class="field">{{startTime || '待定'}}</view></picker></view><view><text class="label">结束时间</text><picker mode="time" data-key="endTime" value="{{endTime}}" bindchange="change"><view class="field">{{endTime || '待定'}}</view></picker></view></view><text class="label">地点</text><input class="field" data-key="location" value="{{location}}" bindinput="input"/></view></bottom-sheet>

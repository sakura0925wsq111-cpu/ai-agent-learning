.capacity { padding: 28rpx; display: flex; align-items: center; justify-content: space-between; gap: 24rpx; }.capacity__value { display: block; color: var(--color-ink); font-size: 40rpx; font-weight: 720; }.capacity__note { max-width: 330rpx; color: var(--color-secondary); font-size: 19rpx; line-height: 1.5; }.filters { margin: 20rpx -30rpx; }.filters__inner { padding: 0 30rpx; display: inline-flex; gap: 10rpx; }.filter { min-height: 58rpx; padding: 0 22rpx; display: flex; align-items: center; border-radius: 999rpx; background: var(--color-surface-secondary); color: var(--color-secondary); font-size: 21rpx; }.filter.active { background: var(--color-primary); color: white; }.memories { display: flex; flex-direction: column; gap: 14rpx; }.memory__head { display: flex; align-items: flex-start; justify-content: space-between; gap: 14rpx; }.memory__key { display: block; margin-top: 8rpx; color: var(--color-ink); font-size: 28rpx; font-weight: 650; }.memory__value { display: block; margin-top: 20rpx; padding: 19rpx; border-radius: 20rpx; background: var(--color-surface-secondary); color: var(--color-secondary); font-size: 24rpx; line-height: 1.6; white-space: pre-wrap; }.memory__foot { margin-top: 18rpx; padding-top: 16rpx; display: flex; justify-content: space-between; border-top: 1rpx solid var(--color-line); color: var(--color-muted); font-size: 19rpx; }.memory__foot > view { display: flex; gap: 20rpx; color: var(--color-primary); }

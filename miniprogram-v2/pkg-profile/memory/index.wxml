<view class="page--plain"><app-header title="AI 记忆" eyebrow="可查看、可修改、可删除" back bind:back="back"/><view class="capacity card"><view><text class="capacity__value">{{panel.total || 0}} / {{panel.max_capacity || 50}}</text><text class="caption">已保存条目 / 容量</text></view><text class="capacity__note">数量只表示已保存条目，不代表 AI 了解程度。</text></view><scroll-view class="filters" scroll-x show-scrollbar="false"><view class="filters__inner"><view wx:for="{{types}}" wx:key="key" class="filter {{type === item.key ? 'active' : ''}}" data-type="{{item.key}}" bindtap="type">{{item.label}}</view></view></scroll-view><view wx:if="{{loading}}" class="card"><skeleton rows="5"/></view><state-view wx:elif="{{error}}" state="error" title="记忆暂不可用" message="{{error}}" bind:action="retry"/><view wx:else class="memories"><view wx:for="{{memories}}" wx:key="key" class="memory card"><view class="memory__head"><view><text class="eyebrow">{{item.typeLabel}} · 重要度 {{item.importance}}/10</text><text class="memory__key">{{item.key}}</text></view><text class="pill">置信度 {{item.confidenceLabel}}</text></view><text class="memory__value">{{item.value}}</text><view class="memory__foot"><text>来源 · {{item.sourceLabel}}</text><view><text data-item="{{item}}" bindtap="edit">编辑</text><text class="danger" data-item="{{item}}" bindtap="askDelete">删除</text></view></view></view><state-view wx:if="{{!memories.length}}" state="empty" title="这个分类暂无记忆" message="规划和对话中经确认的信息会逐步形成可见记忆。"/></view></view><confirm-sheet visible="{{deleting !== null}}" title="删除这条记忆？" message="删除后，后续规划和教练对话不会再读取这条信息。" confirm-label="确认删除" destructive submitting="{{submitting}}" bind:close="closeDelete" bind:confirm="remove"/>

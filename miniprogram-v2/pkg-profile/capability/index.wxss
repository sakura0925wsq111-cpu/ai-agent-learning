.capability-page { padding-top: 0; }.capability-hero { position: relative; min-height: 430rpx; box-sizing: border-box; margin: 0 -34rpx; padding: 0 34rpx 32rpx; overflow: hidden; border-radius: 0 0 62rpx 62rpx; background: var(--color-hero); }.capability-hero app-header { position: relative; z-index: 3; }.capability-art { position: absolute; right: 12rpx; top: 118rpx; width: 280rpx; height: 235rpx; opacity: .42; }.capability-art view:first-child { position: absolute; right: 34rpx; bottom: 0; width: 170rpx; height: 150rpx; border-radius: 50% 50% 0 0; background: #B9CCF6; }.capability-art view:nth-child(2) { position: absolute; right: 45rpx; bottom: 16rpx; width: 130rpx; height: 72rpx; border-bottom: 24rpx solid #FFFFFF; border-radius: 50%; transform: rotate(-18deg); }.capability-art > text { position: absolute; right: 18rpx; top: 4rpx; color: #86A9F6; font-size: 78rpx; }
.capability-user { position: relative; z-index: 2; margin: 50rpx 18rpx 0; display: flex; align-items: center; gap: 22rpx; }.capability-avatar { width: 76rpx; height: 76rpx; display: flex; align-items: center; justify-content: center; border: 4rpx solid #FFFFFF; border-radius: 50%; background: #7FA5FA; color: #FFFFFF; font-size: 30rpx; font-weight: 650; }.capability-user text { display: block; }.capability-user text:first-child { color: var(--color-ink); font-size: 29rpx; font-weight: 650; }.capability-user text:last-child { margin-top: 8rpx; color: var(--color-secondary); font-size: 21rpx; }.capability-stats { position: relative; z-index: 2; margin-top: 48rpx; display: grid; grid-template-columns: repeat(3,1fr); }.capability-stats > view { display: flex; align-items: center; flex-direction: column; gap: 7rpx; border-right: 1rpx solid rgba(107,114,128,.2); color: var(--color-secondary); font-size: 19rpx; }.capability-stats > view:last-child { border-right: 0; }.capability-stats > view > text:first-child { color: var(--color-ink); font-size: 42rpx; line-height: 1; font-weight: 650; }.capability-stats > view > text:first-child text { color: var(--color-secondary); font-size: 25rpx; font-weight: 400; }.loading-card { margin-top: 30rpx; }
.latest-report { position: relative; z-index: 3; margin-top: -18rpx; padding: 28rpx; display: grid; grid-template-columns: 78rpx 1fr 72rpx; align-items: center; gap: 18rpx; }.report-mark { width: 70rpx; height: 70rpx; display: flex; align-items: center; justify-content: center; border-radius: 16rpx; background: var(--color-primary-soft); color: var(--color-primary); font-size: 35rpx; }.latest-report text { display: block; }.latest-report > view:nth-child(2) text:first-child { color: var(--color-ink); font-size: 21rpx; }.latest-report > view:nth-child(2) text:nth-child(2) { margin-top: 8rpx; color: var(--color-ink); font-size: 29rpx; font-weight: 650; }.latest-report > view:nth-child(2) text:last-child { margin-top: 8rpx; color: var(--color-secondary); font-size: 20rpx; }.report-side { display: flex; align-items: center; gap: 14rpx; color: #9298A2; font-size: 34rpx; }.report-side text:first-child { width: 54rpx; height: 54rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: var(--color-primary-soft); color: var(--color-primary); font-size: 27rpx; }
.insight-grid { margin-top: 22rpx; display: grid; grid-template-columns: 1fr 1fr; gap: 20rpx; }.insight-card { min-height: 240rpx; box-sizing: border-box; padding: 24rpx 24rpx 20rpx; }.insight-head { display: flex; align-items: center; gap: 12rpx; color: var(--color-ink); font-size: 22rpx; font-weight: 650; }.insight-head text:first-child { width: 40rpx; height: 40rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; }.insight-head--green text:first-child { background: var(--color-success-soft); color: var(--color-success); }.insight-head--orange text:first-child { background: var(--color-warning-soft); color: #EA710B; }.insight-item { position: relative; display: block; margin: 20rpx 0 0 28rpx; color: var(--color-ink); font-size: 21rpx; }.insight-item::before { content: ""; position: absolute; left: -22rpx; top: 10rpx; width: 7rpx; height: 7rpx; border-radius: 50%; }.insight-item--green::before { background: var(--color-success); }.insight-item--orange::before { background: #EF7A0B; }.insight-source { margin-top: 26rpx; padding-top: 17rpx; border-top: 1rpx solid var(--color-line); color: var(--color-secondary); font-size: 17rpx; }.insight-source text { float: right; font-size: 24rpx; }
.report-empty { margin-top: 22rpx; padding: 34rpx 30rpx 30rpx; }.report-empty text { display: block; }.report-empty text:first-child { color: var(--color-ink); font-size: 28rpx; font-weight: 650; }.report-empty text:nth-child(2) { margin-top: 12rpx; color: var(--color-secondary); font-size: 22rpx; line-height: 1.55; }.report-empty button { margin-top: 25rpx; min-height: 74rpx; }
.next-step { margin-top: 22rpx; padding: 28rpx; display: grid; grid-template-columns: 68rpx 1fr 24rpx; align-items: center; gap: 18rpx; border: 2rpx solid #D9E5FF; background: #F2F6FF; }.next-step__icon { width: 58rpx; height: 58rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: var(--color-primary); color: #FFFFFF; font-size: 27rpx; }.next-step text { display: block; }.next-step > view:nth-child(2) text:first-child { color: var(--color-primary); font-size: 20rpx; }.next-step > view:nth-child(2) text:nth-child(2) { margin-top: 9rpx; color: var(--color-ink); font-size: 27rpx; font-weight: 650; }.next-step > view:nth-child(2) text:last-child { margin-top: 8rpx; color: var(--color-secondary); font-size: 19rpx; }.next-step__arrow { color: #8C929B; font-size: 39rpx; }
.memory-summary { margin-top: 22rpx; padding: 28rpx; }.card-heading { color: var(--color-ink); font-size: 24rpx; }.memory-types { margin-top: 25rpx; display: grid; grid-template-columns: repeat(4,1fr); border: 1rpx solid var(--color-line); border-radius: 14rpx; }.memory-types > view { padding: 18rpx 6rpx; display: flex; align-items: center; flex-direction: column; gap: 7rpx; border-right: 1rpx solid var(--color-line); color: var(--color-secondary); font-size: 17rpx; }.memory-types > view:last-child { border-right: 0; }.memory-types > view text:first-child { font-size: 31rpx; }.memory-types > view text:last-child { color: var(--color-ink); font-size: 25rpx; }.green { color: var(--color-success); }.orange { color: #F07B0B; }.purple { color: #8658E8; }.improve { margin-top: 26rpx; }.manage { margin-top: 12rpx; }.source-line { margin-top: 23rpx; color: #8A909A; font-size: 17rpx; text-align: center; }.capability-page { padding-bottom: calc(140rpx + env(safe-area-inset-bottom)); }
.insight-source { display: flex; align-items: center; justify-content: space-between; }.insight-source text { float: none; }

<view class="page--plain"><app-header title="历史与报告" eyebrow="成长档案" back bind:back="back"/><view class="tabs"><view class="{{tab === 'reports' ? 'active' : ''}}" data-tab="reports" bindtap="tab">报告 {{reports.length}}</view><view class="{{tab === 'sessions' ? 'active' : ''}}" data-tab="sessions" bindtap="tab">会话 {{sessions.length}}</view></view><view wx:if="{{loading}}" class="card"><skeleton rows="5"/></view><state-view wx:elif="{{error}}" state="error" title="历史暂不可用" message="{{error}}" bind:action="retry"/><view wx:elif="{{tab === 'reports'}}" class="list"><view wx:for="{{reports}}" wx:key="report_id" class="item card" data-id="{{item.session_id}}" bindtap="openReport"><view><text class="eyebrow">{{item.agentLabel}} · {{item.dateLabel}}</text><text class="item__title">{{item.title}}</text><text class="item__copy">{{item.summary}}</text><text class="item__status">{{item.is_executing ? '执行进度 ' + item.percent + '%' : '尚未加入行动'}}</text></view><text class="item__arrow">→</text></view><state-view wx:if="{{!reports.length}}" state="empty" title="还没有规划报告" message="完成专项规划后会自动保存。"/></view><view wx:else class="list"><view wx:for="{{sessions}}" wx:key="session_id" class="item card" data-item="{{item}}" bindtap="openSession"><view><text class="eyebrow">{{item.agentLabel}} · {{item.dateLabel}}</text><text class="item__title">{{item.finished ? '已完成会话' : '未完成会话'}}</text><text class="item__copy">{{item.message_count}} 条消息 · 阶段 {{item.stage}}</text></view><text class="item__arrow">→</text></view><state-view wx:if="{{!sessions.length}}" state="empty" title="还没有规划会话"/></view></view>

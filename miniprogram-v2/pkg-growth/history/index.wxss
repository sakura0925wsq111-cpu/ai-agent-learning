.tabs { margin-bottom: 24rpx; padding: 6rpx; display: grid; grid-template-columns: 1fr 1fr; border-radius: 20rpx; background: var(--color-surface-secondary); }.tabs > view { min-height: 66rpx; display: flex; align-items: center; justify-content: center; color: var(--color-secondary); font-size: 23rpx; }.tabs .active { border-radius: 16rpx; background: var(--color-surface); color: var(--color-ink); font-weight: 650; box-shadow: 0 4rpx 12rpx rgba(19,28,45,.08); }.list { display: flex; flex-direction: column; gap: 14rpx; }.item { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; }.item__title, .item__copy, .item__status { display: block; }.item__title { margin-top: 8rpx; color: var(--color-ink); font-size: 29rpx; font-weight: 650; }.item__copy { max-width: 560rpx; margin-top: 10rpx; overflow: hidden; color: var(--color-secondary); font-size: 22rpx; white-space: nowrap; text-overflow: ellipsis; }.item__status { margin-top: 14rpx; color: var(--color-primary); font-size: 20rpx; }.item__arrow { color: var(--color-secondary); font-size: 36rpx; }

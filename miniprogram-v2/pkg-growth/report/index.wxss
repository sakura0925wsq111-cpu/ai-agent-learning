.report-page { padding-top: 0; }.report-hero { position: relative; min-height: 430rpx; box-sizing: border-box; margin: 0 -34rpx; padding: 0 44rpx 38rpx; overflow: hidden; border-radius: 0 0 60rpx 60rpx; background: var(--color-hero); }.report-hero app-header { position: relative; z-index: 3; }.report-kicker, .report-title, .report-summary { position: relative; z-index: 2; display: block; }.report-kicker { margin-top: 22rpx; color: #6177A5; font-size: 20rpx; }.report-title { margin-top: 30rpx; color: #05070A; font-size: 50rpx; font-weight: 750; letter-spacing: -2rpx; }.report-summary { max-width: 500rpx; margin-top: 18rpx; color: var(--color-secondary); font-size: 23rpx; line-height: 1.5; }.report-goal { position: relative; z-index: 2; margin-top: 30rpx; display: flex; align-items: center; gap: 13rpx; color: var(--color-secondary); font-size: 23rpx; }.report-goal text:first-child { color: var(--color-primary); font-size: 31rpx; }.report-art { position: absolute; right: 2rpx; bottom: 8rpx; width: 285rpx; height: 255rpx; opacity: .43; }.report-art view:first-child { position: absolute; right: 10rpx; bottom: 12rpx; width: 235rpx; height: 115rpx; border-radius: 50%; background: #AFC4F3; }.report-art view:nth-child(2) { position: absolute; right: 72rpx; bottom: 12rpx; width: 68rpx; height: 190rpx; border: 24rpx solid #FFFFFF; border-top: 0; border-bottom: 0; border-radius: 50%; transform: rotate(42deg); }.report-art text { position: absolute; right: 94rpx; top: 0; color: var(--color-primary); font-size: 78rpx; }.loading-card { margin-top: 28rpx; }
.progress-card { position: relative; z-index: 3; margin-top: -18rpx; padding: 28rpx 30rpx 32rpx; }.progress-label { color: var(--color-ink); font-size: 25rpx; }.progress-row { margin-top: 18rpx; display: flex; align-items: flex-end; gap: 24rpx; }.progress-value { color: var(--color-primary); font-size: 64rpx; line-height: 1; font-weight: 650; }.progress-value text { font-size: 40rpx; }.progress-count { margin-bottom: 7rpx; color: var(--color-secondary); font-size: 20rpx; }.progress-count text { color: var(--color-primary); font-size: 26rpx; font-weight: 650; }.progress-status { margin: 0 0 7rpx auto; color: var(--color-success); font-size: 20rpx; }.progress-track { height: 13rpx; margin-top: 24rpx; overflow: hidden; border-radius: 999rpx; background: #E6E9EE; }.progress-track view { height: 100%; border-radius: 999rpx; background: var(--color-primary); }.roadmap-card { margin-top: 22rpx; padding: 28rpx 20rpx 20rpx; }.report-bento { margin-top: 22rpx; display: grid; grid-template-columns: 1.45fr .8fr; gap: 18rpx; }.phase-detail { padding: 26rpx; }.phase-detail__head { display: flex; align-items: center; justify-content: space-between; }.phase-detail__head text:first-child { padding: 7rpx 12rpx; border-radius: 9rpx; background: var(--color-primary-soft); color: var(--color-primary); font-size: 18rpx; }.phase-detail__head text:last-child { padding: 7rpx 12rpx; border-radius: 999rpx; background: var(--color-success-soft); color: var(--color-success); font-size: 18rpx; }.phase-detail__title { display: block; margin-top: 20rpx; color: var(--color-ink); font-size: 29rpx; font-weight: 700; }.phase-tasks { margin-top: 25rpx; border: 1rpx solid var(--color-line); border-radius: 13rpx; overflow: hidden; }.phase-tasks > text { display: block; padding: 16rpx 18rpx; color: var(--color-ink); font-size: 19rpx; border-bottom: 1rpx solid var(--color-line); }.phase-tasks > view { min-height: 70rpx; padding: 12rpx 17rpx; display: flex; align-items: center; gap: 12rpx; border-bottom: 1rpx solid var(--color-line); }.phase-tasks > view:last-child { border-bottom: 0; }.phase-tasks > view > text { flex: none; width: 31rpx; height: 31rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: var(--color-primary); color: #FFFFFF; font-size: 17rpx; }.phase-tasks > view view text { display: block; }.phase-tasks > view view text:first-child { color: var(--color-ink); font-size: 20rpx; }.phase-tasks > view view text:last-child { margin-top: 4rpx; color: var(--color-secondary); font-size: 16rpx; }.sync-button { min-height: 60rpx; margin: 22rpx 0 0; border: 1rpx solid #BDD0FA; border-radius: 12rpx; background: var(--color-primary-soft); color: var(--color-primary); font-size: 20rpx; }.report-insights { padding: 26rpx 22rpx; display: flex; flex-direction: column; }.report-insights > view:not(.insight-divider) { flex: 1; display: flex; flex-direction: column; gap: 10rpx; }.report-insights > view > text:nth-child(2) { color: var(--color-secondary); font-size: 18rpx; }.report-insights > view > text:last-child { color: var(--color-ink); font-size: 21rpx; line-height: 1.45; }.insight-icon { width: 42rpx; height: 42rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; font-size: 27rpx; }.insight-icon--blue { background: var(--color-primary-soft); color: var(--color-primary); }.insight-icon--orange { background: var(--color-warning-soft); color: #EC7509; }.insight-divider { height: 1rpx; margin: 20rpx 0; background: var(--color-line); }
.truth { margin-top: 22rpx; padding: 19rpx 24rpx; display: flex; align-items: flex-start; gap: 13rpx; border-radius: 13rpx; background: var(--color-primary-soft); color: var(--color-secondary); font-size: 18rpx; line-height: 1.55; }.truth text:first-child { color: var(--color-primary); font-size: 25rpx; }.action-button { margin-top: 18rpx; }.source-line { margin-top: 20rpx; color: #8A909A; font-size: 17rpx; text-align: center; }
.report-summary text { display: block; margin-bottom: 10rpx; }.report-summary text:last-child { margin-bottom: 0; }.report-goal { align-items: flex-start; }.report-goal__copy { flex: 1; min-width: 0; }.report-goal__copy text { display: block; line-height: 1.55; }.phase-sync--pending { background: #F1F3F6 !important; color: var(--color-secondary) !important; }.phase-task-state { background: #F1F3F6 !important; color: var(--color-secondary) !important; }.phase-task-state--done { background: var(--color-success) !important; color: #FFFFFF !important; }.insight-copy { display: block; color: var(--color-ink); font-size: 21rpx; line-height: 1.55; }

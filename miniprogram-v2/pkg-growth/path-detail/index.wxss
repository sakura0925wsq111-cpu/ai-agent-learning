.detail-page { padding-top: 0; }.detail-hero { position: relative; min-height: 405rpx; box-sizing: border-box; margin: 0 -34rpx; padding: 0 34rpx 36rpx; overflow: hidden; border-radius: 0 0 60rpx 60rpx; background: var(--color-hero); }.detail-hero app-header { position: relative; z-index: 3; }.detail-title { position: relative; z-index: 2; display: block; margin: 12rpx 12rpx 0; color: #05070A; font-size: 47rpx; font-weight: 750; letter-spacing: -1rpx; }.core-insight { position: relative; z-index: 2; min-height: 112rpx; margin-top: 48rpx; padding: 0 26rpx; display: flex; align-items: center; gap: 20rpx; border-radius: 21rpx; background: rgba(217,227,251,.75); }.core-insight > text { flex: none; width: 48rpx; height: 48rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: #FFFFFF; color: var(--color-primary); font-size: 29rpx; }.core-insight view text { display: block; }.core-insight view text:first-child { max-width: 590rpx; color: var(--color-ink); font-size: 25rpx; line-height: 1.45; font-weight: 650; }.core-insight view text:last-child { margin-top: 10rpx; color: var(--color-secondary); font-size: 18rpx; }.detail-art { position: absolute; right: 8rpx; top: 30rpx; width: 270rpx; height: 240rpx; opacity: .35; }.detail-art view:first-child { position: absolute; right: 10rpx; top: 20rpx; width: 220rpx; height: 210rpx; border-radius: 50%; background: #B6C9F5; }.detail-art view:nth-child(2) { position: absolute; right: 53rpx; top: 22rpx; width: 74rpx; height: 205rpx; border: 24rpx solid #FFFFFF; border-top: 0; border-bottom: 0; border-radius: 50%; transform: rotate(45deg); }.detail-art view:last-child { position: absolute; left: 16rpx; bottom: 8rpx; width: 48rpx; height: 13rpx; border-radius: 3rpx; background: #7C9FEA; }.loading-card { margin-top: 30rpx; }
.future-card { position: relative; z-index: 3; margin-top: -18rpx; padding: 28rpx 34rpx 12rpx; }.card-heading { display: block; margin-bottom: 22rpx; color: var(--color-ink); font-size: 29rpx; font-weight: 700; }.future-step { min-height: 82rpx; display: grid; grid-template-columns: 38rpx 165rpx 1fr; gap: 12rpx; }.future-rail { position: relative; display: flex; justify-content: center; }.future-dot { position: relative; z-index: 2; width: 25rpx; height: 25rpx; display: flex; align-items: center; justify-content: center; border: 4rpx solid #FFFFFF; border-radius: 50%; background: #C6CAD1; color: #FFFFFF; font-size: 16rpx; box-shadow: 0 0 0 3rpx #C6CAD1; }.future-dot--green { background: var(--color-success); box-shadow: 0 0 0 3rpx var(--color-success); }.future-dot--blue { background: var(--color-primary); box-shadow: 0 0 0 3rpx var(--color-primary); }.future-line { position: absolute; top: 28rpx; bottom: -2rpx; width: 3rpx; border-left: 3rpx dashed #C6CAD1; }.future-time { color: var(--color-secondary); font-size: 22rpx; }.future-copy { color: var(--color-ink); font-size: 21rpx; line-height: 1.5; }.green { color: var(--color-success); }.blue { color: var(--color-primary); }
.fit-grid { margin-top: 22rpx; display: grid; grid-template-columns: 1fr 1fr; gap: 18rpx; }.fit-card { min-height: 170rpx; box-sizing: border-box; padding: 24rpx; }.fit-head { display: flex; align-items: center; gap: 11rpx; color: var(--color-ink); font-size: 23rpx; font-weight: 650; }.fit-head text:first-child { font-size: 30rpx; }.fit-head--green text:first-child { color: var(--color-success); }.fit-head--orange text:first-child { color: #EF7A0B; }.tag-list { margin-top: 22rpx; display: flex; flex-wrap: wrap; gap: 9rpx; }.tag { padding: 9rpx 13rpx; border-radius: 12rpx; font-size: 19rpx; }.tag--green { background: var(--color-success-soft); color: #159467; }.tag--orange { background: var(--color-warning-soft); color: #E86F08; }
.uncertainty-card { margin-top: 22rpx; padding: 27rpx 30rpx; }.uncertainty-head { display: flex; align-items: center; gap: 12rpx; color: var(--color-ink); font-size: 26rpx; font-weight: 650; }.uncertainty-head text:first-child { width: 36rpx; height: 36rpx; display: flex; align-items: center; justify-content: center; border: 3rpx solid var(--color-primary); border-radius: 50%; color: var(--color-primary); font-size: 21rpx; }.uncertainty-factor { display: block; margin-top: 25rpx; color: var(--color-ink); font-size: 23rpx; }.uncertainty-reduce { min-height: 70rpx; margin-top: 22rpx; padding-top: 20rpx; display: grid; grid-template-columns: 35rpx auto 1fr 20rpx; gap: 9rpx; border-top: 1rpx solid var(--color-line); color: var(--color-secondary); font-size: 20rpx; line-height: 1.4; }.uncertainty-reduce text:first-child, .uncertainty-reduce text:nth-child(2) { color: var(--color-primary); }.uncertainty-reduce text:last-child { color: #9298A2; font-size: 31rpx; }
.truth-note { margin-top: 18rpx; padding: 15rpx 24rpx; display: flex; align-items: center; justify-content: center; gap: 10rpx; border-radius: 13rpx; background: var(--color-primary-soft); color: var(--color-secondary); font-size: 18rpx; line-height: 1.45; }.truth-note text:first-child { color: var(--color-primary); font-size: 24rpx; }.choose-button { margin-top: 20rpx; }.choose-button text { margin-left: auto; font-size: 35rpx; }.back-compare { margin-top: 12rpx; }.detail-page { padding-bottom: calc(140rpx + env(safe-area-inset-bottom)); }

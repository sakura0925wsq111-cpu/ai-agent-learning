.comparison-page { padding-top: 0; }.comparison-hero { position: relative; z-index: 2; min-height: 330rpx; box-sizing: border-box; margin: 0 -34rpx; padding: 0 34rpx 26rpx; overflow: visible; background: var(--color-hero); }.comparison-hero app-header { position: relative; z-index: 3; }.comparison-title, .comparison-subtitle { position: relative; z-index: 2; display: block; }.comparison-title { margin: 10rpx 8rpx 0; color: #05070A; font-size: 50rpx; font-weight: 750; letter-spacing: -2rpx; }.comparison-subtitle { margin: 18rpx 8rpx 0; color: var(--color-secondary); font-size: 24rpx; }.door-art { position: absolute; right: 10rpx; top: 18rpx; width: 260rpx; height: 230rpx; opacity: .36; }.door-art view { position: absolute; bottom: 0; width: 90rpx; height: 150rpx; border-radius: 60rpx 60rpx 0 0; background: #87A6EE; }.door-art view:first-child { left: 45rpx; }.door-art view:nth-child(2) { right: 25rpx; background: #B7C7F0; }.door-art view:last-child { left: 35rpx; bottom: -18rpx; width: 210rpx; height: 50rpx; border-radius: 50%; background: #FFFFFF; transform: rotate(11deg); }
.path-tabs { position: absolute; z-index: 4; left: 34rpx; right: 34rpx; bottom: -52rpx; display: flex; gap: 12rpx; }.path-tab { min-width: 0; flex: 1; height: 90rpx; display: flex; align-items: center; justify-content: center; gap: 14rpx; border-radius: 22rpx 22rpx 0 0; background: var(--color-surface); color: var(--color-cyan); font-size: 27rpx; font-weight: 650; box-shadow: var(--shadow-module); }.path-tab text:first-child { font-size: 31rpx; }.path-tab--active { color: var(--color-primary); border-bottom: 6rpx solid var(--color-primary); }.loading-card { margin-top: 78rpx; }
.conclusion { margin-top: 74rpx; padding: 24rpx 28rpx; }.conclusion__head { display: flex; align-items: center; gap: 13rpx; color: var(--color-ink); font-size: 25rpx; font-weight: 650; }.conclusion__head text:first-child { color: var(--color-primary); font-size: 27rpx; }.conclusion__text { display: block; margin-top: 18rpx; color: var(--color-ink); font-size: 24rpx; line-height: 1.55; }
.compare-card { margin-top: 22rpx; padding: 30rpx 28rpx 26rpx; }.compare-head { display: flex; align-items: center; justify-content: space-between; }.compare-head > text { color: var(--color-ink); font-size: 28rpx; font-weight: 700; }.compare-head > view { display: flex; align-items: center; gap: 8rpx; color: var(--color-ink); font-size: 17rpx; }.legend { width: 18rpx; height: 18rpx; margin-left: 8rpx; }.legend--blue { background: var(--color-primary); }.legend--cyan { background: var(--color-cyan); }.compare-row { margin-top: 30rpx; display: grid; grid-template-columns: 112rpx 1fr 1rpx 1fr; align-items: center; gap: 16rpx; }.compare-row > text:first-child { color: var(--color-ink); font-size: 22rpx; }.score-side { display: grid; grid-template-columns: 1fr 28rpx; align-items: center; gap: 10rpx; }.score-track { height: 16rpx; overflow: hidden; border-radius: 999rpx; background: #E7E9ED; }.score-fill { height: 100%; border-radius: 999rpx; }.score-fill--blue { background: var(--color-primary); }.score-fill--cyan { background: var(--color-cyan); }.score-side > text { font-size: 24rpx; font-weight: 650; }.score-blue { color: var(--color-primary); }.score-cyan { color: #0F9FAC; }.compare-divider { height: 32rpx; background: #DEE1E6; }.score-note { display: block; margin-top: 28rpx; color: var(--color-secondary); font-size: 20rpx; text-align: center; }.score-truth { margin-top: 18rpx; padding: 15rpx; border-radius: 11rpx; background: var(--color-primary-soft); color: var(--color-secondary); font-size: 19rpx; text-align: center; }
.projection-grid { margin-top: 22rpx; display: grid; grid-template-columns: 1.25fr .82fr; gap: 18rpx; }.projection-card, .risk-card { position: relative; min-height: 260rpx; box-sizing: border-box; padding: 24rpx; overflow: hidden; }.projection-card__head, .risk-card__head { display: flex; align-items: center; gap: 10rpx; color: var(--color-primary); font-size: 24rpx; font-weight: 650; }.projection-card__head text:first-child { width: 36rpx; height: 36rpx; display: flex; align-items: center; justify-content: center; border-radius: 9rpx; background: var(--color-primary-soft); }.milestone { position: relative; min-height: 52rpx; padding-left: 30rpx; display: grid; grid-template-columns: 75rpx 1fr; align-items: start; color: var(--color-ink); font-size: 19rpx; line-height: 1.45; }.milestone view { position: absolute; left: 5rpx; top: 7rpx; width: 12rpx; height: 12rpx; border-radius: 50%; background: var(--color-primary); box-shadow: 0 20rpx 0 -5rpx var(--color-primary); }.milestone text:nth-child(2) { color: var(--color-primary); font-weight: 650; }.detail-link { display: block; margin-top: 6rpx; color: var(--color-primary); font-size: 18rpx; }.risk-card__head { color: #EC790B; }.risk-card__head text:first-child { width: 36rpx; height: 36rpx; display: flex; align-items: center; justify-content: center; border: 3rpx solid var(--color-warning); border-radius: 50%; }.risk-card__factor, .risk-card__copy { position: relative; z-index: 2; display: block; }.risk-card__factor { margin-top: 30rpx; color: var(--color-ink); font-size: 24rpx; font-weight: 650; }.risk-card__copy { margin-top: 14rpx; color: var(--color-secondary); font-size: 20rpx; line-height: 1.55; }.risk-bubble { position: absolute; right: -40rpx; bottom: -38rpx; width: 150rpx; height: 150rpx; border-radius: 50%; background: var(--color-warning-soft); }
.question-card { position: relative; margin-top: 22rpx; min-height: 78rpx; padding: 0 24rpx; display: grid; grid-template-columns: 40rpx 1fr; align-items: center; gap: 12rpx; overflow: hidden; }.question-icon { width: 34rpx; height: 34rpx; display: flex; align-items: center; justify-content: center; border: 3rpx solid var(--color-primary); border-radius: 50%; color: var(--color-primary); font-size: 21rpx; font-weight: 700; }.question-card > text:nth-child(2) { position: relative; z-index: 2; color: var(--color-ink); font-size: 22rpx; font-weight: 600; }.question-art { position: absolute; right: 20rpx; top: 17rpx; width: 90rpx; height: 46rpx; border-radius: 20rpx; background: #DFE7FA; opacity: .8; }
.choice-bar { margin-top: 18rpx; min-height: 86rpx; padding: 12rpx 14rpx 12rpx 24rpx; display: flex; align-items: center; justify-content: space-between; gap: 18rpx; border: 2rpx solid #D6E2FE; border-radius: 19rpx; background: #F2F6FF; }.choice-bar > view { display: flex; gap: 8rpx; color: var(--color-ink); font-size: 24rpx; }.choice-bar > view text:last-child { color: var(--color-primary); font-weight: 650; }.choice-bar button { min-height: 62rpx; margin: 0; padding: 0 26rpx; border-radius: 14rpx; background: var(--color-primary); color: #FFFFFF; font-size: 23rpx; font-weight: 600; }.choice-bar button text { margin-left: 10rpx; font-size: 31rpx; }.source-line { margin-top: 20rpx; color: #8A909A; font-size: 17rpx; }

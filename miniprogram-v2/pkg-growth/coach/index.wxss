.coach-page { height: 100vh; box-sizing: border-box; padding-bottom: calc(110rpx + env(safe-area-inset-bottom)); display: flex; flex-direction: column; background: var(--color-canvas); }.coach-hero { position: relative; flex: none; min-height: 380rpx; box-sizing: border-box; padding: calc(58rpx + env(safe-area-inset-top)) 56rpx 40rpx; overflow: hidden; border-radius: 0 0 68rpx 68rpx; background: var(--color-hero); }.coach-eyebrow, .coach-title, .coach-subtitle { position: relative; z-index: 2; display: block; }.coach-eyebrow { color: var(--color-secondary); font-size: 22rpx; }.coach-title { margin-top: 28rpx; color: #05070A; font-size: 53rpx; line-height: 1.08; font-weight: 750; letter-spacing: -2rpx; }.coach-subtitle { margin-top: 25rpx; color: var(--color-secondary); font-size: 24rpx; }.context-pill { position: relative; z-index: 2; width: max-content; margin-top: 34rpx; padding: 13rpx 18rpx; display: flex; align-items: center; gap: 10rpx; border: 1rpx solid #C7D6F8; border-radius: 15rpx; color: var(--color-secondary); font-size: 20rpx; }.context-pill text:first-child { width: 28rpx; height: 28rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: var(--color-primary); color: #FFFFFF; font-size: 17rpx; }.coach-art { position: absolute; right: 4rpx; bottom: -10rpx; width: 290rpx; height: 265rpx; opacity: .38; }.coach-art view:first-child { position: absolute; right: 20rpx; bottom: 0; width: 205rpx; height: 150rpx; border-radius: 50% 50% 0 0; background: #B5C7F1; }.coach-art view:nth-child(2) { position: absolute; right: 42rpx; bottom: 18rpx; width: 90rpx; height: 170rpx; border-radius: 50%; background: #9CB7F2; }.coach-art > text { position: absolute; right: 105rpx; top: 14rpx; color: var(--color-primary); font-size: 69rpx; }
.coach-loading { flex: 1; margin: 30rpx 38rpx; }.messages { flex: 1; min-height: 0; }.messages__inner { padding: 28rpx 38rpx 24rpx; display: flex; flex-direction: column; gap: 22rpx; }.suggestion { padding: 25rpx 27rpx 22rpx; }.suggestion__head { display: flex; align-items: center; gap: 10rpx; color: var(--color-ink); font-size: 24rpx; font-weight: 650; }.suggestion__head text:first-child { color: var(--color-cyan); font-size: 31rpx; }.suggestion__head text:last-child { margin-left: auto; color: var(--color-secondary); font-size: 18rpx; font-weight: 400; }.suggestion__task { display: block; margin-top: 25rpx; color: var(--color-ink); font-size: 26rpx; line-height: 1.5; font-weight: 600; }.suggestion__meta { display: block; margin-top: 10rpx; color: var(--color-secondary); font-size: 20rpx; }.suggestion__actions { margin-top: 22rpx; padding-top: 18rpx; display: grid; grid-template-columns: 1.5fr 1fr; gap: 14rpx; border-top: 1rpx solid var(--color-line); }.suggestion__actions button { min-height: 62rpx; margin: 0; border-radius: 13rpx; background: var(--color-primary); color: #FFFFFF; font-size: 21rpx; }.suggestion__actions button:last-child { background: transparent; color: var(--color-primary); }.truth-line { color: var(--color-secondary); font-size: 18rpx; text-align: center; }
.quick { flex: none; padding: 10rpx 28rpx; display: flex; gap: 10rpx; background: var(--color-canvas); }.quick button { flex: 1; min-width: 0; min-height: 58rpx; margin: 0; padding: 0 8rpx; border-radius: 13rpx; background: var(--color-surface); color: var(--color-ink); font-size: 19rpx; box-shadow: var(--shadow-module); white-space: nowrap; }.quick button text { margin-right: 7rpx; color: var(--color-primary); }.quick button:nth-child(2) text { color: var(--color-warning); }.quick button:nth-child(3) text { color: var(--color-cyan); }
.composer { flex: none; margin: 0 24rpx 12rpx; padding: 10rpx 10rpx 10rpx 22rpx; display: flex; align-items: flex-end; gap: 10rpx; border-radius: 26rpx; background: var(--color-surface); box-shadow: var(--shadow-module); }.composer__input { flex: 1; max-height: 130rpx; box-sizing: border-box; padding: 14rpx 0; color: var(--color-ink); font-size: 23rpx; }.composer__send { flex: none; width: 68rpx; height: 68rpx; margin: 0; padding: 0; border-radius: 50%; background: var(--color-primary); color: #FFFFFF; font-size: 30rpx; }.composer__send[disabled] { background: #AFC6F7; }
.context-pill { width: auto; display: inline-flex; }

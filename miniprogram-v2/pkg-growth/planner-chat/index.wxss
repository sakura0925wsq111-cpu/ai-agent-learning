.chat-page { height: 100vh; box-sizing: border-box; padding: 0 30rpx; display: flex; flex-direction: column; }.progress { height: 6rpx; margin: -10rpx 0 12rpx; overflow: hidden; border-radius: 999rpx; background: var(--color-line); }.progress__fill { height: 100%; border-radius: 999rpx; background: var(--color-success); transition: width 240ms ease; }.messages { flex: 1; min-height: 0; }.messages__inner { padding: 24rpx 0 40rpx; display: flex; flex-direction: column; gap: 24rpx; }.thinking { padding-left: 58rpx; color: var(--color-secondary); font-size: 22rpx; }
.composer { margin: 0 -30rpx; padding: 14rpx 22rpx calc(14rpx + env(safe-area-inset-bottom)); display: flex; align-items: flex-end; gap: 12rpx; border-top: 1rpx solid var(--color-line); background: rgba(250,251,253,.90); -webkit-backdrop-filter: blur(28rpx) saturate(170%); backdrop-filter: blur(28rpx) saturate(170%); }.composer__input { flex: 1; max-height: 180rpx; box-sizing: border-box; padding: 20rpx 22rpx; border-radius: 24rpx; background: var(--color-surface-secondary); color: var(--color-ink); font-size: 25rpx; }.composer__send { flex: none; min-height: 76rpx; margin: 0; padding: 0 25rpx; border-radius: 24rpx; background: var(--color-success); color: white; font-size: 24rpx; font-weight: 620; }
.analysis-actions { padding: 24rpx; display: grid; grid-template-columns: 1fr 1fr; gap: 12rpx; border-radius: var(--radius-module); background: var(--color-success-soft); }.analysis-actions > text { grid-column: 1/-1; color: var(--color-ink); font-size: 22rpx; line-height: 1.55; }.analysis-actions button { margin: 0; min-height: 72rpx; padding: 0 12rpx; border-radius: 20rpx; background: var(--color-success); color: white; font-size: 22rpx; }.analysis-actions button:last-child { background: var(--color-surface); color: var(--color-success); }
@media (prefers-color-scheme: dark) { .composer { background: rgba(28,28,30,.90); } }

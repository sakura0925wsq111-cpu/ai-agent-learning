.chat-page { height: 100vh; box-sizing: border-box; padding: 0 30rpx; display: flex; flex-direction: column; }
.phase { height: 6rpx; margin: -10rpx 0 12rpx; overflow: hidden; border-radius: 999rpx; background: var(--color-line); }.phase__fill { height: 100%; width: 18%; border-radius: 999rpx; background: var(--color-primary); transition: width 240ms ease; }.phase__fill--path_probe { width: 42%; }.phase__fill--parallel_sim { width: 68%; }.phase__fill--projection { width: 88%; }.phase__fill--completed { width: 100%; }
.messages { flex: 1; min-height: 0; }.messages__inner { padding: 24rpx 0 40rpx; display: flex; flex-direction: column; gap: 24rpx; }.thinking { padding-left: 58rpx; color: var(--color-secondary); font-size: 22rpx; }
.composer { position: relative; margin: 0 -30rpx; padding: 14rpx 22rpx calc(14rpx + env(safe-area-inset-bottom)); display: flex; align-items: flex-end; gap: 12rpx; border-top: 1rpx solid var(--color-line); background: rgba(250,251,253,.90); -webkit-backdrop-filter: blur(28rpx) saturate(170%); backdrop-filter: blur(28rpx) saturate(170%); }.composer__input { flex: 1; max-height: 180rpx; box-sizing: border-box; padding: 20rpx 22rpx; border-radius: 24rpx; background: var(--color-surface-secondary); color: var(--color-ink); font-size: 25rpx; line-height: 1.5; }.composer__send { flex: none; min-height: 76rpx; margin: 0; padding: 0 25rpx; border-radius: 24rpx; background: var(--color-primary); color: white; font-size: 24rpx; font-weight: 620; }.composer__safe { position: absolute; height: env(safe-area-inset-bottom); }
@media (prefers-color-scheme: dark) { .composer { background: rgba(28,28,30,.90); } }

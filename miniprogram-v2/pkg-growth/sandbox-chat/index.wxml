<view class="chat-page"><app-header title="路径沙盘" eyebrow="{{phaseLabel}}" back bind:back="back"/><view class="phase"><view class="phase__fill phase__fill--{{phase}}"></view></view><view wx:if="{{selectedLabels}}" class="selected-paths"><text>本次对比：{{selectedLabels}}</text><text wx:if="{{pathSelectionLocked}}" class="selected-paths__change" bindtap="changePaths">修改</text></view><view wx:if="{{loading}}" class="chat-loading"><skeleton rows="5"/></view><state-view wx:elif="{{error && !messages.length}}" state="error" title="会话暂不可用" message="{{error}}" bind:action="retry"/><scroll-view wx:else class="messages" scroll-y enhanced scroll-into-view="{{scrollId}}"><view class="messages__inner"><stream-message wx:for="{{messages}}" wx:key="id" id="{{item.id}}" role="{{item.role}}" content="{{item.content}}" streaming="{{item.streaming}}"/><question-card wx:if="{{question}}" question="{{question}}" disabled="{{sending}}" bind:answer="answer"/><view wx:if="{{sending}}" class="thinking">正在梳理你的回答…</view></view></scroll-view><view class="composer"><textarea class="composer__input" value="{{input}}" bindinput="input" auto-height maxlength="3000" placeholder="写下你的想法" disabled="{{loading || sending}}"/><button class="composer__send" disabled="{{loading || sending || !input}}" bindtap="send">发送</button><view class="composer__safe"></view></view></view>

@keyframes shimmer { 0% { opacity: .36; } 50% { opacity: .72; } 100% { opacity: .36; } }
@keyframes rise { from { opacity: 0; transform: translateY(14rpx); } to { opacity: 1; transform: translateY(0); } }
@keyframes scaleIn { from { opacity: 0; transform: scale(.975); } to { opacity: 1; transform: scale(1); } }
.animate-in { animation: rise 260ms cubic-bezier(.2,.8,.2,1) both; }
.animate-scale { animation: scaleIn 220ms cubic-bezier(.2,.8,.2,1) both; }
.skeleton-block { background: var(--color-line-strong); animation: shimmer 1.2s ease-in-out infinite; }

@media (prefers-reduced-motion: reduce) {
  .animate-in, .animate-scale, .skeleton-block { animation: none; }
  .button, .fab { transition: none; }
}

.group { margin-bottom: 32rpx; overflow: hidden; border: 1rpx solid var(--color-line); border-radius: var(--radius-module); background: var(--color-surface); box-shadow: var(--shadow-module); }
.group__title { display: block; padding: 22rpx 26rpx 10rpx; color: var(--color-muted); font-size: 20rpx; font-weight: 600; }
.setting { min-height: 108rpx; padding: 20rpx 26rpx; box-sizing: border-box; display: flex; align-items: center; justify-content: space-between; gap: 20rpx; border-bottom: 1rpx solid var(--color-line); }
.setting:last-child { border-bottom: 0; }.setting__label, .setting__note { display: block; }.setting__label { color: var(--color-ink); font-size: 26rpx; }.setting__note { margin-top: 7rpx; color: var(--color-secondary); font-size: 19rpx; }.setting__input { width: 170rpx; padding: 15rpx; border-radius: 16rpx; background: var(--color-surface-secondary); color: var(--color-ink); text-align: right; font-size: 24rpx; }.setting--column { align-items: stretch; flex-direction: column; }.api { margin-top: 10rpx; font-size: 22rpx; }.small-button { align-self: flex-start; min-height: 68rpx; margin: 0; padding: 0 22rpx; border-radius: 20rpx; background: var(--color-ink); color: var(--color-canvas); font-size: 22rpx; }.setting--link { color: var(--color-secondary); font-size: 25rpx; }.version { padding: 10rpx 20rpx 50rpx; color: var(--color-muted); text-align: center; font-size: 19rpx; line-height: 1.7; }.version text { display: block; }

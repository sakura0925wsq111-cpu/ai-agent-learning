.today-page { padding-top: 0; }
.today-hero { position: relative; margin: 0 -34rpx; min-height: 535rpx; box-sizing: border-box; padding: calc(52rpx + env(safe-area-inset-top)) 44rpx 34rpx; overflow: hidden; border-radius: 0 0 76rpx 76rpx; background: var(--color-hero); }
.today-hero--joined { border-radius: 0; padding-bottom: 0; }
.today-hero__orb { position: absolute; right: -80rpx; top: 72rpx; width: 260rpx; height: 260rpx; border-radius: 50%; background: rgba(186,202,241,.22); box-shadow: -90rpx 160rpx 0 44rpx rgba(194,209,245,.15); }
.today-hero__top { position: relative; z-index: 2; display: flex; align-items: flex-end; justify-content: space-between; gap: 18rpx; }
.today-title, .today-date { display: block; }.today-title { color: #05070A; font-size: 51rpx; line-height: 1; font-weight: 750; }.today-date { margin-top: 20rpx; color: var(--color-secondary); font-size: 22rpx; }
.weather { margin-bottom: 2rpx; display: flex; align-items: center; gap: 8rpx; color: var(--color-ink); font-size: 20rpx; }.weather__symbol { margin-left: 2rpx; color: #F2B500; font-size: 30rpx; }
.greeting { position: relative; z-index: 2; display: block; margin-top: 36rpx; color: #05070A; font-size: 34rpx; line-height: 1.2; font-weight: 700; }
.hero-loading { margin-top: 40rpx; }.hero-error { margin-top: 45rpx; display: flex; align-items: center; justify-content: space-between; color: var(--color-danger); font-size: 22rpx; }.hero-error__retry { color: var(--color-primary); }
.today-metrics { position: relative; z-index: 2; margin-top: 28rpx; display: grid; grid-template-columns: 1.55fr repeat(3, 1fr); align-items: center; }
.completion { width: 100%; height: 196rpx; box-sizing: border-box; overflow: hidden; border-right: 1rpx solid rgba(107,114,128,.14); }.completion__progress { display: block; margin-left: 2rpx; transform: scale(.70); transform-origin: 0 0; }.completion-note-band { margin: 0 -34rpx; padding: 24rpx 64rpx 34rpx; border-radius: 0 0 76rpx 76rpx; background: var(--color-hero); }.completion__note { display: block; color: #818896; font-size: 17rpx; line-height: 1.3; white-space: nowrap; }
.metric { min-width: 0; height: 154rpx; display: flex; align-items: center; flex-direction: column; justify-content: center; border-right: 1rpx solid rgba(107,114,128,.14); color: var(--color-secondary); font-size: 20rpx; }.metric:last-child { border-right: 0; }.metric__icon { width: 40rpx; height: 40rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: rgba(255,255,255,.7); font-size: 22rpx; }.metric__icon--blue { color: var(--color-primary); }.metric__icon--orange { color: #ED7C10; }.metric__icon--red { color: #EF3F47; }.metric__value { margin: 8rpx 0 3rpx; font-size: 44rpx; line-height: 1; font-weight: 600; }.metric__value--blue { color: var(--color-primary); }.metric__value--orange { color: #ED7C10; }.metric__value--red { color: #EF3F47; }
.insight-grid { margin-top: 28rpx; display: grid; grid-template-columns: 1.55fr .98fr; gap: 22rpx; }
.next-card, .ai-card { position: relative; min-height: 235rpx; box-sizing: border-box; padding: 28rpx; overflow: hidden; }.card-kicker { display: flex; align-items: center; gap: 12rpx; color: var(--color-secondary); font-size: 21rpx; }.card-kicker__icon { width: 38rpx; height: 38rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: var(--color-primary-soft); color: var(--color-primary); font-size: 21rpx; }.ai-badge { width: 38rpx; height: 38rpx; display: flex; align-items: center; justify-content: center; border-radius: 9rpx; background: var(--color-primary); color: #FFFFFF; font-size: 17rpx; font-weight: 700; }
.next-card__title, .next-card__meta { position: relative; z-index: 2; display: block; }.next-card__title { max-width: 300rpx; margin-top: 28rpx; color: var(--color-ink); font-size: 34rpx; line-height: 1.2; font-weight: 700; }.next-card__meta { margin-top: 12rpx; color: #7E8796; font-size: 22rpx; }.calendar-art { position: absolute; right: 12rpx; bottom: 10rpx; width: 105rpx; height: 100rpx; color: #7EA4FB; opacity: .5; }.calendar-art__box { position: absolute; left: 0; top: 0; width: 74rpx; height: 70rpx; border: 8rpx solid #BED0FA; border-radius: 16rpx; }.calendar-art__clock { position: absolute; right: 0; bottom: 0; font-size: 52rpx; }
.ai-card__copy { display: block; margin-top: 30rpx; color: var(--color-ink); font-size: 26rpx; line-height: 1.55; }.round-arrow { position: absolute; right: 20rpx; bottom: 18rpx; width: 48rpx; height: 48rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: var(--color-primary-soft); color: var(--color-primary); font-size: 42rpx; font-weight: 300; }
.timeline-card { margin-top: 24rpx; padding: 28rpx 28rpx 2rpx; }.card-title { display: flex; align-items: center; gap: 12rpx; color: var(--color-ink); font-size: 28rpx; font-weight: 650; }.card-title__icon { color: var(--color-primary); font-size: 28rpx; }.timeline-card__content { display: block; margin-top: 28rpx; }
.weekly { margin-top: 24rpx; padding: 28rpx 26rpx 24rpx; }.weekly__head { display: flex; align-items: center; justify-content: space-between; color: var(--color-secondary); font-size: 21rpx; }.weekly__total { color: var(--color-primary); font-weight: 600; }
.weekly__plot { height: 220rpx; margin-top: 20rpx; display: flex; align-items: stretch; justify-content: space-between; gap: 10rpx; }.weekly__column { flex: 1; min-width: 0; display: grid; grid-template-rows: 28rpx 1fr 30rpx; justify-items: center; gap: 6rpx; }.weekly__value { color: var(--color-ink); font-size: 17rpx; }.weekly__track { width: 28rpx; height: 100%; display: flex; align-items: flex-end; }.weekly__bar { width: 100%; min-height: 7rpx; border-radius: 4rpx 4rpx 0 0; background: #C9D8FA; }.weekly__bar--today { background: var(--color-primary); }.weekly__label { color: var(--color-secondary); font-size: 16rpx; white-space: nowrap; }
.data-source { margin: 26rpx 6rpx 0; color: #8A909B; font-size: 18rpx; line-height: 1.5; }

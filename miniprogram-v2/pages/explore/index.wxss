.explore-page { padding-top: 0; }
.explore-hero { position: relative; min-height: 360rpx; box-sizing: border-box; margin: 0 -34rpx; padding: calc(56rpx + env(safe-area-inset-top)) 48rpx 42rpx; overflow: hidden; border-radius: 0 0 68rpx 68rpx; background: var(--color-hero); }
.explore-title, .explore-subtitle { position: relative; z-index: 2; display: block; }.explore-title { color: #05070A; font-size: 51rpx; line-height: 1.1; font-weight: 750; letter-spacing: -2rpx; }.explore-subtitle { margin-top: 20rpx; color: var(--color-secondary); font-size: 24rpx; }
.choose-tip { position: relative; z-index: 2; margin-top: 38rpx; display: flex; align-items: center; gap: 18rpx; }.choose-tip__icon { width: 54rpx; height: 54rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: rgba(255,255,255,.45); color: var(--color-primary); font-size: 28rpx; }.choose-tip text { display: block; }.choose-tip text:first-child { color: var(--color-ink); font-size: 27rpx; font-weight: 650; }.choose-tip text:last-child { margin-top: 7rpx; color: var(--color-secondary); font-size: 21rpx; }
.path-art { position: absolute; right: 16rpx; top: 34rpx; width: 280rpx; height: 285rpx; opacity: .38; }.path-art view:first-child { position: absolute; right: 0; top: 0; width: 240rpx; height: 240rpx; border-radius: 50%; background: #B8CAF4; }.path-art view:nth-child(2) { position: absolute; right: 40rpx; top: 5rpx; width: 72rpx; height: 245rpx; border: 24rpx solid rgba(255,255,255,.9); border-top: 0; border-bottom: 0; border-radius: 50%; transform: rotate(48deg); }.path-art view:last-child { position: absolute; left: 30rpx; bottom: 20rpx; width: 50rpx; height: 16rpx; border-radius: 4rpx; background: #7D9FEA; box-shadow: 48rpx -28rpx 0 #7D9FEA; }
.loading-card { margin-top: 30rpx; }.selected-summary { position: relative; z-index: 3; min-height: 88rpx; margin: -28rpx 2rpx 28rpx; padding: 0 28rpx; display: flex; align-items: center; gap: 12rpx; font-size: 25rpx; }.selected-summary__check { flex: none; width: 38rpx; height: 38rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: var(--color-primary); color: #FFFFFF; font-size: 21rpx; }.selected-summary__names { flex: 1; min-width: 0; overflow: hidden; color: var(--color-primary); white-space: nowrap; text-overflow: ellipsis; }.selected-summary__arrow { color: #8A9099; font-size: 44rpx; }
.compare-button { margin-top: 24rpx; min-height: 78rpx; font-size: 28rpx; }.compare-button text { margin-left: auto; font-size: 40rpx; font-weight: 300; }
.process-card { margin-top: 22rpx; padding: 30rpx 20rpx; display: grid; grid-template-columns: 1fr 36rpx 1fr 36rpx 1fr; align-items: center; }.process-step { min-width: 0; display: flex; align-items: center; flex-direction: column; text-align: center; }.process-step__num { width: 36rpx; height: 36rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: var(--color-primary-soft); color: var(--color-primary); font-size: 18rpx; }.process-step__icon { margin: 14rpx 0 10rpx; color: var(--color-primary); font-size: 32rpx; font-weight: 700; }.process-step > text:last-child { color: var(--color-ink); font-size: 20rpx; line-height: 1.4; white-space: pre-line; }.process-arrow { color: #CFD3DA; font-size: 30rpx; text-align: center; }
.explore-note { margin: 24rpx 0 0; display: flex; align-items: center; justify-content: center; gap: 9rpx; color: #7E8490; font-size: 18rpx; }.explore-note text:first-child { color: var(--color-primary); font-size: 25rpx; }
.process-step__copy { color: var(--color-ink); font-size: 20rpx; line-height: 1.4; }.process-step__copy text { display: block; }

.passport-page { padding-top: 0; }.passport-hero { position: relative; min-height: 392rpx; box-sizing: border-box; margin: 0 -34rpx; padding: calc(56rpx + env(safe-area-inset-top)) 48rpx 36rpx; overflow: hidden; border-radius: 0 0 66rpx 66rpx; background: var(--color-hero); }.passport-eyebrow { position: relative; z-index: 2; color: var(--color-secondary); font-size: 23rpx; }.passport-name { position: relative; z-index: 2; margin-top: 28rpx; display: flex; align-items: center; gap: 18rpx; }.passport-name text:first-child { color: #05070A; font-size: 48rpx; line-height: 1; font-weight: 750; }.passport-name text:last-child { color: var(--color-secondary); font-size: 27rpx; }.passport-major { position: relative; z-index: 2; display: block; margin-top: 25rpx; color: var(--color-secondary); font-size: 24rpx; }
.passport-stats { position: relative; z-index: 2; margin-top: 48rpx; display: grid; grid-template-columns: repeat(4,1fr); }.passport-stats > view { display: flex; align-items: center; flex-direction: column; gap: 14rpx; border-right: 1rpx solid rgba(107,114,128,.22); color: var(--color-secondary); font-size: 20rpx; }.passport-stats > view:last-child { border-right: 0; }.passport-stats > view > text:last-child { color: var(--color-ink); font-size: 34rpx; line-height: 1; font-weight: 600; }.passport-stats > view > text:last-child text { font-size: 22rpx; }.blue { color: var(--color-primary) !important; }
.profile-art { position: absolute; right: 14rpx; top: 42rpx; width: 270rpx; height: 260rpx; opacity: .4; }.profile-art view:first-child { position: absolute; right: 22rpx; top: 54rpx; width: 180rpx; height: 155rpx; border-radius: 80% 80% 0 0; background: #B6C9F2; }.profile-art view:nth-child(2) { position: absolute; right: 70rpx; top: 28rpx; width: 70rpx; height: 190rpx; border: 19rpx solid #FFFFFF; border-top: 0; border-bottom: 0; border-radius: 50%; transform: rotate(26deg); }.profile-art text { position: absolute; right: 64rpx; top: 6rpx; color: var(--color-primary); font-size: 60rpx; }.loading-card { margin-top: 28rpx; }
.current-path { position: relative; z-index: 3; margin-top: -20rpx; padding: 28rpx 30rpx; }.current-path__head, .current-path__title { display: flex; align-items: center; }.current-path__head { justify-content: space-between; color: var(--color-ink); font-size: 26rpx; font-weight: 650; }.current-path__head text:last-child { color: #9A9FA7; font-size: 39rpx; }.current-path__title { margin-top: 28rpx; gap: 12rpx; }.current-path__title > text:first-child { color: var(--color-ink); font-size: 32rpx; font-weight: 700; }.current-path__title > text:last-child { margin-left: auto; color: var(--color-secondary); font-size: 20rpx; }.status-pill { padding: 6rpx 11rpx; border-radius: 8rpx; background: var(--color-primary-soft); color: var(--color-primary); font-size: 18rpx; }.path-progress { height: 12rpx; margin-top: 22rpx; overflow: hidden; border-radius: 999rpx; background: #ECEEF1; }.path-progress view { height: 100%; border-radius: 999rpx; background: var(--color-primary); }.next-label { display: block; margin-top: 30rpx; color: var(--color-primary); font-size: 20rpx; }.next-row { margin-top: 13rpx; display: flex; align-items: center; gap: 14rpx; color: var(--color-ink); font-size: 24rpx; }.next-arrow { width: 30rpx; height: 30rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: #6F9AF8; color: #FFFFFF; font-size: 18rpx; }.current-path__empty { display: block; margin-top: 22rpx; color: var(--color-secondary); font-size: 24rpx; }
.memory-basis { margin-top: 22rpx; padding: 30rpx; }.card-heading { color: var(--color-ink); font-size: 27rpx; font-weight: 650; }.memory-bar { height: 16rpx; margin-top: 30rpx; display: flex; overflow: hidden; border-radius: 999rpx; gap: 2rpx; }.memory-bar view { min-width: 8rpx; }.memory-bar__profile { background: var(--color-primary); }.memory-bar__goal { background: #7FA3F6; }.memory-bar__action { background: #A7BEF6; }.memory-bar__fact { background: #C9D7F5; }.memory-types { margin-top: 26rpx; display: grid; grid-template-columns: repeat(4,1fr); }.memory-types > view { display: flex; align-items: center; flex-direction: column; gap: 8rpx; border-right: 1rpx solid var(--color-line); color: var(--color-secondary); font-size: 18rpx; }.memory-types > view:last-child { border-right: 0; }.memory-types > view text:last-child { color: var(--color-primary); font-size: 27rpx; font-weight: 600; }.memory-source { margin-top: 24rpx; padding-top: 18rpx; border-top: 1rpx solid var(--color-line); color: #8A909A; font-size: 18rpx; }
.recent-reports { margin-top: 22rpx; padding: 28rpx 30rpx 8rpx; }.card-heading-row { display: flex; align-items: center; justify-content: space-between; }.card-heading-row > text:last-child { color: #9398A1; font-size: 38rpx; }.report-row { min-height: 76rpx; display: grid; grid-template-columns: 48rpx 1fr auto 24rpx; align-items: center; gap: 12rpx; border-bottom: 1rpx solid var(--color-line); color: #9298A2; font-size: 31rpx; }.report-row:last-child { border-bottom: 0; }.report-row > text:nth-child(2) { color: var(--color-ink); font-size: 23rpx; }.report-row > text:nth-child(3) { color: var(--color-secondary); font-size: 19rpx; }.report-icon { width: 40rpx; height: 40rpx; display: flex; align-items: center; justify-content: center; border-radius: 10rpx; background: var(--color-primary-soft); color: var(--color-primary); font-size: 22rpx; }
.profile-grid { margin-top: 22rpx; display: grid; grid-template-columns: 1fr 1fr; gap: 18rpx; }.profile-entry { min-height: 116rpx; box-sizing: border-box; padding: 22rpx 18rpx; display: grid; grid-template-columns: 52rpx 1fr 18rpx; align-items: center; gap: 12rpx; color: #9AA0AA; font-size: 31rpx; }.entry-icon { color: var(--color-primary); font-size: 36rpx; }.profile-entry view { min-width: 0; }.profile-entry view text { display: block; }.profile-entry view text:first-child { color: var(--color-ink); font-size: 24rpx; font-weight: 600; }.profile-entry view text:last-child { margin-top: 7rpx; overflow: hidden; color: var(--color-secondary); font-size: 16rpx; white-space: nowrap; text-overflow: ellipsis; }

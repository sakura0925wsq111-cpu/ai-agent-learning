.login-page { min-height: 100vh; box-sizing: border-box; padding-bottom: calc(42rpx + env(safe-area-inset-bottom)); background: var(--color-canvas); }
.login-hero { position: relative; height: 470rpx; box-sizing: border-box; padding: calc(82rpx + env(safe-area-inset-top)) 54rpx 44rpx; overflow: hidden; border-radius: 0 0 94rpx 94rpx; background: var(--color-hero); }
.login-brand { color: var(--color-primary); font-size: 45rpx; font-weight: 700; font-style: italic; letter-spacing: -2rpx; }
.login-title { position: relative; z-index: 2; display: block; margin-top: 96rpx; color: #05070A; font-size: 55rpx; line-height: 1.15; font-weight: 750; letter-spacing: -2rpx; }
.login-subtitle { position: relative; z-index: 2; display: block; margin-top: 28rpx; color: var(--color-secondary); font-size: 23rpx; }
.login-road { position: absolute; right: 24rpx; top: 105rpx; width: 250rpx; height: 300rpx; opacity: .6; }.login-road > view:first-child { position: absolute; right: 0; bottom: 0; width: 205rpx; height: 240rpx; border-radius: 50% 45% 0 0; background: #CBD8F5; }.login-road > view:nth-child(2) { position: absolute; right: 80rpx; top: 56rpx; width: 48rpx; height: 190rpx; border: 20rpx solid #F6F8FE; border-top: 0; border-bottom: 0; border-radius: 50%; transform: rotate(-24deg); }.login-road > view:last-child { position: absolute; right: 50rpx; top: 30rpx; width: 6rpx; height: 80rpx; background: #8EAEF3; box-shadow: 24rpx 0 0 0 #8EAEF3; }
.login-card { margin: 38rpx 38rpx 0; padding: 52rpx 48rpx 50rpx; border-radius: 32rpx; }
.field-label { display: block; margin: 0 0 15rpx; color: var(--color-ink); font-size: 25rpx; font-weight: 650; }
.password-label { margin-top: 34rpx; display: flex; align-items: flex-start; justify-content: space-between; }.password-label > text:last-child { color: var(--color-primary); font-size: 21rpx; }
.login-field { min-height: 88rpx; box-sizing: border-box; padding: 0 24rpx; display: flex; align-items: center; gap: 18rpx; border: 1rpx solid var(--color-line-strong); border-radius: 17rpx; background: var(--color-surface); }.login-field:focus-within { border-color: var(--color-primary); }.login-field input { flex: 1; color: var(--color-ink); font-size: 27rpx; }.login-field__icon { flex: none; width: 28rpx; color: #A9ADB4; font-size: 27rpx; }.password-eye { color: #B1B5BB; font-size: 28rpx; }
.login-submit { margin-top: 50rpx; min-height: 90rpx; font-size: 28rpx; }
.divider-or { margin: 36rpx 0; display: flex; align-items: center; gap: 24rpx; color: #A1A5AC; font-size: 21rpx; }.divider-or view { flex: 1; height: 1rpx; background: var(--color-line); }
.demo-button { min-height: 84rpx; font-size: 27rpx; }
.create-row { margin-top: 40rpx; display: flex; justify-content: center; gap: 8rpx; color: var(--color-secondary); font-size: 23rpx; }.create-row text:last-child { color: var(--color-primary); font-weight: 600; }
.legal-row { margin-top: 78rpx; padding: 0 28rpx; display: flex; align-items: center; justify-content: center; gap: 5rpx; color: #7D838C; font-size: 18rpx; white-space: nowrap; }.legal-check { flex: none; width: 26rpx; height: 26rpx; margin-right: 6rpx; display: flex; align-items: center; justify-content: center; border: 2rpx solid #B4B8BF; border-radius: 6rpx; color: #FFFFFF; font-size: 17rpx; }.legal-check--checked { border-color: var(--color-primary); background: var(--color-primary); }.legal-link { color: var(--color-primary); }

<view class="page--plain"><app-header title="创建账户" eyebrow="首次使用" back bind:back="back"/><view class="card form"><text class="label">学号 *</text><input class="field" data-key="student_id" value="{{form.student_id}}" bindinput="input"/><text class="label">姓名 *</text><input class="field" data-key="name" value="{{form.name}}" bindinput="input"/><text class="label">密码 *</text><input class="field" password data-key="password" value="{{form.password}}" bindinput="input" placeholder="至少 6 位"/><text class="label">学校</text><input class="field" data-key="school" value="{{form.school}}" bindinput="input"/><text class="label">学院</text><input class="field" data-key="college" value="{{form.college}}" bindinput="input"/><text class="label">专业</text><input class="field" data-key="major" value="{{form.major}}" bindinput="input"/><view class="form__grid"><view><text class="label">年级</text><input class="field" data-key="grade" value="{{form.grade}}" bindinput="input"/></view><view><text class="label">入学年份</text><input class="field" type="number" data-key="enroll_year" value="{{form.enroll_year}}" bindinput="input"/></view></view></view><button class="button button--primary submit" loading="{{submitting}}" disabled="{{submitting}}" bindtap="submit">注册并继续</button></view>

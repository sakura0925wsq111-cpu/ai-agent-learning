.action-page { padding-top: 0; }.action-hero { position: relative; min-height: 365rpx; box-sizing: border-box; margin: 0 -34rpx; padding: calc(58rpx + env(safe-area-inset-top)) 42rpx 34rpx; overflow: hidden; border-radius: 0 0 66rpx 66rpx; background: var(--color-hero); }.action-title, .action-route { position: relative; z-index: 2; display: block; }.action-title { color: #05070A; font-size: 47rpx; line-height: 1.1; font-weight: 750; }.action-route { margin-top: 20rpx; color: var(--color-secondary); font-size: 23rpx; }
.action-overview { position: relative; z-index: 2; margin-top: 32rpx; display: flex; align-items: center; gap: 50rpx; }.action-overview > view:not(.action-overview__divider) { display: flex; flex-direction: column; gap: 5rpx; color: var(--color-ink); font-size: 23rpx; }.action-percent, .action-count { color: var(--color-primary); font-size: 64rpx; line-height: 1; font-weight: 650; }.action-percent text { font-size: 41rpx; }.action-count { color: #05070A; }.action-count text { font-size: 35rpx; }.action-overview__divider { width: 1rpx; height: 82rpx; background: rgba(107,114,128,.22); }.action-basis { position: relative; z-index: 2; display: block; margin-top: 22rpx; color: #848B97; font-size: 19rpx; }
.action-art { position: absolute; right: 18rpx; top: 42rpx; width: 240rpx; height: 250rpx; opacity: .52; }.action-art view:first-child { position: absolute; right: 66rpx; top: 14rpx; width: 105rpx; height: 128rpx; border-radius: 18rpx; background: #FFFFFF; box-shadow: 0 10rpx 30rpx rgba(44,73,135,.08); }.action-art view:nth-child(2) { position: absolute; right: 10rpx; bottom: 10rpx; width: 136rpx; height: 136rpx; border-radius: 50%; background: #91AFF4; }.action-art text { position: absolute; right: 45rpx; bottom: 43rpx; color: #FFFFFF; font-size: 68rpx; font-weight: 700; }.loading-card { margin-top: 26rpx; }
.roadmap-panel { position: relative; z-index: 3; margin-top: -24rpx; padding: 26rpx 20rpx 18rpx; overflow: hidden; }.action-bento { margin-top: 22rpx; display: grid; grid-template-columns: 1.25fr .9fr; gap: 20rpx; }.phase-card, .next-action { position: relative; min-height: 220rpx; box-sizing: border-box; padding: 26rpx; overflow: hidden; border-radius: var(--radius-module); }.phase-card { background: #EDF3FF; box-shadow: var(--shadow-module); }.phase-card__badge, .phase-card__period, .phase-card__title, .phase-card__sync { position: relative; z-index: 2; display: block; }.phase-card__badge { width: max-content; padding: 7rpx 12rpx; border-radius: 8rpx; background: var(--color-primary); color: #FFFFFF; font-size: 18rpx; }.phase-card__period { margin-top: 26rpx; color: var(--color-ink); font-size: 29rpx; font-weight: 650; }.phase-card__title { margin-top: 8rpx; color: var(--color-primary); font-size: 23rpx; }.phase-card__sync { margin-top: 23rpx; color: var(--color-primary); font-size: 20rpx; }.target-art { position: absolute; right: 20rpx; bottom: 26rpx; color: var(--color-primary); font-size: 88rpx; opacity: .16; }
.next-action__badge { display: inline-flex; padding: 6rpx 11rpx; border-radius: 8rpx; background: var(--color-warning-soft); color: #E66C0A; font-size: 18rpx; }.next-action__title, .next-action__date { position: relative; z-index: 2; display: block; }.next-action__title { margin-top: 26rpx; color: var(--color-ink); font-size: 27rpx; line-height: 1.45; font-weight: 650; }.next-action__date { margin-top: 20rpx; color: #EA6B0A; font-size: 20rpx; }.next-action__calendar { position: absolute; right: 14rpx; bottom: 2rpx; color: #F8CFAE; font-size: 85rpx; opacity: .72; }
.task-card { margin-top: 22rpx; padding: 8rpx 28rpx; }.task-card__head { min-height: 74rpx; display: flex; align-items: center; justify-content: space-between; border-bottom: 1rpx solid var(--color-line); color: var(--color-ink); font-size: 25rpx; font-weight: 650; }.task-card__head > text:last-child { color: var(--color-secondary); font-size: 21rpx; font-weight: 400; }
.deadline-card { margin-top: 22rpx; padding: 26rpx 24rpx 22rpx; }.deadline-card__title { display: block; color: var(--color-secondary); font-size: 23rpx; }.deadline-bars { height: 135rpx; margin-top: 14rpx; display: flex; justify-content: space-between; gap: 10rpx; }.deadline-day { flex: 1; display: grid; grid-template-rows: 24rpx 1fr 24rpx 22rpx; justify-items: center; color: var(--color-secondary); font-size: 16rpx; }.deadline-day > text:first-child { color: var(--color-ink); }.deadline-track { width: 36rpx; height: 100%; display: flex; align-items: flex-end; }.deadline-fill { width: 100%; min-height: 5rpx; border-radius: 5rpx; background: var(--color-primary); }
.action-links { margin-top: 22rpx; overflow: hidden; }.action-links > view { min-height: 72rpx; padding: 0 28rpx; display: grid; grid-template-columns: 40rpx 1fr auto; align-items: center; gap: 12rpx; border-bottom: 1rpx solid var(--color-line); color: var(--color-secondary); font-size: 37rpx; }.action-links > view:last-child { border-bottom: 0; }.action-links > view > text:nth-child(2) { color: var(--color-ink); font-size: 24rpx; }.link-icon { color: var(--color-primary); font-size: 27rpx; }.data-source { margin: 22rpx 8rpx 0; color: #8A909B; font-size: 18rpx; }
.phase-card__badge { width: auto; display: inline-flex; }
.phase-card__sync--pending { color: var(--color-secondary); }.sync-phase-button { min-height: 66rpx; margin: 22rpx 0 16rpx; border: 1rpx solid #BDD0FA; border-radius: 13rpx; background: var(--color-primary-soft); color: var(--color-primary); font-size: 22rpx; }.task-card .empty-copy { margin: 18rpx 0; }

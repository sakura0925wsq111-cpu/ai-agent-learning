<view class="page action-page">
  <view class="action-hero" style="padding-top: {{heroTop}}px">
    <view class="action-art" aria-hidden="true"><view></view><view></view><text>✓</text></view>
    <text class="action-title">行动计划</text>
    <text class="action-route">{{dashboard && dashboard.activePlan ? dashboard.activePlan.title : '把方向变成可执行的路线'}}</text>
    <view wx:if="{{dashboard && dashboard.activePlan}}" class="action-overview">
      <view><text class="action-percent">{{progress.percent}}<text>%</text></text><text>计划完成度</text></view>
      <view class="action-overview__divider"></view>
      <view><text class="action-count">{{progress.completed}}<text>/{{progress.total}}</text></text><text>已完成</text></view>
    </view>
    <text wx:if="{{dashboard && dashboard.activePlan}}" class="action-basis">按已完成任务 / 已同步任务计算</text>
  </view>

  <view wx:if="{{loading}}" class="card loading-card"><skeleton rows="6"/></view>
  <state-view wx:elif="{{error}}" state="error" title="执行状态暂不可用" message="{{error}}" bind:action="retry"/>
  <state-view wx:elif="{{!dashboard || !dashboard.activePlan}}" state="empty" title="还没有执行中的计划" message="完成一次路径探索与专项规划，再把阶段任务加入行动。" action-label="去探索方向" bind:action="explore"/>
  <block wx:else>
    <view class="roadmap-panel surface"><phase-roadmap phases="{{report.phases}}" current-key="{{progress.currentKey}}" synced-keys="{{syncedKeys}}" bind:select="selectPhase"/></view>

    <view class="action-bento">
      <view class="phase-card">
        <text class="phase-card__badge">当前阶段</text>
        <text class="phase-card__period">{{selectedPhase.label}}</text>
        <text class="phase-card__title">{{selectedPhase.title || dashboard.activePlan.phase_label}}</text>
        <text class="phase-card__sync">✓ 已同步</text>
        <view class="target-art">◎</view>
      </view>
      <view class="next-action surface"><text class="next-action__badge">下一步行动</text><text class="next-action__title">{{nextTask ? nextTask.title : '本阶段任务已完成'}}</text><text class="next-action__date">{{nextTask ? (nextTask.deadlineLabel || '待安排日期') : '继续复盘与调整'}}</text><view class="next-action__calendar">□</view></view>
    </view>

    <view class="task-card surface">
      <view class="task-card__head"><text>任务清单 <text class="muted">（已同步）</text></text><text>{{selectedPhase.completed || 0}}/{{selectedPhase.total || selectedPhase.tasks.length}} 已完成</text></view>
      <task-row wx:for="{{selectedPhase.tasks}}" wx:key="id" task="{{item}}" bind:toggle="toggleTask" bind:remove="askRemove"/>
      <view wx:if="{{!selectedPhase.tasks.length}}" class="empty-copy">这个阶段尚未同步任务，可以从路线报告加入。</view>
    </view>

    <view class="deadline-card surface">
      <text class="deadline-card__title">截止日期分布</text>
      <view class="deadline-bars"><view wx:for="{{weekBars}}" wx:key="key" class="deadline-day"><text>{{item.total}}</text><view class="deadline-track"><view class="deadline-fill" style="height: {{item.totalHeight}}%"></view></view><text>周{{item.label}}</text><text>{{item.dateLabel}}</text></view></view>
    </view>

    <view class="action-links surface"><view bindtap="report"><text class="link-icon">▤</text><text>查看完整报告</text><text>›</text></view><view bindtap="coach"><text class="link-icon">◌</text><text>问 AI 教练</text><text>›</text></view></view>
    <view class="data-source">来源：成长报告、已同步待办 · 更新于 {{refreshedLabel || '刚刚'}}</view>
  </block>
</view>
<confirm-sheet visible="{{confirmTask !== null}}" title="取消执行这项计划任务？" message="任务会保留在执行证据中，并标记为已取消，不会永久删除。" confirm-label="确认取消执行" destructive submitting="{{submitting}}" bind:close="closeConfirm" bind:confirm="confirmRemove"/>

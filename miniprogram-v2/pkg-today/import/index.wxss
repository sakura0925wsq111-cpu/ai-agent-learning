.import-page { padding-top: 0; padding-bottom: calc(145rpx + env(safe-area-inset-bottom)); }.import-hero { position: relative; min-height: 360rpx; box-sizing: border-box; margin: 0 -34rpx; padding: calc(58rpx + env(safe-area-inset-top)) 42rpx 38rpx; overflow: hidden; border-radius: 0 0 58rpx 58rpx; background: var(--color-hero); }.import-eyebrow, .import-title, .import-subtitle { position: relative; z-index: 2; display: block; }.import-eyebrow { color: #5F6D8B; font-size: 21rpx; }.import-title { margin-top: 24rpx; color: #05070A; font-size: 49rpx; font-weight: 750; letter-spacing: -2rpx; }.import-subtitle { margin-top: 19rpx; color: var(--color-secondary); font-size: 22rpx; }.hero-tabs { position: relative; z-index: 2; margin-top: 30rpx; display: flex; gap: 18rpx; }.hero-tabs > view { min-height: 58rpx; padding: 0 22rpx; display: flex; align-items: center; gap: 9rpx; border-radius: 999rpx; background: rgba(255,255,255,.75); color: var(--color-secondary); font-size: 20rpx; }.hero-tabs .active { color: var(--color-primary); background: #FFFFFF; }.hero-tabs text:first-child { font-size: 25rpx; }.import-art { position: absolute; right: 10rpx; top: 52rpx; width: 270rpx; height: 255rpx; opacity: .4; }.import-art view:first-child { position: absolute; right: 46rpx; top: 18rpx; width: 125rpx; height: 150rpx; border-radius: 20rpx; background: #B3C7F3; }.import-art view:nth-child(2) { position: absolute; right: 10rpx; bottom: 14rpx; width: 150rpx; height: 100rpx; border: 8rpx solid #90ADF1; border-radius: 22rpx; }.import-art text { position: absolute; right: 0; bottom: 0; color: var(--color-primary); font-size: 74rpx; }
.type-cards { margin-top: 28rpx; display: grid; grid-template-columns: 1fr 1fr; gap: 18rpx; }.type-card { position: relative; min-height: 130rpx; box-sizing: border-box; padding: 26rpx; display: flex; align-items: center; gap: 18rpx; border: 2rpx solid #E0E2E6; border-radius: 20rpx; background: var(--color-surface); }.type-card--active { border-color: var(--color-primary); background: #F6F9FF; }.type-card__check { position: absolute; right: 18rpx; top: 16rpx; width: 32rpx; height: 32rpx; display: flex; align-items: center; justify-content: center; border: 2rpx solid #BBC1CA; border-radius: 50%; color: #FFFFFF; font-size: 18rpx; }.type-card--active .type-card__check { border-color: var(--color-primary); background: var(--color-primary); }.type-card__icon { color: var(--color-primary); font-size: 44rpx; }.type-card:not(.type-card--active) .type-card__icon { color: #7F858F; }.type-card view text { display: block; }.type-card view text:first-child { color: var(--color-ink); font-size: 26rpx; font-weight: 650; }.type-card view text:last-child { margin-top: 9rpx; color: var(--color-secondary); font-size: 19rpx; }
.upload-card { margin-top: 22rpx; padding: 30rpx 28rpx 24rpx; }.upload-title { color: var(--color-ink); font-size: 28rpx; font-weight: 650; }.drop { min-height: 185rpx; margin-top: 28rpx; display: flex; align-items: center; flex-direction: column; justify-content: center; gap: 18rpx; border: 2rpx dashed #C9CDD3; border-radius: 17rpx; color: var(--color-secondary); font-size: 21rpx; }.drop__icon { width: 62rpx; height: 70rpx; display: flex; align-items: center; justify-content: center; border-radius: 8rpx; background: #DDE7FF; color: #6D96F1; font-size: 18rpx; font-weight: 700; }.file-row { min-height: 68rpx; margin-top: 22rpx; padding: 0 16rpx; display: grid; grid-template-columns: 46rpx 1fr 30rpx; align-items: center; gap: 14rpx; border: 1rpx solid var(--color-line); border-radius: 13rpx; }.file-icon { color: var(--color-primary); font-size: 17rpx; font-weight: 700; }.file-row view text { display: block; }.file-row view text:first-child { color: var(--color-ink); font-size: 20rpx; }.file-row view text:last-child { margin-top: 3rpx; color: var(--color-secondary); font-size: 16rpx; }.file-row > text:last-child { color: #A0A5AD; font-size: 29rpx; }.file-note { margin-top: 20rpx; color: var(--color-secondary); font-size: 18rpx; }.upload-status { margin-top: 18rpx; color: var(--color-secondary); font-size: 19rpx; }.upload-status > view { display: flex; justify-content: space-between; }.upload-progress { height: 8rpx; margin-top: 12rpx; overflow: hidden; border-radius: 999rpx; background: var(--color-line); }.upload-progress view { height: 100%; background: var(--color-primary); }
.steps { margin-top: 22rpx; padding: 26rpx 42rpx; display: flex; align-items: flex-start; }.step { flex: none; display: flex; align-items: center; flex-direction: column; gap: 12rpx; color: var(--color-secondary); font-size: 20rpx; }.step > text:first-child { width: 40rpx; height: 40rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: #D9DCE1; color: #FFFFFF; font-size: 20rpx; }.step--active { color: var(--color-primary); }.step--active > text:first-child { background: var(--color-primary); }.step-line { flex: 1; height: 2rpx; margin: 19rpx 12rpx 0; border-top: 2rpx dashed #D5D8DE; }.import-note { margin-top: 22rpx; padding: 18rpx 24rpx; display: flex; align-items: flex-start; gap: 12rpx; border: 2rpx solid #C9D9FC; border-radius: 14rpx; background: var(--color-primary-soft); color: var(--color-secondary); font-size: 19rpx; line-height: 1.5; }.import-note text:first-child { color: var(--color-primary); font-size: 27rpx; }.submit { margin-top: 22rpx; }.privacy { margin-top: 19rpx; color: #8B919B; font-size: 18rpx; text-align: center; }

.preview-head { margin-bottom: 22rpx; display: flex; align-items: flex-end; justify-content: space-between; }.preview-head .title, .preview-head .caption { display: block; }.preview-head .caption { margin-top: 8rpx; }.list { display: flex; flex-direction: column; gap: 12rpx; }.item { display: grid; grid-template-columns: 44rpx 1fr; gap: 16rpx; }.check { width: 38rpx; height: 38rpx; display: flex; align-items: center; justify-content: center; border: 2rpx solid var(--color-line-strong); border-radius: 11rpx; color: white; font-size: 21rpx; }.item--checked { border-color: var(--color-primary); }.item--checked .check { border-color: var(--color-primary); background: var(--color-primary); }.item__title, .item__meta, .item__extra { display: block; }.item__title { color: var(--color-ink); font-size: 27rpx; font-weight: 650; }.item__meta { margin-top: 9rpx; color: var(--color-secondary); font-size: 21rpx; line-height: 1.5; }.item__extra { margin-top: 6rpx; color: var(--color-muted); font-size: 20rpx; }.confirm { position: sticky; bottom: 20rpx; margin-top: 28rpx; }

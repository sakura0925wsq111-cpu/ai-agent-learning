<view class="page--plain"><app-header title="确认导入" eyebrow="{{type === 'course' ? '课程预览' : '考试预览'}}" back bind:back="back"/><view wx:if="{{loading}}" class="card"><skeleton rows="6"/></view><state-view wx:elif="{{error}}" state="error" title="预览暂不可用" message="{{error}}" bind:action="retry"/><block wx:else><view class="preview-head"><view><text class="title">识别到 {{items.length}} 项</text><text class="caption">已选择 {{selectedCount}} 项，确认后才会写入</text></view><text class="link" bindtap="all">{{selectedCount === items.length ? '取消全选' : '全选'}}</text></view><view class="list"><view wx:for="{{items}}" wx:key="index" class="item card {{item.checked ? 'item--checked' : ''}}" data-index="{{item.index}}" bindtap="toggle"><view class="check">{{item.checked ? '✓' : ''}}</view><view><text class="item__title">{{item.title}}</text><text class="item__meta">{{item.meta}}</text><text wx:if="{{type === 'course' && item.teacher}}" class="item__extra">教师 · {{item.teacher}}</text></view></view></view><button class="button button--primary confirm" loading="{{confirming}}" disabled="{{confirming || !selectedCount}}" bindtap="confirm">确认导入 {{selectedCount}} 项</button></block></view>

.tabbar {
  position: fixed;
  z-index: 100;
  left: 0;
  right: 0;
  bottom: 0;
  height: calc(110rpx + env(safe-area-inset-bottom));
  padding: 8rpx 28rpx env(safe-area-inset-bottom);
  box-sizing: border-box;
  display: flex;
  align-items: stretch;
  background: rgba(255, 255, 255, .96);
  border-top: 1rpx solid #E7E8EA;
  box-shadow: 0 -8rpx 24rpx rgba(30, 45, 70, .04);
}
.tab { position: relative; flex: 1; min-width: 88rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 2rpx; color: #6B7280; font-size: 20rpx; font-weight: 500; }
.tab__icon { width: 44rpx; height: 44rpx; }
.tab--active { color: #2868F5; font-weight: 600; }

@media (max-width: 360px) {
  .tabbar { padding-left: 18rpx; padding-right: 18rpx; }
  .tab__icon { width: 40rpx; height: 40rpx; }
}

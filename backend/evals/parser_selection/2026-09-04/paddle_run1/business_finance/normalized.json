            0.8036477628954118
          ],
          "character_span": null
        }
      ],
      "disposition": "uncertain",
      "completeness": "unknown"
    },
    {
      "id": "p18:b27",
      "type": "paragraph",
      "provider_label": "text",
      "text": "（四）筹资战略决策应遵循的原则",
      "reading_order": 28,
      "provider_sequence": 27,
      "parent_id": null,
      "children": [],
      "source_spans": [
        {
          "page_number": 18,
          "bbox": [
            0.22692462716646514,
            0.8093473924194927,
            0.4893188230552197,
            0.8224565403248789
          ],
          "character_span": null
        }
      ],
      "disposition": "uncertain",
      "completeness": "unknown"
    },
    {
      "id": "p18:b28",
      "type": "paragraph",
      "provider_label": "text",
      "text": "（1）尽可能挖掘企业潜力，实行内源型融资渠道战略",
      "reading_order": 29,
      "provider_sequence": 28,
      "parent_id": null,
      "children": [],
      "source_spans": [
        {
          "page_number": 18,
          "bbox": [
            0.22652156388553002,
            0.8284411513251638,
            0.6388553002821443,
            0.841265317754346
          ],
          "character_span": null
        }
      ],
      "disposition": "uncertain",
      "completeness": "unknown"
    },
    {
      "id": "p18:b29",
      "type": "paragraph",
      "provider_label": "text",
      "text": "（2）在企业自有资金不足，内部融资不能满足对发展资金的需求时，则努力开通外源型融资渠道战略\n",
      "reading_order": 30,
      "provider_sequence": 29,
      "parent_id": null,
      "children": [],
      "source_spans": [
        {
          "page_number": 18,
          "bbox": [
            0.1475211608222491,
            0.8472499287546309,
            0.8484482063683998,
            0.8785978911370761
          ],
          "character_span": null
        }
      ],
      "disposition": "uncertain",
      "completeness": "unknown"
    },
    {
      "id": "p18:b30",
      "type": "paragraph",
      "provider_label": "text",
      "text": "（3）企业筹资来源的选择中要有利于优化企业资本结构（特别是长期负债与权益",
      "reading_order": 31,
      "provider_sequence": 30,
      "parent_id": null,
      "children": [],
      "source_spans": [
        {
          "page_number": 18,
          "bbox": [
            0.22652156388553002,
            0.8837275577087489,
            0.8480451430874647,
            0.896551724137931
          ],
          "character_span": null
        }
      ],
      "disposition": "uncertain",
      "completeness": "unknown"
    },
    {
      "id": "p19:b0",
      "type": "paragraph",
      "provider_label": "text",
      "text": "资本之间的比例关系要合理）",
      "reading_order": 1,
      "provider_sequence": 0,
      "parent_id": null,
      "children": [],
      "source_spans": [
        {
          "page_number": 19,
          "bbox": [
            0.1483272873841193,
            0.08634938728982616,
            0.37444578798871425,

    {
      "id": "p18:b21",
      "type": "paragraph",
      "provider_label": "text",
      "text": "（1）对各项经营决策起着综合平衡的作用",
      "reading_order": 22,
      "provider_sequence": 21,
      "parent_id": null,
      "children": [],
      "source_spans": [

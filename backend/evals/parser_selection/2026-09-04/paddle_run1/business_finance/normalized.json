      "id": "p18:b11",
      "type": "heading",
      "provider_label": "paragraph_title",
      "text": "（一）概念",
      "reading_order": 12,
      "provider_sequence": 11,
      "parent_id": null,
      "children": [],
      "source_spans": [
        {
          "page_number": 18,
          "bbox": [

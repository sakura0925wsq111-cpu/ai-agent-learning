    {
      "id": "#/texts/69",
      "type": "paragraph",
      "provider_label": "text",
      "text": "We implemented several measures to enable a fair and reproducible benchmark across all tested assets. Specifically, the experimental setup accounts for the following factors:",
      "raw_text": "We implemented several measures to enable a fair and reproducible benchmark across all tested assets. Specifically, the experimental setup accounts for the following factors:",
      "reading_order": 33,
      "level": 1,
      "parent_id": "#/body",
      "children": [],
      "source_spans": [
        {
          "page_number": 5,
          "bbox": [

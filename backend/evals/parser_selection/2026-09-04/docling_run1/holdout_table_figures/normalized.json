    {
      "id": "#/texts/72",
      "type": "list_item",
      "provider_label": "list_item",
      "text": "When running experiments on the L4 GPU, we enable CUDAacceleration in all accepted configuration options, ensure the GPU is visible and all required runtimes for AI inference are installed with CUDA support.",
      "raw_text": "· When running experiments on the L4 GPU, we enable CUDAacceleration in all accepted configuration options, ensure the GPU is visible and all required runtimes for AI inference are installed with CUDA support.",

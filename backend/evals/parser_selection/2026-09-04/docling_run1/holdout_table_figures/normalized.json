      "disposition": "uncertain",
      "completeness": "unknown"
    },
    {
      "id": "#/texts/71",
      "type": "list_item",
      "provider_label": "list_item",
      "text": "When running experiments on CPU, we inform all assets of the desired CPU thread budget of 8 threads, via the OMP NUM THREADS environment variable and any accepted configuration options. The L4 GPU on our AWS EC2 VM is hidden.",
      "raw_text": "· When running experiments on CPU, we inform all assets of the desired CPU thread budget of 8 threads, via the OMP NUM THREADS environment variable and any accepted configuration options. The L4 GPU on our AWS EC2 VM is hidden.",
      "reading_order": 35,
      "level": 2,
      "parent_id": "#/groups/1",
      "children": [],
      "source_spans": [
        {
          "page_number": 5,
          "bbox": [

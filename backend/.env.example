# iCampus configuration template. Copy to backend/.env; never commit real secrets.

# dev | test | prod
APP_ENV=dev
APP_NAME=iCampus
APP_VERSION=0.2.0
DEBUG=true
HOST=127.0.0.1
PORT=8000

# SQLite (dev): sqlite:///./data/icampus.db
# PostgreSQL (required in prod): postgresql+psycopg://icampus:change-me@db:5432/icampus
DATABASE_URL=sqlite:///./data/icampus.db
# Required in production for shared rate limits and AI cost controls.
REDIS_URL=
REDIS_SOCKET_TIMEOUT_SECONDS=1
RATE_LIMIT_KEY_PREFIX=icampus

JWT_SECRET_KEY=replace-with-at-least-32-random-characters
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# DeepSeek / OpenAI-compatible provider. Leave empty for non-AI features.
# LLM_API_KEY remains a legacy alias.
DEEPSEEK_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_TIMEOUT=30
LLM_MAX_RETRIES=0

# Comma-separated exact origins. Never use * in production.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW_SECONDS=300
REGISTRATION_ENABLED=true
REGISTRATION_RATE_LIMIT=5
REGISTRATION_RATE_WINDOW_SECONDS=3600
REGISTRATION_GLOBAL_DAILY_LIMIT=200
AI_DAILY_LIMIT=50
AI_IP_DAILY_LIMIT=250
AI_DEVICE_DAILY_LIMIT=100
AI_GLOBAL_DAILY_LIMIT=2000
AI_GLOBAL_CONCURRENCY_LIMIT=8
AI_CONCURRENCY_LEASE_SECONDS=120
AI_ENABLED=true
UPLOAD_MAX_BYTES=10485760
UPLOAD_RATE_LIMIT=10
UPLOAD_RATE_WINDOW_SECONDS=600
UPLOAD_PDF_MAX_PAGES=50
UPLOAD_EXCEL_MAX_ROWS=2000
UPLOAD_EXCEL_MAX_COLUMNS=100
UPLOAD_XLSX_MAX_ENTRIES=1000
UPLOAD_XLSX_MAX_UNCOMPRESSED_BYTES=52428800
UPLOAD_XLSX_MAX_ENTRY_BYTES=10485760
UPLOAD_XLSX_MAX_COMPRESSION_RATIO=100
UPLOAD_MAX_EXTRACTED_CHARS=200000
UPLOAD_PARSER_TIMEOUT_SECONDS=15
UPLOAD_PARSER_WORKERS=2
IMPORT_PREVIEW_TTL_SECONDS=1800

# Local/test demonstration account. Must be false in production.
DEMO_ACCOUNT_ENABLED=true
DEMO_STUDENT_ID=demo2026
DEMO_PASSWORD=DemoPass123!

LOG_LEVEL=INFO
LOG_DIR=logs
LOG_ROTATION=10 MB
LOG_RETENTION=7 days
MEMORY_MAX_PER_USER=50

# iCampus configuration template. Copy to backend/.env; never commit real secrets.

# dev | test | prod
APP_ENV=dev
APP_NAME=iCampus
APP_VERSION=0.2.0
DEBUG=true
HOST=127.0.0.1
PORT=8000

# SQLite (dev): sqlite:///./data/icampus.db
# PostgreSQL: postgresql+psycopg://icampus:change-me@db:5432/icampus
DATABASE_URL=sqlite:///./data/icampus.db
# Optional future shared rate-limit/cache backend; readiness does not require it.
REDIS_URL=

JWT_SECRET_KEY=replace-with-at-least-32-random-characters
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# DeepSeek / OpenAI-compatible provider. Leave empty for non-AI features.
# LLM_API_KEY remains a legacy alias.
DEEPSEEK_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_TIMEOUT=30
LLM_MAX_RETRIES=1

# Comma-separated exact origins. Never use * in production.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW_SECONDS=300
AI_DAILY_LIMIT=50
UPLOAD_MAX_BYTES=10485760
STUDY_UPLOAD_DIR=data/study_uploads
STUDY_UPLOAD_MAX_BYTES=209715200
STUDY_OCR_ENABLED=true
STUDY_OCR_DPI=200
STUDY_OCR_VERIFY_DPI=240
STUDY_OCR_MIN_CONFIDENCE=0.95
STUDY_OCR_DEVICE=cpu
STUDY_KNOWLEDGE_PIPELINE_VERSION=doubao-vision-v2
STUDY_KNOWLEDGE_MAX_BLOCK_CHARS=12000
STUDY_KNOWLEDGE_MAX_BLOCKS_PER_WINDOW=6
STUDY_KNOWLEDGE_MAX_CANDIDATES=40
STUDY_KNOWLEDGE_MAX_MODEL_CALLS=100
# Doubao Ark direct multimodal document extraction. Never commit a real key.
ARK_API_KEY=
STUDY_DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
STUDY_DOUBAO_MODEL=doubao-seed-2-1-turbo-260628
STUDY_DOUBAO_CONFIDENCE_THRESHOLD=0.85
STUDY_DOUBAO_TIMEOUT=180
STUDY_DOUBAO_FILE_POLL_INTERVAL=2
STUDY_DOUBAO_FILE_POLL_TIMEOUT=120
# Set above 0 only after confirming the selected Ark endpoint accepts Base64 input_file.
STUDY_DOUBAO_INLINE_MAX_BYTES=0
STUDY_DOUBAO_PAGES_PER_BATCH=1
STUDY_DOUBAO_RENDER_DPI=144
STUDY_DOUBAO_JPEG_QUALITY=80
STUDY_DOUBAO_MAX_PAGES=100
# Optional absolute soffice path. Containers use /usr/bin/soffice from the image.
STUDY_DOUBAO_LIBREOFFICE_PATH=
STUDY_DOUBAO_CONVERSION_TIMEOUT=180
STUDY_DOUBAO_MAX_CANDIDATES=600
STUDY_DOUBAO_MAX_OUTPUT_TOKENS=8192
IMPORT_PREVIEW_TTL_SECONDS=1800

# Local/test demonstration account. Must be false in production.
DEMO_ACCOUNT_ENABLED=true
DEMO_STUDENT_ID=demo2026
DEMO_PASSWORD=DemoPass123!

LOG_LEVEL=INFO
LOG_DIR=logs
LOG_ROTATION=10 MB
LOG_RETENTION=7 days
MEMORY_MAX_PER_USER=50

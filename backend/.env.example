# iCampus 环境配置模板
# 复制此文件为 .env 并填入真实值：  copy .env.example .env

# ── App ──
APP_NAME=iCampus
APP_VERSION=0.2.0
DEBUG=true

# ── Server ──
HOST=127.0.0.1
PORT=8000

# ── Database ──
DATABASE_URL=sqlite:///./data/campuspal.db

# ── Auth ──
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ── LLM (DeepSeek 为例) ──
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-pro

# ── Logging ──
LOG_LEVEL=DEBUG
LOG_DIR=logs
LOG_ROTATION=10 MB
LOG_RETENTION=7 days

# ── Memory ──
MEMORY_MAX_PER_USER=50

<view class="fixed-header">
  <view class="status-bar" style="height: {{statusBarHeight}}px;"></view>
</view>

<view class="profile-state" wx:if="{{loading}}">
  <view class="state-spinner"></view>
  <text class="state-text">正在加载个人资料</text>
</view>

<view class="profile-state" wx:elif="{{profileError}}">
  <text class="state-icon">📡</text>
  <text class="state-title">个人资料加载失败</text>
  <text class="state-text">请检查网络后重试</text>
  <button class="retry-btn" bindtap="retryProfile">重新加载</button>
</view>

<scroll-view class="scroll-content" scroll-y wx:else>
  <view class="user-card" bindtap="editProfile">
    <image class="user-avatar" src="/images/mascot1.png" mode="aspectFit"></image>
    <view class="user-info">
      <view class="user-name-wrap">
        <text class="user-name">{{userInfo.name}}</text>
        <text class="user-star">✦</text>
      </view>
      <view class="user-school">{{userInfo.school}}</view>
      <view class="user-tags">
        <view class="user-tag">
          <image class="tag-icon" src="/images/icon-avatar.png" mode="aspectFit"></image>
          <text class="tag-text">学号</text>
        </view>
        <view class="user-tag">
          <image class="tag-icon" src="/images/icon-calendar.png" mode="aspectFit"></image>
          <text class="tag-text">已连续使用{{stats.dayCount}}天</text>
        </view>
      </view>
    </view>
    <text class="user-arrow">›</text>
  </view>

  <view class="section-card">
    <view class="section-header"><text class="section-title">个人信息</text></view>
    <view class="info-list">
      <view class="info-item" wx:for="{{profileList}}" wx:key="label" bindtap="editField" data-field="{{item.field}}" data-label="{{item.label}}">
        <view class="info-left"><text class="info-label">{{item.label}}</text></view>
        <view class="info-right">
          <text class="info-value">{{item.value}}</text>
          <text class="info-arrow">›</text>
        </view>
      </view>
    </view>
  </view>

  <view class="section-card memory-card" bindtap="goToMemory">
    <view class="memory-header">
      <view class="memory-title-wrap">
        <text class="section-title">长期记忆</text>
        <text class="memory-arrow">›</text>
      </view>
      <text class="memory-subtitle">你的AI已记住<text class="memory-count">{{memoryStats.total}}</text> 条信息</text>
    </view>
    <view class="memory-grid">
      <view class="memory-item" wx:for="{{memoryStats.types}}" wx:key="name">
        <view class="memory-icon-wrap" style="background: {{item.bgColor}};">
          <image class="memory-icon" src="{{item.icon}}" mode="aspectFit"></image>
        </view>
        <view class="memory-info">
          <text class="memory-name">{{item.name}}</text>
          <text class="memory-num">{{item.count}}</text>
        </view>
      </view>
    </view>
  </view>

  <view class="section-card">
    <view class="section-header"><text class="section-title">设置</text></view>
    <view class="info-list">
      <view class="info-item" bindtap="goToSettings">
        <view class="info-left"><text class="info-label">设置中心</text></view>
        <view class="info-right"><text class="info-arrow">›</text></view>
      </view>
      <view class="info-item" bindtap="showAbout" data-type="about">
        <view class="info-left"><text class="info-label">关于 iCampus</text></view>
        <view class="info-right"><text class="info-arrow">›</text></view>
      </view>
      <view class="info-item">
        <view class="info-left"><text class="info-label">版本号</text></view>
        <view class="info-right"><text class="info-value">v2.1</text></view>
      </view>
    </view>
  </view>

  <view class="section-card">
    <view class="section-header"><text class="section-title">账号操作</text></view>
    <view class="info-list">
      <view class="info-item account-item" bindtap="logout">
        <view class="info-left">
          <image class="account-icon" src="/images/icon-logout.png" mode="aspectFit"></image>
          <text class="info-label">退出登录</text>
        </view>
        <view class="info-right"><text class="info-arrow">›</text></view>
      </view>
      <view class="info-item account-item" bindtap="deleteAccount">
        <view class="info-left">
          <image class="account-icon" src="/images/icon-delete.png" mode="aspectFit"></image>
          <text class="info-label danger">注销账号</text>
        </view>
        <view class="info-right"><text class="info-arrow">›</text></view>
      </view>
    </view>
  </view>

  <view class="bottom-safe"></view>
</scroll-view>

<!-- 状态栏占位 -->
<view class="status-bar" style="height: {{statusBarHeight}}px;"></view>

<!-- 返回按钮 -->
<view class="nav-back" bindtap="goBack">
  <text class="back-icon">←</text>
</view>

<!-- 主内容区 -->
<view class="register-content">
  
  <!-- 标题区 -->
  <view class="header-section">
    <view class="title">欢迎使用 iCampus<text class="star">✨</text></view>
    <view class="subtitle">完善信息，让我们更好地为你服务</view>
  </view>
  
  <!-- 吉祥物 -->
  <image class="mascot" src="/images/mascot.png" mode="aspectFit"></image>
  
  <!-- 注册表单 -->
  <view class="form-section">
    
    <!-- 姓名 -->
    <view class="form-item">
      <view class="form-label">姓名 <text class="required">*</text></view>
      <view class="input-wrap">
        <input class="form-input" placeholder="请输入真实姓名" value="{{name}}" bindinput="onNameInput"/>
      </view>
    </view>
    
    <!-- 学号 -->
    <view class="form-item">
      <view class="form-label">学号 <text class="required">*</text></view>
      <view class="input-wrap">
        <input class="form-input" placeholder="请输入学号" value="{{studentId}}" bindinput="onStudentIdInput"/>
      </view>
    </view>
    
    <!-- 学校 -->
    <view class="form-item">
      <view class="form-label">学校 <text class="required">*</text></view>
      <view class="input-wrap">
        <input class="form-input" placeholder="请输入学校名称" value="{{school}}" bindinput="onSchoolInput"/>
      </view>
    </view>
    
    <!-- 学院 -->
    <view class="form-item">
      <view class="form-label">学院 <text class="required">*</text></view>
      <view class="input-wrap">
        <input class="form-input" placeholder="请输入学院名称" value="{{college}}" bindinput="onCollegeInput"/>
      </view>
    </view>
    
    <!-- 专业 -->
    <view class="form-item">
      <view class="form-label">专业 <text class="required">*</text></view>
      <view class="input-wrap">
        <input class="form-input" placeholder="请输入专业名称" value="{{major}}" bindinput="onMajorInput"/>
      </view>
    </view>
    
    <!-- 入学年份 -->
    <view class="form-item">
      <view class="form-label">入学年份 <text class="required">*</text></view>
      <picker mode="selector" range="{{yearOptions}}" bindchange="onYearChange">
        <view class="input-wrap">
          <input class="form-input" placeholder="请选择入学年份" value="{{enrollYear}}" disabled/>
          <text class="arrow-down">▼</text>
        </view>
      </picker>
    </view>
    
    <!-- 年级 -->
    <view class="form-item">
      <view class="form-label">年级 <text class="required">*</text></view>
      <picker mode="selector" range="{{gradeOptions}}" bindchange="onGradeChange">
        <view class="input-wrap">
          <input class="form-input" placeholder="请选择年级" value="{{grade}}" disabled/>
          <text class="arrow-down">▼</text>
        </view>
      </picker>
    </view>
    
    <!-- 密码 -->
    <view class="form-item">
      <view class="form-label">密码 <text class="required">*</text></view>
      <view class="input-wrap">
        <input class="form-input" type="password" placeholder="请设置密码（至少6位）" value="{{password}}" bindinput="onPasswordInput"/>
      </view>
    </view>
    
    <!-- 完成按钮 -->
    <button class="submit-btn {{canSubmit ? 'active' : ''}}" bindtap="doRegister">完成</button>
    
    <!-- 协议 -->
    <view class="agreement">
      <checkbox class="agree-check" checked="{{agreed}}" bindtap="toggleAgree"/>
      <text class="agree-text">我已阅读并同意</text>
      <text class="agree-link" bindtap="showAgreement">《用户协议》</text>
      <text class="agree-text">和</text>
      <text class="agree-link" bindtap="showPrivacy">《隐私政策》</text>
    </view>
  </view>
</view>
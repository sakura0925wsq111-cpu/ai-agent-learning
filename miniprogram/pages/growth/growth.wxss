page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background: #F5F7FA;
  color: #1A1A1A;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
}

.fixed-header {
  flex-shrink: 0;
  width: 100%;
  background: rgba(255, 255, 255, 0.98);
  border-bottom: 1rpx solid #EEF1F5;
}

.status-bar { width: 100%; }

.custom-nav {
  height: 88rpx;
  padding: 0 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
}

.nav-left, .nav-right { width: 168rpx; box-sizing: border-box; }
.nav-left { display: flex; justify-content: flex-start; }
.nav-right { display: flex; justify-content: flex-end; }
.back-icon { padding: 12rpx 16rpx 12rpx 0; font-size: 48rpx; color: #1A1A1A; }
.nav-title { font-size: 34rpx; font-weight: 600; }
.nav-reports { padding: 18rpx 0; font-size: 24rpx; color: #4F67D8; white-space: nowrap; }

.scroll-content {
  flex: 1;
  width: 100%;
  padding: 0 24rpx;
  box-sizing: border-box;
  overflow-y: auto;
}

.intro-section { padding: 36rpx 8rpx 26rpx; display: flex; flex-direction: column; }
.compact-intro { padding-bottom: 20rpx; }
.intro-eyebrow { color: #536FE7; font-size: 24rpx; font-weight: 500; }
.intro-title { margin-top: 10rpx; color: #171A21; font-size: 42rpx; font-weight: 700; line-height: 1.3; }
.intro-desc { margin-top: 12rpx; color: #7D8795; font-size: 26rpx; line-height: 1.6; }

.sandbox-primary, .coach-hero, .planning-card {
  position: relative;
  overflow: hidden;
  padding: 32rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #5B70E8 0%, #7658C8 100%);
  box-shadow: 0 14rpx 36rpx rgba(82, 94, 191, 0.24);
  color: #FFFFFF;
}

.sandbox-primary:active, .coach-hero:active, .planning-card:active { transform: scale(0.992); opacity: 0.96; }
.sandbox-primary::after, .coach-hero::after, .planning-card::after {
  content: "";
  position: absolute;
  width: 240rpx;
  height: 240rpx;
  right: -80rpx;
  top: -90rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.08);
}

.sandbox-tags { position: relative; z-index: 1; display: flex; flex-wrap: wrap; gap: 10rpx; }
.sandbox-tags text { padding: 7rpx 16rpx; border-radius: 12rpx; background: rgba(255,255,255,0.18); font-size: 22rpx; }
.sandbox-primary-title { position: relative; z-index: 1; display: block; margin-top: 24rpx; font-size: 40rpx; font-weight: 700; }
.sandbox-primary-desc { position: relative; z-index: 1; display: block; margin-top: 12rpx; max-width: 560rpx; color: rgba(255,255,255,0.86); font-size: 25rpx; line-height: 1.6; }
.sandbox-primary-btn, .coach-main-btn {
  position: relative;
  z-index: 1;
  height: 84rpx;
  margin-top: 28rpx;
  padding: 0 26rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-radius: 18rpx;
  background: #FFFFFF;
  color: #4D61CF;
  font-size: 28rpx;
  font-weight: 600;
}

.section-heading { margin: 38rpx 4rpx 18rpx; }
.tools-heading { margin-top: 34rpx; }
.section-heading > view { display: flex; align-items: baseline; justify-content: space-between; gap: 16rpx; }
.section-title { color: #1A1A1A; font-size: 31rpx; font-weight: 650; }
.section-subtitle { color: #9AA3AF; font-size: 22rpx; }

.agent-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16rpx; }
.agent-card {
  min-height: 112rpx;
  padding: 18rpx 18rpx;
  display: flex;
  align-items: center;
  gap: 14rpx;
  border-radius: 22rpx;
  background: #FFFFFF;
  border: 1rpx solid #EBEEF3;
  box-shadow: 0 6rpx 20rpx rgba(31, 48, 78, 0.05);
  box-sizing: border-box;
}
.agent-card:active { background: #F7F9FC; transform: scale(0.985); }
.agent-icon { width: 58rpx; height: 58rpx; flex-shrink: 0; }
.agent-copy { min-width: 0; flex: 1; display: flex; flex-direction: column; }
.agent-name { color: #22252C; font-size: 27rpx; font-weight: 600; white-space: nowrap; }
.agent-desc { margin-top: 5rpx; color: #9AA3AF; font-size: 19rpx; line-height: 1.35; }
.agent-arrow { flex-shrink: 0; color: #A5ADBA; font-size: 30rpx; }

.coach-secondary, .sandbox-secondary {
  min-height: 112rpx;
  margin-top: 24rpx;
  padding: 20rpx 24rpx;
  display: flex;
  align-items: center;
  gap: 18rpx;
  border-radius: 22rpx;
  border: 2rpx dashed #CAD3EC;
  background: #FFFFFF;
  box-sizing: border-box;
}
.coach-secondary:active, .sandbox-secondary:active { background: #F6F8FD; }
.coach-small-icon, .sandbox-secondary-icon {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  border-radius: 20rpx;
  background: #EEF1FF;
  color: #556CDD;
  font-size: 27rpx;
  font-weight: 700;
}
.secondary-copy { min-width: 0; flex: 1; display: flex; flex-direction: column; }
.secondary-title { color: #252932; font-size: 27rpx; font-weight: 600; }
.secondary-desc { margin-top: 5rpx; color: #8D97A6; font-size: 22rpx; }
.secondary-arrow { color: #778399; font-size: 30rpx; }

.planning-card { margin-top: 2rpx; }
.planning-top { position: relative; z-index: 1; display: flex; justify-content: space-between; align-items: center; }
.planning-label { padding: 6rpx 13rpx; border-radius: 10rpx; background: rgba(255,255,255,0.18); font-size: 21rpx; }
.planning-step { color: rgba(255,255,255,0.84); font-size: 23rpx; }
.planning-title { position: relative; z-index: 1; display: block; margin-top: 26rpx; font-size: 38rpx; font-weight: 700; }
.planning-desc { position: relative; z-index: 1; display: block; margin-top: 10rpx; color: rgba(255,255,255,0.82); font-size: 24rpx; }
.planning-action { position: relative; z-index: 1; margin-top: 30rpx; font-size: 28rpx; font-weight: 600; }
.planning-action text { margin-left: 8rpx; }

.coach-hero { margin-top: 32rpx; }
.coach-header { position: relative; z-index: 1; display: flex; align-items: center; gap: 18rpx; }
.coach-avatar {
  width: 76rpx;
  height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 24rpx;
  background: rgba(255,255,255,0.2);
  font-size: 31rpx;
  font-weight: 700;
}
.coach-title-wrap { display: flex; flex-direction: column; }
.coach-title { font-size: 36rpx; font-weight: 700; }
.coach-desc { margin-top: 6rpx; color: rgba(255,255,255,0.82); font-size: 24rpx; }
.coach-progress-copy { position: relative; z-index: 1; margin-top: 28rpx; display: flex; justify-content: space-between; color: rgba(255,255,255,0.9); font-size: 22rpx; }
.coach-progress { position: relative; z-index: 1; height: 10rpx; margin-top: 12rpx; overflow: hidden; border-radius: 999rpx; background: rgba(255,255,255,0.24); }
.coach-progress view { height: 100%; border-radius: 999rpx; background: #FFFFFF; transition: width 0.35s ease; }

.coach-quick-row { margin-top: 18rpx; display: grid; grid-template-columns: repeat(3, 1fr); gap: 12rpx; }
.coach-quick {
  min-height: 84rpx;
  padding: 0 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  border-radius: 18rpx;
  background: #FFFFFF;
  border: 1rpx solid #E7EAF0;
  color: #373D48;
  font-size: 22rpx;
  box-shadow: 0 4rpx 14rpx rgba(34, 52, 84, 0.04);
}
.coach-quick:active { background: #F1F4FB; }
.quick-icon { width: 32rpx; height: 32rpx; display: flex; align-items: center; justify-content: center; border-radius: 10rpx; background: #EEF1FF; color: #5268D8; font-size: 20rpx; font-weight: 700; }

.report-card {
  margin-top: 22rpx;
  padding: 26rpx;
  display: flex;
  align-items: center;
  gap: 18rpx;
  border-radius: 24rpx;
  background: #FFFFFF;
  border: 1rpx solid #E7EBF1;
  box-shadow: 0 7rpx 24rpx rgba(31, 48, 78, 0.06);
}
.report-main { min-width: 0; flex: 1; display: flex; flex-direction: column; }
.report-label { color: #5268D8; font-size: 21rpx; font-weight: 600; }
.report-title { margin-top: 7rpx; color: #20242D; font-size: 30rpx; font-weight: 650; }
.report-meta { margin-top: 7rpx; color: #929CAA; font-size: 22rpx; }
.report-actions { display: flex; flex-direction: column; align-items: flex-end; gap: 12rpx; }
.report-link { padding: 12rpx 0; color: #4F67D8; font-size: 24rpx; white-space: nowrap; }
.report-start { padding: 10rpx 16rpx; border-radius: 12rpx; background: #EEF1FF; color: #4E64CF; font-size: 22rpx; white-space: nowrap; }

.dashboard-loading { padding-top: 32rpx; }
.loading-block { border-radius: 24rpx; background: linear-gradient(90deg, #ECEFF4 25%, #F7F8FA 50%, #ECEFF4 75%); background-size: 200% 100%; animation: shimmer 1.3s infinite; }
.loading-hero { height: 330rpx; }
.loading-row { height: 100rpx; margin-top: 18rpx; }
.loading-grid { height: 260rpx; margin-top: 28rpx; }
@keyframes shimmer { 0% { background-position: 200% 0; } 100% { background-position: -200% 0; } }

.safe-space { height: calc(56rpx + env(safe-area-inset-bottom)); }

@media (max-width: 350px) {
  .agent-grid { grid-template-columns: 1fr; }
  .section-heading > view { align-items: flex-start; flex-direction: column; }
}

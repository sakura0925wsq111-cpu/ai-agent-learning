page {
  background: #F5F7FA;
  height: 100vh;
  font-family: -apple-system, BlinkMacSystemFont, '.萍方-简', 'Microsoft YaHei', sans-serif;
}

/* ========== 容器 ========== */
.container {
  height: 100vh;
  position: relative;
}

/* ========== 固定顶部区域：统一白色背景 ========== */
.fixed-header {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background: #FFFFFF;  /* 关键：统一背景色覆盖状态栏 */
}

/* ========== 状态栏 ========== */
.status-bar {
  width: 100%;
}

/* ========== 自定义导航栏 ========== */
.custom-nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  padding: 0 20rpx;       /* 统一 20rpx，与 tasks 页面一致 */
  width: 100%;
  box-sizing: border-box;
}

.nav-back {
  width: 64rpx;          /* 统一 64rpx */
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-icon {
  font-size: 48rpx;
  color: #1A1A1A;
  font-weight: 300;
  line-height: 1;
}

.nav-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #1A1A1A;
}

.nav-placeholder {
  width: 64rpx;          /* 统一 64rpx */
}

/* ========== Tab 切换：移入 fixed-header 内部 ========== */
.tab-bar {
  display: flex;
  justify-content: center;
  gap: 120rpx;           /* 增加间距，与 tasks 页面 80rpx 区分，更大气 */
  background: #FFFFFF;   /* 与头部统一背景 */
  padding: 0 0 4rpx;     /* 底部留 4rpx 给指示线 */
  /* 删除 border-bottom，避免与内容区之间的线条 */
}

.tab-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 16rpx;
  position: relative;
  height: 72rpx;         /* 固定高度 */
  justify-content: center;
}

.tab-text {
  font-size: 30rpx;
  color: #999999;
  line-height: 1;
  padding-bottom: 12rpx; /* 文字与指示线间距 */
}

.tab-item.active .tab-text {
  color: #4A90D9;
  font-weight: 500;
}

/* 指示线默认透明，激活时显示 */
.tab-line {
  position: absolute;
  bottom: 4rpx;
  width: 48rpx;
  height: 4rpx;
  background: transparent;
  border-radius: 2rpx;
  transition: all 0.3s ease;
}

.tab-item.active .tab-line {
  background: #4A90D9;
}

/* ========== 内容区域：动态 padding-top ========== */
.content {
  height: 100vh;
  box-sizing: border-box;
  background: #F5F7FA;
  /* padding-top 由 WXML 内联样式动态设置：{{navHeight}}px */
}

.semester-setting-card {
  margin: 24rpx 32rpx 0;
  padding: 24rpx;
  border-radius: 20rpx;
  background: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(35, 82, 124, 0.06);
}

.semester-setting-card:active {
  background: #F8FBFE;
}

.semester-setting-main {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.semester-setting-title {
  color: #1A1A1A;
  font-size: 28rpx;
  font-weight: 600;
}

.semester-setting-desc {
  margin-top: 8rpx;
  color: #8A8A8A;
  font-size: 22rpx;
  line-height: 1.4;
}

.semester-setting-value {
  color: #4A90D9;
  font-size: 26rpx;
  white-space: nowrap;
}

.semester-setting-value.unset {
  color: #E67E22;
}

.semester-setting-arrow {
  margin-left: 6rpx;
  font-size: 32rpx;
}

/* 删除以下旧代码：
   .nav-wrapper { ... }  -- 未使用的类
   --nav-height 变量      -- 改为 JS 动态计算
*/

/* ========== 上传区域 ========== */
.upload-section {
  padding: 32rpx;
  /* 让上传区域在内容区中垂直居中 */
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;  /* 垂直居中 */
  min-height: 0;  /* 防止 flex 子项溢出 */
}

.upload-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 100%;
  max-width: 600rpx;  /* 限制最大宽度 */
  height: 180rpx;     /* 减小高度，原来是 440rpx */
  background: #FFFFFF;
  border: 2rpx dashed #D9D9D9;
  border-radius: 24rpx;
}

.upload-area:active {
  background: #FAFAFA;
}

.upload-icon {
  width: 100rpx;
  height: 100rpx;
  margin-bottom: 24rpx;
}

.upload-title {
  font-size: 32rpx;
  color: #333333;
  font-weight: 500;
  margin-bottom: 12rpx;
}

.upload-hint {
  font-size: 26rpx;
  color: #999999;
}

/* 上传中状态 */
.uploading {
  border-style: solid;
  border-color: #E8F4FD;
  background: #FAFBFC;
}

.loading-spinner {
  width: 56rpx;
  height: 56rpx;
  border: 4rpx solid #E8F4FD;
  border-top-color: #4A90D9;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-bottom: 24rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

/* ========== 文件信息卡片 ========== */
.file-card {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.file-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.file-icon.pdf {
  background: #FFF1F0;
}

.file-icon.excel {
  background: #F6FFED;
}

.file-icon-text {
  font-size: 22rpx;
  font-weight: 700;
}

.file-icon.pdf .file-icon-text {
  color: #E74C3C;
}

.file-icon.excel .file-icon-text {
  color: #52C41A;
}

.file-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.file-name {
  font-size: 28rpx;
  color: #1A1A1A;
  font-weight: 500;
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.file-size {
  font-size: 24rpx;
  color: #999999;
  margin-top: 6rpx;
}

.file-replace {
  font-size: 26rpx;
  color: #4A90D9;
  padding: 8rpx 12rpx;
  flex-shrink: 0;
}

.file-replace:active {
  opacity: 0.7;
}

/* ========== 状态卡片 ========== */
.status-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 40rpx;
  background: #FFFFFF;
  border-radius: 16rpx;
}

.status-card.mismatch {
  margin-top: 16rpx;
}

.status-icon {
  font-size: 80rpx;      /* 用 emoji 时调整大小 */
  margin-bottom: 24rpx;
}

/* 图片图标时 */
.status-card .status-icon[src] {
  width: 140rpx;
  height: 140rpx;
  margin-bottom: 24rpx;
}

.status-title {
  font-size: 30rpx;
  color: #1A1A1A;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.status-desc {
  font-size: 26rpx;
  color: #999999;
  margin-bottom: 32rpx;
  text-align: center;
  line-height: 1.6;
}

.status-btn {
  font-size: 28rpx;
  color: #4A90D9;
  padding: 14rpx 40rpx;
  border: 2rpx solid #4A90D9;
  border-radius: 36rpx;
}

.status-btn:active {
  background: #E8F4FD;
}

/* ========== 预览区域 ========== */
.preview-section {
  margin-top: 12rpx;
}

.select-all-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 32rpx;
  background: #FFFFFF;
  margin-bottom: 2rpx;
}

.checkbox-wrap {
  display: flex;
  align-items: center;
}

.checkbox {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  border: 2rpx solid #D9D9D9;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 12rpx;
  transition: all 0.2s ease;
}

.checkbox.checked {
  background: #4A90D9;
  border-color: #4A90D9;
}

.check-icon {
  font-size: 22rpx;
  color: #FFFFFF;
  font-weight: 700;
}

.select-all-text {
  font-size: 26rpx;
  color: #666666;
}

.select-count {
  font-size: 24rpx;
  color: #999999;
}

/* ========== 预览列表 ========== */
.preview-list {
  background: #FFFFFF;
}

.preview-item {
  display: flex;
  align-items: flex-start;
  padding: 24rpx 32rpx;
  border-bottom: 1rpx solid #F5F5F5;
  transition: background 0.2s ease;
}

.preview-item:active {
  background: #FAFAFA;
}

.preview-item.selected {
  background: #F0F7FF;
}

.item-checkbox {
  margin-right: 16rpx;
  padding-top: 4rpx;
}

.item-content {
  flex: 1;
  min-width: 0;
}

.item-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
}

.item-row.primary {
  margin-bottom: 10rpx;
}

.item-row.secondary {
  margin-bottom: 6rpx;
}

.item-name {
  font-size: 28rpx;
  color: #1A1A1A;
  font-weight: 600;
}

.item-teacher {
  font-size: 24rpx;
  color: #666666;
  background: #F5F5F5;
  padding: 2rpx 12rpx;
  border-radius: 6rpx;
}

.item-location,
.item-date,
.item-time {
  font-size: 24rpx;
  color: #666666;
}

.item-schedule {
  font-size: 22rpx;
  color: #999999;
  background: #F5F7FA;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
}

/* ========== 底部固定栏 ========== */
.footer-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: #FFFFFF;
  border-top: 1rpx solid #F0F0F0;
  z-index: 100;
}

.confirm-btn {
  width: 100%;
  height: 80rpx;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 500;
  transition: all 0.2s ease;
}

.confirm-btn.disabled {
  background: #E8E8E8;
  color: #BBBBBB;
}

.confirm-btn.active {
  background: #4A90D9;
  color: #FFFFFF;
  box-shadow: 0 6rpx 20rpx rgba(74, 144, 217, 0.3);
}

.confirm-btn.active:active {
  transform: scale(0.98);
  opacity: 0.9;
}

.confirm-btn.loading {
  background: #7AB8E8;
}

.btn-text {
  font-size: 30rpx;
}

.btn-loading {
  display: flex;
  gap: 10rpx;
  align-items: center;
}

.btn-loading .loading-dot {
  width: 14rpx;
  height: 14rpx;
  background: #FFFFFF;
  border-radius: 50%;
  animation: btn-dot-pulse 1.4s infinite ease-in-out both;
}

.btn-loading .loading-dot:nth-child(1) { animation-delay: -0.32s; }
.btn-loading .loading-dot:nth-child(2) { animation-delay: -0.16s; }

@keyframes btn-dot-pulse {
  0%, 80%, 100% { transform: scale(0.6); opacity: 0.5; }
  40% { transform: scale(1); opacity: 1; }
}

.bottom-safe {
  height: 120rpx;
}

/* ========== 格式提示按钮 ========== */
.format-tip-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 24rpx;
  padding: 16rpx 24rpx;
}

.format-tip-icon {
  font-size: 26rpx;
  color: #999999;
  margin-right: 8rpx;
}

.format-tip-text {
  font-size: 26rpx;
  color: #999999;
}

.format-tip-bar:active .format-tip-text {
  color: #4A90D9;
}

/* ========== 弹窗 ========== */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 200;
  animation: maskFadeIn 0.2s ease;
}

@keyframes maskFadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

.modal-content {
  position: fixed;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 560rpx;
  max-height: 70vh;
  background: #FFFFFF;
  border-radius: 24rpx;
  z-index: 201;
  display: flex;
  flex-direction: column;
  animation: modalScaleIn 0.2s ease;
  box-sizing: border-box;
}

@keyframes modalScaleIn {
  from { transform: translate(-50%, -50%) scale(0.9); opacity: 0; }
  to { transform: translate(-50%, -50%) scale(1); opacity: 1; }
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 32rpx 24rpx;
  border-bottom: 1rpx solid #F0F0F0;
  flex-shrink: 0;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1A1A1A;
}

.modal-close {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.close-icon {
  font-size: 28rpx;
  color: #999999;
}

.modal-body {
  flex: 1;
  padding: 24rpx 32rpx;
  max-height: 50vh;
  overflow-y: auto;
}

.require-section {
  margin-bottom: 32rpx;
}

.require-section:last-child {
  margin-bottom: 0;
}

.require-label {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #1A1A1A;
  margin-bottom: 16rpx;
}

.require-text {
  display: block;
  font-size: 26rpx;
  color: #666666;
  line-height: 1.6;
  margin-bottom: 16rpx;
}

.require-table {
  background: #F5F7FA;
  border-radius: 12rpx;
  overflow: hidden;
  margin-bottom: 8rpx;
  width: 100%;
  box-sizing: border-box;
}

.require-row {
  display: flex;
  padding: 16rpx 8rpx;
  width: 100%;
  box-sizing: border-box;
}

.require-row.header {
  background: #E8F4FD;
}

.require-row:not(.header) {
  border-top: 1rpx solid #EEEEEE;
}

.require-cell {
  flex: 1;
  font-size: 22rpx;
  color: #333333;
  text-align: center;
  line-height: 1.4;
  padding: 0 4rpx;
  word-break: break-all;
  min-width: 0;
}

.require-row.header .require-cell {
  color: #4A90D9;
  font-weight: 500;
}

.require-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.require-item {
  font-size: 26rpx;
  color: #666666;
  line-height: 1.6;
}

.modal-footer {
  padding: 20rpx 32rpx 32rpx;
  border-top: 1rpx solid #F0F0F0;
  flex-shrink: 0;
}

.modal-btn {
  width: 100%;
  height: 80rpx;
  background: #4A90D9;
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 500;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-btn:active {
  opacity: 0.9;
}

<view class="container">
  <view class="status-bar" style="height: {{statusBarHeight}}px;"></view>
  
  <view class="custom-nav">
    <view class="nav-left" bindtap="goBack"><text class="back-icon">←</text></view>
    <view class="nav-title">设置中心</view>
    <view class="nav-right"></view>
  </view>

  <scroll-view class="scroll-content" scroll-y>
    <view class="loading-state" wx:if="{{loading}}">
      <view class="loading-dots"><view class="dot"></view><view class="dot"></view><view class="dot"></view></view>
    </view>

    <view class="load-error" wx:elif="{{loadError}}">
      <text class="load-error-icon">📡</text>
      <text>设置加载失败</text>
      <button class="load-retry" bindtap="retryLoad">重新加载</button>
    </view>

    <block wx:else>
      <!-- 个人信息 -->
      <view class="section-card">
        <view class="section-header"><text class="section-title">个人信息</text></view>
        <view class="info-list">
          <view class="info-item" wx:for="{{profileList}}" wx:key="field" bindtap="editField" data-field="{{item.field}}" data-label="{{item.label}}">
            <view class="info-left"><text class="info-label">{{item.label}}</text></view>
            <view class="info-right">
              <text class="info-value">{{item.value || '未设置'}}</text>
              <text class="info-arrow">›</text>
            </view>
          </view>
        </view>
      </view>

      <!-- 长期记忆 -->
      <view class="section-card" bindtap="goToMemory">
        <view class="section-header">
          <view class="section-title-wrap">
            <text class="section-title">长期记忆</text>
            <text class="section-arrow">›</text>
          </view>
        </view>
        <view class="memory-row">
          <text class="memory-desc">AI 已记住 </text>
          <text class="memory-count">{{memoryTotal}}</text>
          <text class="memory-desc"> 条关于你的信息</text>
        </view>
      </view>

      <!-- 关于 -->
      <view class="section-card">
        <view class="section-header"><text class="section-title">关于</text></view>
        <view class="info-list">
          <view class="info-item" bindtap="showAbout">
            <view class="info-left"><text class="info-label">关于 iCampus</text></view>
            <view class="info-right"><text class="info-arrow">›</text></view>
          </view>
          <view class="info-item">
            <view class="info-left"><text class="info-label">版本号</text></view>
            <view class="info-right"><text class="info-value">v2.1</text></view>
          </view>
        </view>
      </view>

      <!-- 账号操作 -->
      <view class="section-card">
        <view class="section-header"><text class="section-title">账号操作</text></view>
        <view class="info-list">
          <view class="info-item" bindtap="logout">
            <view class="info-left">
              <image class="account-icon" src="/images/icon-logout.png" mode="aspectFit"></image>
              <text class="info-label">退出登录</text>
            </view>
            <view class="info-right"><text class="info-arrow">›</text></view>
          </view>
          <view class="info-item" bindtap="deleteAccount">
            <view class="info-left">
              <image class="account-icon" src="/images/icon-delete.png" mode="aspectFit"></image>
              <text class="info-label danger">注销账号</text>
            </view>
            <view class="info-right"><text class="info-arrow">›</text></view>
          </view>
        </view>
      </view>
    </block>

    <view class="bottom-safe"></view>
  </scroll-view>
</view>

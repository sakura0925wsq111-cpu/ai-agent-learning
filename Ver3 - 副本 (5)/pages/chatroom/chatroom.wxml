<view class="status-bar" style="height: {{statusBarHeight}}px;"></view>

<view class="custom-nav">
  <view class="nav-left" bindtap="goBack">
    <text class="back-icon">‹</text>
  </view>
  <view class="nav-title">决策教练</view>
  <view class="nav-right">
    <text class="more-icon">...</text>
  </view>
</view>

<!-- ========== 新增：Growth 进度条 ========== -->
<view wx:if="{{showGrowthProgress && mode === 'agent'}}" class="growth-progress-bar" bindtap="toggleProgressDetail">
  <view class="progress-main">
    <text class="progress-icon">📊</text>
    <text class="progress-title">{{growthProgress.agent}}规划进度</text>
    <text class="progress-phase">{{growthProgress.phaseName}}</text>
    <view class="progress-blocks">{{growthProgress.blocks}}</view>
    <text class="progress-percent">{{growthProgress.percent}}%</text>
  </view>
  <view class="progress-sub">
    已完成 {{growthProgress.done}}/{{growthProgress.total}} 项
    <text class="progress-arrow {{showProgressDetail ? 'up' : 'down'}}">▼</text>
  </view>
  
  <!-- 展开的阶段明细 -->
  <view wx:if="{{showProgressDetail && growthProgress.phases.length > 0}}" class="progress-detail">
    <view class="phase-item" wx:for="{{growthProgress.phases}}" wx:key="name">
      <text class="phase-name">{{item.name}}</text>
      <view class="phase-mini-bar">
        <view class="phase-mini-fill" style="width: {{item.percent}}%"></view>
      </view>
      <text class="phase-count">{{item.done}}/{{item.total}}</text>
    </view>
  </view>
</view>
<!-- ========== 新增结束 ========== -->

<scroll-view class="message-list" scroll-y scroll-into-view="{{scrollToView}}" enhanced show-scrollbar="{{false}}">
  <view class="message-item {{item.role}}" wx:for="{{messages}}" wx:key="id" id="msg-{{item.id}}">
    <block wx:if="{{item.role === 'assistant'}}">
      <image class="avatar ai-avatar" src="/images/icon-avatar.png"></image>
      <view class="message-bubble assistant">
        <text class="message-text">{{item.content}}</text><text class="message-time">{{item.time}}</text>
      </view>
    </block>
    <block wx:if="{{item.role === 'user'}}">
      <view class="message-bubble user">
        <text class="message-text">{{item.content}}</text><text class="message-time">{{item.time}}</text>
      </view>
      <view class="avatar user-avatar">
        <text>我</text>
      </view>
    </block>
  </view>

  <view wx:if="{{progress > 0 && progress < 100}}" class="progress-wrap">
  <progress percent="{{progress}}" stroke-width="3" activeColor="#4A90D9" backgroundColor="#E8E8E8" border-radius="2" />
  <text class="progress-text">生成中 {{progress}}%</text>
</view>

  <view wx:if="{{isLoading && !showAnalysisCard}}" class="loading-item">
    <image class="loading-avatar" src="/images/icon-avatar.png"></image>
    <view class="loading-bubble">
      <view class="loading-dot"></view>
      <view class="loading-dot"></view>
      <view class="loading-dot"></view>
    </view>
  </view>

  <view wx:if="{{showRetry}}" class="retry-banner" bindtap="retryLastMessage">
  <text>生成超时，点击重试</text>
</view>

  <view id="bottom-anchor" style="height: 20rpx;"></view>
</scroll-view>

<view wx:if="{{showAnalysisCard}}" class="analysis-card-section">
  <view class="analysis-card-header">
    <text class="analysis-card-icon">&#x1F4CB;</text>
    <text class="analysis-card-title">AI 分析完成</text>
  </view>
  <text class="analysis-card-desc">确认生成完整报告，或修正分析方向</text>
  <view class="analysis-card-actions">
    <button class="analysis-btn correct-btn" bindtap="correctAnalysis">修正</button>
    <button class="analysis-btn approve-btn" bindtap="approveAnalysis">确认并生成报告</button>
  </view>
</view>

<view wx:if="{{showCards && selectingPaths}}" class="cards-section">
  <view class="cards-title">选择你想对比的方向（可多选）</view>
  <view class="direction-card {{selectedPaths.indexOf(item.type) >= 0 ? 'card-selected' : ''}}" wx:for="{{cards}}" wx:key="type" style="border-color: {{item.color}}; background: {{item.bgColor}}" data-type="{{item.type}}" bindtap="togglePathCard">
    <view class="card-checkbox">
      <text wx:if="{{selectedPaths.indexOf(item.type) >= 0}}">&#x2705;</text>
      <text wx:else>&#x25CB;</text>
    </view>
    <view class="card-body">
      <view class="card-header">
        <text class="card-name">{{item.name}}</text>
        <text class="card-score" style="color: {{item.color}}">{{item.time_label}}</text>
      </view>
      <text class="card-insight">{{item.insight}}</text>
      <view class="card-meta">
        <text class="card-meta-item">&#x26A0;&#xFE0F; {{item.risk_label}}</text>
      </view>
    </view>
  </view>
  <button class="confirm-path-btn" bindtap="confirmPathSelection" wx:if="{{selectedPaths.length > 0}}">
    开始对比(已选{{selectedPaths.length}}个方向)
  </button>
</view>

<view wx:if="{{showCards && !selectingPaths}}" class="cards-section">
  <view class="cards-title">选择一个方向，开始深度规划</view>
  <view class="direction-card {{item.recommended ? 'card-recommended' : ''}}" wx:for="{{cards}}" wx:key="type" style="border-color: {{item.recommended ? item.color : 'transparent'}}; background: {{item.bgColor}}" data-type="{{item.type}}" bindtap="selectDirection">
    <image class="card-icon-img" src="/images/{{item.icon}}.png" mode="aspectFit"></image>
    <view class="card-body">
      <view class="card-header">
        <text class="card-name">{{item.name}}</text>
        <text class="card-score" style="color: {{item.color}}">{{item.match_score}}% 匹配</text>
      </view>
      <text class="card-insight">{{item.insight}}</text>
      <view class="card-meta">
        <text class="card-meta-item">{{item.time_label}}</text>
        <text class="card-meta-item">&#x26A0;&#xFE0F; {{item.risk_label}}</text>
      </view>
    </view>
    <text class="card-arrow" style="color: {{item.color}}">&rarr;</text>
  </view>
</view>

<view class="quick-actions" wx:if="{{showQuickActions}}">
  <view class="quick-tag" wx:for="{{quickOptions}}" wx:key="index" bindtap="sendQuickMessage" data-text="{{item}}">{{item}}</view>
</view>

<view class="input-area">
  <view class="input-box">
    <image class="input-avatar" src="/images/icon-avatar.png"></image>
    <input class="message-input" type="text" placeholder="有什么想聊的吗？" value="{{inputValue}}" bindinput="onInput" bindconfirm="sendMessage" confirm-type="send" maxlength="500" cursor-spacing="12"/>
        <view class="send-btn" bindtap="sendMessage"><text class="send-icon">↑</text></view>
    <view class="voice-btn" bindtap="startVoice">
      <text class="mic-icon">🎤</text>
    </view>
  </view>
</view>

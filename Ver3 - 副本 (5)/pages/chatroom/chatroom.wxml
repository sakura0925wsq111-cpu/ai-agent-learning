<view class="status-bar" style="height: {{statusBarHeight}}px;"></view>

<view class="custom-nav">
  <view class="nav-left" bindtap="goBack"><text class="back-icon">‹</text></view>
  <view class="nav-title">{{agentName}}</view>
  <view class="nav-right nav-history" bindtap="goHistory">历史</view>
</view>

<scroll-view class="message-list" scroll-y scroll-into-view="{{scrollToView}}" enhanced show-scrollbar="{{false}}">
  <view class="message-item {{item.role}}" wx:for="{{messages}}" wx:key="id" id="msg-{{item.id}}">
    <block wx:if="{{item.role === 'assistant'}}">
      <image class="avatar ai-avatar" src="/images/icon-avatar.png"></image>
      <view class="message-bubble assistant">
        <text class="message-text">{{item.content}}</text>
        <text class="message-time">{{item.time}}</text>
      </view>
    </block>
    <block wx:elif="{{item.role === 'user'}}">
      <view class="message-bubble user">
        <text class="message-text">{{item.content}}</text>
        <text class="message-time user-time">{{item.time}}</text>
      </view>
      <view class="avatar user-avatar"><text>我</text></view>
    </block>
  </view>

  <view wx:if="{{progress > 0 && progress < 100}}" class="progress-wrap">
    <progress percent="{{progress}}" stroke-width="3" activeColor="#4A90D9" backgroundColor="#E8E8E8" border-radius="2" />
    <text class="progress-text">当前进度 {{progress}}%</text>
  </view>

  <view wx:if="{{isLoading}}" class="loading-item">
    <image class="loading-avatar" src="/images/icon-avatar.png"></image>
    <view class="loading-bubble">
      <view class="loading-dot"></view><view class="loading-dot"></view><view class="loading-dot"></view>
      <text class="loading-text">{{loadingText}}</text>
    </view>
  </view>

  <view wx:if="{{showRetry}}" class="retry-banner" bindtap="retryLastMessage">
    <text>操作未完成，点击重试</text>
  </view>
  <view id="bottom-anchor" class="bottom-anchor"></view>
</scroll-view>

<view wx:if="{{showAnalysisCard}}" class="analysis-card-section">
  <view class="analysis-card-header">
    <text class="analysis-card-icon">📋</text>
    <text class="analysis-card-title">初步分析已完成</text>
  </view>
  <text class="analysis-card-desc">请先确认方向。若有偏差，可修正后重新分析。</text>
  <view class="analysis-card-actions">
    <button class="analysis-btn correct-btn" bindtap="correctAnalysis">修正方向</button>
    <button class="analysis-btn approve-btn" bindtap="approveAnalysis">确认并生成报告</button>
  </view>
</view>

<view wx:if="{{reportReady}}" class="report-ready-card">
  <view>
    <text class="report-ready-title">规划报告已生成</text>
    <text class="report-ready-desc">查看完整目标、风险和分阶段行动路径</text>
  </view>
  <button class="report-ready-btn" bindtap="viewReport">查看报告</button>
</view>

<view wx:if="{{showCards && selectingPaths}}" class="cards-section">
  <view class="cards-title">选择你想对比的方向（可多选）</view>
  <view class="direction-card {{selectedPaths.indexOf(item.type) >= 0 ? 'card-selected' : ''}}" wx:for="{{cards}}" wx:key="type" style="border-color: {{item.color}}; background: {{item.bgColor}}" data-type="{{item.type}}" bindtap="togglePathCard">
    <view class="card-checkbox"><text>{{selectedPaths.indexOf(item.type) >= 0 ? '✓' : '○'}}</text></view>
    <view class="card-body">
      <view class="card-header"><text class="card-name">{{item.name}}</text><text class="card-score" style="color: {{item.color}}">{{item.time_label}}</text></view>
      <text class="card-insight">{{item.insight}}</text>
      <view class="card-meta"><text class="card-meta-item">风险：{{item.risk_label}}</text></view>
    </view>
  </view>
  <button class="confirm-path-btn" bindtap="confirmPathSelection" wx:if="{{selectedPaths.length > 0}}">开始对比（已选 {{selectedPaths.length}} 个）</button>
</view>

<view wx:if="{{showCards && !selectingPaths}}" class="cards-section">
  <view class="cards-title">选择一个方向，开始深度规划</view>
  <view class="direction-card {{item.recommended ? 'card-recommended' : ''}}" wx:for="{{cards}}" wx:key="type" style="border-color: {{item.recommended ? item.color : 'transparent'}}; background: {{item.bgColor}}" data-type="{{item.type}}" bindtap="selectDirection">
    <image class="card-icon-img" src="{{item.icon}}" mode="aspectFit"></image>
    <view class="card-body">
      <view class="card-header"><text class="card-name">{{item.name}}</text><text class="card-score" style="color: {{item.color}}">{{item.match_score}}% 匹配</text></view>
      <text class="card-insight">{{item.insight}}</text>
      <view class="card-meta"><text class="card-meta-item">{{item.time_label}}</text><text class="card-meta-item">风险：{{item.risk_label}}</text></view>
    </view>
    <text class="card-arrow" style="color: {{item.color}}">→</text>
  </view>
</view>

<view class="quick-actions" wx:if="{{showQuickActions}}">
  <view class="quick-tag" wx:for="{{quickOptions}}" wx:key="index" bindtap="sendQuickMessage" data-text="{{item}}">{{item}}</view>
</view>

<view class="input-area">
  <view class="input-box">
    <image class="input-avatar" src="/images/icon-avatar.png"></image>
    <input class="message-input" type="text" placeholder="{{inputPlaceholder}}" value="{{inputValue}}" bindinput="onInput" bindconfirm="sendMessage" confirm-type="send" maxlength="500" cursor-spacing="12" disabled="{{isLoading}}" />
    <view class="send-btn {{!inputValue || isLoading ? 'send-disabled' : ''}}" bindtap="sendMessage"><text class="send-icon">↑</text></view>
  </view>
</view>

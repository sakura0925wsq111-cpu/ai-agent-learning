<view class="status-bar" style="height: {{statusBarHeight}}px;"></view>

<view class="custom-nav">
  <view class="nav-left" bindtap="goBack">
    <text class="back-icon">&lt;</text>
  </view>
  <view class="nav-title">历史记录</view>
  <view class="nav-right">
    <view class="filter-btn" bindtap="showFilter">
      <text>{{currentFilter}}</text>
      <text class="filter-arrow">▼</text>
    </view>
  </view>
</view>

<view class="tab-bar">
  <view class="tab-item {{currentTab === 'plan' ? 'active' : ''}}" data-tab="plan" bindtap="switchTab">
    <text>规划历史</text>
    <view class="tab-line" wx:if="{{currentTab === 'plan'}}"></view>
  </view>
  <view class="tab-item {{currentTab === 'chat' ? 'active' : ''}}" data-tab="chat" bindtap="switchTab">
    <text>对话历史</text>
    <view class="tab-line" wx:if="{{currentTab === 'chat'}}"></view>
  </view>
</view>

<scroll-view class="history-container" scroll-y enhanced show-scrollbar="{{false}}">
  <view class="state-panel" wx:if="{{loading}}">
    <text class="state-title">正在加载历史记录...</text>
  </view>

  <view class="state-panel" wx:elif="{{error}}">
    <text class="state-title">历史记录加载失败</text>
    <text class="state-desc">请检查网络后重试</text>
    <button class="state-button" bindtap="loadData">重新加载</button>
  </view>
  
  <view class="history-list" wx:if="{{!loading && !error && currentTab === 'plan'}}">
    <view class="history-card" wx:for="{{planHistory}}" wx:key="session_id" data-id="{{item.session_id}}" data-type="{{item.agent_type}}" bindtap="viewPlanDetail">
      <view class="history-header">
        <view class="history-type-tag" style="background: {{item.color}}20; color: {{item.color}}">{{item.typeName}}</view>
        <text class="history-status {{item.status}}">{{item.statusText}}</text>
      </view>
      <text class="history-title">{{item.title}}</text>
      <text class="history-desc">{{item.summary}}</text>
      <view class="history-footer">
        <text class="history-date">{{item.displayTime}}</text>
        <view class="history-arrow">→</view>
      </view>
    </view>
  </view>

  <view class="history-list" wx:if="{{!loading && !error && currentTab === 'chat'}}">
    <view class="history-card chat-card" wx:for="{{chatHistory}}" wx:key="session_id" data-id="{{item.session_id}}" data-agent="{{item.agent}}" bindtap="viewChatDetail">
      <view class="chat-header">
        <image class="chat-avatar" src="/images/icon-avatar.png"></image>
        <view class="chat-info">
          <text class="chat-title">{{item.title}}</text>
          <text class="chat-date">{{item.displayTime}}</text>
        </view>
        <view class="chat-count">{{item.message_count}}条消息</view>
      </view>
      <text class="chat-preview">{{item.last_message}}</text>
    </view>
  </view>

  <view class="empty-state" wx:if="{{!loading && !error && currentTab === 'plan' && planHistory.length === 0}}">
    <text class="empty-icon-text">📋</text>
    <text class="empty-title">暂无规划记录</text>
    <text class="empty-desc">完成一次规划后，记录会出现在这里</text>
    <button class="empty-button" bindtap="startGrowth">开始成长规划</button>
  </view>

  <view class="empty-state" wx:if="{{!loading && !error && currentTab === 'chat' && chatHistory.length === 0}}">
    <text class="empty-icon-text">💬</text>
    <text class="empty-title">暂无对话记录</text>
    <text class="empty-desc">和 AI 聊聊后，对话会保存在这里</text>
    <button class="empty-button" bindtap="startGrowth">开始对话</button>
  </view>

  <view style="height: 48rpx;"></view>
</scroll-view>

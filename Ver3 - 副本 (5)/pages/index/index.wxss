/* ========== Base Variables ========== */
page {
  --primary: #4A90D9;
  --primary-light: #EBF5FF;
  --text-primary: #1A1A1A;
  --text-secondary: #666666;
  --text-tertiary: #999999;
  --bg: #F5F7FA;
  --card-bg: #FFFFFF;
  --card-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.06);
  --success: #4A90D9;
  --warning: #F39C12;

  background: var(--bg);
  font-family: -apple-system, BlinkMacSystemFont, "Microsoft YaHei", sans-serif;
  overflow-x: hidden;
  width: 100%;
  height: 100vh;
  display: flex;
  flex-direction: column;
}
/* ========== Fixed Header ========== */
.fixed-header { 
  flex-shrink: 0; 
  background: var(--bg); 
  padding: 0 32rpx; 
  width: 100%; 
  box-sizing: border-box; 
}
.status-bar { width: 100%; }
.brand-bar { display: flex; align-items: center; justify-content: space-between; height: 80rpx; width: 100%; margin-top: 8rpx; box-sizing: border-box; }
.brand-left { display: flex; align-items: center; }
.app-name { font-size: 48rpx; font-weight: 700; color: var(--text-primary); }
.brand-star { font-size: 24rpx; margin-left: 6rpx; }
.brand-right { width: 88rpx; height: 88rpx; display: flex; align-items: center; justify-content: center; background: #EAF3FC; border-radius: 50%; flex-shrink: 0; }
.chat-icon { font-size: 32rpx; }
.brand-subtitle { font-size: 24rpx; color: var(--text-tertiary); margin-bottom: 16rpx; margin-top: 4rpx; }
/* ========== Continue Banner（修改：适配fixed-header内部） ========== */
.continue-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: linear-gradient(135deg, #EBF5FF, #E6F2FF);
  border-radius: 20rpx;
  padding: 20rpx 28rpx;
  margin-bottom: 0;
  border: 2rpx solid #D6E9FF;
  width: 100%;
  box-sizing: border-box;
}
.continue-left { display: flex; align-items: center; }
.continue-dot { width: 16rpx; height: 16rpx; background: var(--primary); border-radius: 50%; margin-right: 16rpx; animation: pulse 2s infinite; }
@keyframes pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.4; } }
.continue-text { font-size: 26rpx; color: var(--primary); font-weight: 500; }
.continue-arrow { font-size: 24rpx; color: var(--primary); background: #fff; padding: 8rpx 20rpx; border-radius: 20rpx; font-weight: 500; }
/* ========== Scroll Content ========== */
.scroll-content { 
  flex: 1; 
  overflow-y: auto; 
  padding: 0 32rpx; 
  width: 100%; 
  box-sizing: border-box; 
}
.scroll-content::-webkit-scrollbar { display: none; }
/* ========== Welcome ========== */
.welcome-section { 
  display: flex; 
  justify-content: space-between; 
  align-items: center;
  margin-bottom: 20rpx;
  margin-top: 16rpx;
}
.welcome-text { flex: 1; min-width: 0; }
.greeting { font-size: 40rpx; font-weight: 700; color: var(--text-primary); line-height: 1.4; }
.sub-greeting { font-size: 26rpx; color: var(--text-secondary); margin-top: 12rpx; }
.mascot { width: 140rpx; height: 140rpx; flex-shrink: 0; margin-left: 16rpx; }
/* ========== Weather ========== */
.weather-card-wrapper { display: flex; justify-content: flex-start; margin-bottom: 0; }
.weather-card { display: flex; align-items: center; justify-content: space-between; background: var(--card-bg); border-radius: 24rpx; padding: 22rpx 28rpx; box-shadow: var(--card-shadow); width: 100%; min-height: 112rpx; box-sizing: border-box; }
.weather-left { display: flex; flex-direction: column; }
.weather-icon-temp { display: flex; align-items: center; margin-bottom: 12rpx; }
.weather-icon { font-size: 48rpx; margin-right: 16rpx; }
.weather-temp { font-size: 48rpx; font-weight: 700; color: var(--text-primary); margin-right: 16rpx; }
.weather-condition { font-size: 28rpx; color: var(--text-secondary); }
.weather-location-date { font-size: 26rpx; color: var(--text-secondary); margin-left: 64rpx; }
.weather-arrow { font-size: 32rpx; color: var(--text-tertiary); }
.weather-card-error { background: #FFF9F0; box-shadow: none; border: 2rpx solid #FCE3BE; }
.weather-error-copy { display: flex; flex-direction: column; gap: 6rpx; }
.weather-error-title { font-size: 28rpx; color: #6E4B16; font-weight: 500; }
.weather-error-hint { font-size: 24rpx; color: #A9792E; }
/* ========== Common Sections ========== */
.section { margin-top: 24rpx; width: 100%; }
.section-title { font-size: 30rpx; font-weight: 700; color: var(--text-primary); margin-bottom: 20rpx; }
/* ========== Today Overview ========== */
.overview-card { background: var(--card-bg); border-radius: 24rpx; padding: 24rpx; box-shadow: var(--card-shadow); width: 100%; box-sizing: border-box; }
.overview-card .section-title { margin-bottom: 24rpx; }
.overview-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8rpx; width: 100%; }
.overview-grid.has-inline-error { margin-top: 20rpx; }
.overview-item { display: flex; flex-direction: column; align-items: center; min-width: 0; position: relative; padding: 8rpx 0; transition: all 0.2s ease; }
.overview-item:not(.disabled):active { transform: scale(0.96); opacity: 0.9; }
.overview-icon-wrap { width: 96rpx; height: 96rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin-bottom: 16rpx; transition: all 0.3s ease; }
.overview-icon-img { width: 80rpx; height: 80rpx; transition: all 0.3s ease; }
.overview-num-wrap { display: flex; align-items: baseline; margin-bottom: 4rpx; min-height: 48rpx; }
.overview-num { font-size: 40rpx; font-weight: 700; color: #1A1A1A; line-height: 1; transition: all 0.3s ease; }
.overview-unit { font-size: 26rpx; color: #1A1A1A; margin-left: 4rpx; line-height: 1; }
.overview-suffix-text { font-size: 22rpx; color: #666666; margin-top: 2rpx; line-height: 1.4; text-align: center; max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; padding: 0 8rpx; }
.overview-label { font-size: 22rpx; color: #999999; margin-top: 4rpx; line-height: 1.4; text-align: center; }
/* 空状态整体 */
.overview-item.empty { opacity: 0.7; }
/* 空状态图标 */
.overview-icon-empty { opacity: 0.5; }
.overview-img-empty { opacity: 0.4; filter: grayscale(30%); }
/* 空状态数字区域 */
.overview-empty-num { display: flex; align-items: center; justify-content: center; min-height: 48rpx; margin: 8rpx 0 4rpx; }
.overview-num-empty { font-size: 24rpx; color: #BBBBBB; text-align: center; line-height: 1.3; }
/* 空状态标签 */
.overview-label-empty { color: #BBBBBB !important; }
/* 考试红色强调 */
.exam-num { color: #E74C3C !important; }
.semester-overview-picker { display: block; min-width: 0; width: 100%; }
.semester-overview-item { width: 100%; box-sizing: border-box; }
.semester-week-num { color: #7C5AC7; }
/* 禁用状态 */
.overview-item.disabled { opacity: 0.5; pointer-events: none; }
.overview-item.disabled .overview-num { color: #CCCCCC; }
.disabled-num { color: #CCCCCC !important; }
.inline-error { min-height: 120rpx; display: flex; align-items: center; justify-content: center; gap: 20rpx; border-radius: 16rpx; background: #F7F9FC; color: #666666; font-size: 26rpx; }
.inline-retry { color: var(--primary); font-weight: 500; }
.todo-inline-error { margin-top: 20rpx; }
/* ========== AI Suggestion ========== */
.ai-card-wrapper { background: var(--card-bg); border-radius: 24rpx; padding: 24rpx; box-shadow: var(--card-shadow); width: 100%; box-sizing: border-box; }
.ai-card-wrapper .section-title { margin-bottom: 20rpx; }
.ai-content-box { background: var(--primary-light); border-radius: 20rpx; padding: 24rpx; width: 100%; box-sizing: border-box; }
.ai-card { display: flex; width: 100%; box-sizing: border-box; }
.ai-icon-wrap { width: 80rpx; height: 80rpx; background: #E6F2FF; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin-right: 20rpx; flex-shrink: 0; }
.ai-icon-img { width: 48rpx; height: 48rpx; }
.ai-info { flex: 1; min-width: 0; display: flex; flex-direction: column; }
.ai-title { font-size: 28rpx; font-weight: 600; color: var(--text-primary); }
.ai-desc {
  font-size: 28rpx;
  color: #666666;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
  overflow: hidden;
  text-overflow: ellipsis;
}
.ai-action-btn { display: inline-flex; align-items: center; justify-content: center; background: #FFFFFF; border-radius: 28rpx; padding: 12rpx 28rpx; font-size: 24rpx; color: var(--primary); font-weight: 500; margin-top: 16rpx; }
/* ========== 骨架屏 ========== */
.skeleton-container {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--bg);
  z-index: 100;
}
.skeleton-scroll {
  padding: 0 32rpx;
  box-sizing: border-box;
}
.skeleton-welcome-section {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-top: 8rpx;
  margin-bottom: 24rpx;
  position: relative;
}
.skeleton-welcome-text {
  flex: 1;
  padding-top: 8rpx;
}
.skeleton-mascot {
  width: 200rpx;
  height: 200rpx;
  background: #E0E0E0;
  border-radius: 50%;
  position: absolute;
  right: 0;
  top: 0;
}
.skeleton-weather-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #E8E8E8;
  border-radius: 24rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 32rpx;
  width: 100%;
  box-sizing: border-box;
}
.skeleton-weather-left {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}
.skeleton-section {
  margin-top: 40rpx;
}
.skeleton-title {
  width: 140rpx;
  height: 36rpx;
  background: #E0E0E0;
  border-radius: 8rpx;
  margin-bottom: 20rpx;
}
.skeleton-overview-card {
  background: #E8E8E8;
  border-radius: 24rpx;
  padding: 24rpx;
}
.skeleton-overview-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 8rpx;
}
.skeleton-overview-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}
.skeleton-circle {
  width: 96rpx;
  height: 96rpx;
  background: #D0D0D0;
  border-radius: 50%;
  margin-bottom: 16rpx;
}
.skeleton-circle-sm {
  width: 48rpx;
  height: 48rpx;
  background: #D0D0D0;
  border-radius: 50%;
  flex-shrink: 0;
}
.skeleton-line-num {
  width: 60rpx;
  height: 40rpx;
  background: #D0D0D0;
  border-radius: 8rpx;
  margin-bottom: 8rpx;
}
.skeleton-line-label {
  width: 80rpx;
  height: 24rpx;
  background: #D0D0D0;
  border-radius: 8rpx;
}
.skeleton-ai-card {
  background: #E8E8E8;
  border-radius: 24rpx;
  padding: 24rpx;
}
.skeleton-ai-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.skeleton-ai-text {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}
.skeleton-todo-card {
  background: #E8E8E8;
  border-radius: 24rpx;
  padding: 24rpx;
}
.skeleton-todo-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 0;
  border-bottom: 2rpx solid #D8D8D8;
}
.skeleton-todo-item:last-child {
  border-bottom: none;
}
.skeleton-todo-text {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}
.skeleton-line-lg {
  width: 280rpx;
  height: 48rpx;
  background: #E0E0E0;
  border-radius: 8rpx;
  margin-bottom: 16rpx;
}
.skeleton-line-md {
  width: 200rpx;
  height: 32rpx;
  background: #D0D0D0;
  border-radius: 8rpx;
}
.skeleton-line-sm {
  width: 160rpx;
  height: 28rpx;
  background: #D0D0D0;
  border-radius: 8rpx;
}
.skeleton-line-xs {
  width: 120rpx;
  height: 24rpx;
  background: #D0D0D0;
  border-radius: 8rpx;
}
/* 骨架屏动画 */
.skeleton-container .skeleton-mascot,
.skeleton-container .skeleton-circle,
.skeleton-container .skeleton-circle-sm,
.skeleton-container .skeleton-line-lg,
.skeleton-container .skeleton-line-md,
.skeleton-container .skeleton-line-sm,
.skeleton-container .skeleton-line-xs,
.skeleton-container .skeleton-line-num,
.skeleton-container .skeleton-line-label,
.skeleton-container .skeleton-title,
.skeleton-container .skeleton-weather-card,
.skeleton-container .skeleton-overview-card,
.skeleton-container .skeleton-ai-card,
.skeleton-container .skeleton-todo-card {
  animation: skeleton-shimmer 1.5s infinite;
}
@keyframes skeleton-shimmer {
  0% { opacity: 1; }
  50% { opacity: 0.6; }
  100% { opacity: 1; }
}
/* ========== 错误态 ========== */
.error-container {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--bg);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}
.error-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 60rpx;
}
.error-icon {
  font-size: 120rpx;
  margin-bottom: 32rpx;
}
.error-title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 16rpx;
}
.error-desc {
  font-size: 28rpx;
  color: var(--text-secondary);
  text-align: center;
  margin-bottom: 48rpx;
  line-height: 1.6;
}
.retry-btn {
  background: var(--primary);
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 500;
  padding: 24rpx 80rpx;
  border-radius: 16rpx;
  border: none;
  line-height: 1.5;
}
.retry-btn:active {
  opacity: 0.8;
}
/* ========== 待办区域 ========== */
/* 外层 section 只负责间距，不再直接设置背景 */
.todo-section {
  margin-top: 40rpx;
  width: 100%;
  box-sizing: border-box;
}

/* 白色卡片容器 - 实际承载背景和圆角 */
.todo-card {
  background: var(--card-bg);
  border-radius: 24rpx;
  padding: 24rpx;
  box-shadow: var(--card-shadow);
  width: 100%;
  box-sizing: border-box;
}

/* 卡片头部 - 在卡片内部，不需要额外底部间距 */
.todo-card .section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 0; /* 移除多余的 margin，因为卡片已有 padding */
}
.todo-card .section-title { margin-bottom: 0; }

/* 修复：header-actions 布局 */
.header-actions {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.view-more {
  font-size: 26rpx;
  color: var(--text-secondary);
  min-height: 88rpx;
  display: flex;
  align-items: center;
  padding: 0 8rpx;
}

/* 修复+添加按钮颜色 */
.add-btn {
  font-size: 26rpx;
  color: var(--primary) !important;
  font-weight: 500;
  min-height: 88rpx;
  display: flex;
  align-items: center;
  padding: 0 8rpx;
}

.add-btn:active {
  opacity: 0.7;
}
/* 加载中 */
.todos-loading {
  display: flex;
  justify-content: center;
  padding: 60rpx 0;
}
.loading-dots {
  display: flex;
  gap: 12rpx;
}
.dot {
  width: 16rpx;
  height: 16rpx;
  background: var(--primary);
  border-radius: 50%;
  animation: dot-pulse 1.4s infinite ease-in-out both;
}
.dot:nth-child(1) { animation-delay: -0.32s; }
.dot:nth-child(2) { animation-delay: -0.16s; }
@keyframes dot-pulse {
  0%, 80%, 100% { transform: scale(0); opacity: 0.5; }
  40% { transform: scale(1); opacity: 1; }
}
/* 待办列表 */
.todo-list { 
  width: 100%; 
}
.todo-item { 
  display: flex; 
  align-items: flex-start; 
  padding: 24rpx 0; 
  border-bottom: 2rpx solid #F0F0F0;
  transition: all 0.3s ease;
  position: relative;
}
.todo-item:last-child { 
  border-bottom: none; 
}
/* 完成动画：淡出+右移 */
.todo-item.completing {
  opacity: 0;
  transform: translateX(100rpx);
}
/* AI计划高亮 */
.todo-item.ai-plan .todo-check {
  border-color: var(--warning);
}
.todo-item.ai-plan .todo-check.checked {
  background: var(--warning);
  border-color: var(--warning);
}
/* 勾选框 */
.todo-check-hit {
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  flex-shrink: 0;
  margin-right: 4rpx;
  margin-top: -16rpx;
}
.todo-check { 
  width: 44rpx; 
  height: 44rpx; 
  border-radius: 50%; 
  border: 4rpx solid #DDDDDD; 
  display: flex; 
  align-items: center; 
  justify-content: center; 
  margin-right: 0;
  flex-shrink: 0; 
  transition: all 0.3s ease;
  background: #FFFFFF;
}
.todo-check.checked { 
  background: var(--success); 
  border-color: var(--success); 
}
.check-inner {
  display: flex;
  align-items: center;
  justify-content: center;
}
.check-mark {
  color: #FFFFFF;
  font-size: 24rpx;
  font-weight: 700;
}
/* 勾选动画 */
@keyframes check-bounce {
  0% { transform: scale(1); }
  50% { transform: scale(1.3); }
  100% { transform: scale(1); }
}
.todo-check.checked .check-inner {
  animation: check-bounce 0.3s ease;
}
.todo-content { 
  flex: 1; 
  min-width: 0; 
  transition: all 0.3s ease;
}
.todo-title-wrap {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
}
.todo-title { 
  font-size: 28rpx; 
  color: var(--text-primary); 
  line-height: 1.5;
  transition: all 0.3s ease;
}
/* AI计划标签 */
.todo-source-tag {
  font-size: 20rpx;
  color: #F39C12;
  background: #FFF7E6;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  flex-shrink: 0;
  line-height: 1.4;
}
.todo-time { 
  font-size: 22rpx; 
  color: var(--text-tertiary); 
  margin-top: 6rpx; 
  line-height: 1.4;
}
/* 完成状态：文字划线+变灰 */
.todo-content.done .todo-title {
  text-decoration: line-through;
  color: var(--text-tertiary);
}
.todo-content.done .todo-time {
  color: #CCCCCC;
}
/* 查看更多 */
.todo-more {
  text-align: center;
  padding: 24rpx 0 8rpx;
  font-size: 26rpx;
  color: var(--primary);
}
.todo-more:active {
  opacity: 0.7;
}
/* ========== 空状态 ========== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 0;
}
.empty-icon {
  font-size: 80rpx;
  margin-bottom: 16rpx;
  line-height: 1;
}
.empty-text {
  font-size: 28rpx;
  color: var(--text-secondary);
  margin-bottom: 12rpx;
}
.empty-hint {
  font-size: 24rpx;
  color: var(--text-tertiary);
}
.empty-hint:active {
  color: var(--primary);
}
/* ========== 全部完成状态 ========== */
.all-done-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 0;
}
.all-done-icon {
  font-size: 80rpx;
  margin-bottom: 16rpx;
  line-height: 1;
}
.all-done-text {
  font-size: 32rpx;
  color: var(--success);
  font-weight: 600;
}
/* 响应式微调 */
@media (max-width: 320px) {
  .overview-icon-wrap {
    width: 80rpx;
    height: 80rpx;
  }
  
  .overview-icon-img {
    width: 64rpx;
    height: 64rpx;
  }
  
  .overview-num {
    font-size: 36rpx;
  }
}

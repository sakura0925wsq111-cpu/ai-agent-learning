page {
  background: #F5F7FA;
  height: 100vh;
  font-family: -apple-system, BlinkMacSystemFont, '.萍方-简', 'Microsoft YaHei', sans-serif;
}

.container {
  height: 100vh;
  position: relative;
}

/* ========== 固定顶部 ========== */
.fixed-header {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background: #FFFFFF;
}

.status-bar {
  width: 100%;
}

.custom-nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  padding: 0 20rpx;
  box-sizing: border-box;
}

.nav-back {
  width: 80rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
}

.back-icon {
  font-size: 48rpx;
  color: #1A1A1A;
  font-weight: 300;
}

.nav-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #1A1A1A;
}

.nav-placeholder {
  width: 80rpx;
}

/* ========== 内容区域 ========== */
.content {
  height: 100vh;
  /* 移除 var()，改用固定值或确保 JS 设置 */
  padding-top: calc(44px + 88rpx);  /* 状态栏44px + 导航栏88rpx */
  box-sizing: border-box;
  background: #F5F7FA;
}

/* ========== 文件信息卡片 ========== */
.file-card {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 28rpx 24rpx;
  margin: 24rpx 32rpx;
}

.file-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.file-icon.pdf {
  background: #FFF1F0;
}

.file-icon.excel {
  background: #F6FFED;
}

.file-icon-text {
  font-size: 24rpx;
  font-weight: 700;
}

.file-icon.pdf .file-icon-text {
  color: #E74C3C;
}

.file-icon.excel .file-icon-text {
  color: #52C41A;
}

.file-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.file-name {
  font-size: 30rpx;
  color: #1A1A1A;
  font-weight: 500;
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.file-size {
  font-size: 24rpx;
  color: #999999;
  margin-top: 8rpx;
}

.file-replace {
  font-size: 26rpx;
  color: #4A90D9;
  padding: 8rpx 12rpx;
  flex-shrink: 0;
}

.file-replace:active {
  opacity: 0.7;
}

/* ========== 预览标题 ========== */
.preview-header {
  display: flex;
  align-items: baseline;
  padding: 32rpx 32rpx 20rpx;
}

.preview-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1A1A1A;
}

.preview-count {
  font-size: 26rpx;
  color: #999999;
  margin-left: 12rpx;
}

/* ========== 预览表格 ========== */
.preview-table {
  background: #FFFFFF;
  border-radius: 16rpx;
  margin: 0 32rpx;
  overflow: hidden;
}

.table-header {
  display: flex;
  padding: 24rpx 16rpx;
  background: #FAFAFA;
  border-bottom: 1rpx solid #F0F0F0;
}

.th {
  font-size: 26rpx;
  color: #666666;
  font-weight: 500;
  text-align: center;
}

.table-body {
  display: flex;
  flex-direction: column;
}

.table-row {
  display: flex;
  padding: 28rpx 16rpx;
  border-bottom: 1rpx solid #F5F5F5;
}

.table-row:last-child {
  border-bottom: none;
}

.td {
  font-size: 26rpx;
  color: #333333;
  text-align: center;
  line-height: 1.4;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* ========== 提示信息 ========== */
.tips {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx 32rpx 48rpx;  /* 增加底部padding */
}

.tips-icon {
  font-size: 28rpx;
  color: #CCCCCC;
  margin-right: 8rpx;
}

.tips-text {
  font-size: 24rpx;
  color: #999999;
}

/* ========== 底部固定栏 ========== */
.footer-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: #FFFFFF;
  border-top: 1rpx solid #F0F0F0;
  z-index: 100;
}

.confirm-btn {
  width: 100%;
  height: 88rpx;
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 500;
  transition: all 0.2s ease;
}

.confirm-btn.active {
  background: #4A90D9;
  color: #FFFFFF;
  box-shadow: 0 8rpx 24rpx rgba(74, 144, 217, 0.3);
}

.confirm-btn.active:active {
  transform: scale(0.98);
  opacity: 0.9;
}

.btn-text {
  font-size: 32rpx;
}

/* ========== 底部安全区域 ========== */
.bottom-safe {
  height: 180rpx;  /* 增加高度，确保提示文字不被按钮遮挡 */
}

/* loading 状态 */
.confirm-btn.loading {
  background: #7AB8E8;
  pointer-events: none;  /* 禁止点击 */
}

.btn-text {
  font-size: 32rpx;
}

/* 按钮内 loading 动画 */
.btn-loading {
  display: flex;
  gap: 12rpx;
  align-items: center;
  justify-content: center;
}

.btn-loading .loading-dot {
  width: 16rpx;
  height: 16rpx;
  background: #FFFFFF;
  border-radius: 50%;
  animation: btn-dot-pulse 1.4s infinite ease-in-out both;
}

.btn-loading .loading-dot:nth-child(1) { animation-delay: -0.32s; }
.btn-loading .loading-dot:nth-child(2) { animation-delay: -0.16s; }

@keyframes btn-dot-pulse {
  0%, 80%, 100% { transform: scale(0.6); opacity: 0.5; }
  40% { transform: scale(1); opacity: 1; }
}
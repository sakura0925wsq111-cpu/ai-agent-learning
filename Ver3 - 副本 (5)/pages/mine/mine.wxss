/* pages/mine/mine.wxss */
page {
  background: #F5F7FA;
  height: 100vh;
  display: flex;
  flex-direction: column;
  font-family: -apple-system, BlinkMacSystemFont, 'Microsoft YaHei', sans-serif;
}

.status-bar { 
  background: #FFFFFF; 
  flex-shrink: 0; 
}

.custom-nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  padding: 0 24rpx;
  background: #FFFFFF;
  flex-shrink: 0;
}

.back-icon { 
  font-size: 48rpx; 
  color: #1A1A1A; 
  padding: 0 16rpx; 
}

.nav-title { 
  font-size: 34rpx; 
  font-weight: 600; 
  color: #1A1A1A; 
}

.scroll-content { 
  flex: 1; 
  overflow-y: auto; 
  padding: 0 24rpx; 
}

.scroll-content::-webkit-scrollbar { 
  display: none; 
}

/* ========== 用户信息卡片 ========== */
.user-card {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #E8F4FD 0%, #F0F7FF 100%);
  border-radius: 24rpx;
  padding: 32rpx;
  margin-top: 16rpx;
  position: relative;
}

.user-avatar { 
  width: 120rpx; 
  height: 120rpx; 
  border-radius: 50%; 
  margin-right: 24rpx; 
  flex-shrink: 0;
}

.user-info {
  flex: 1;
  min-width: 0;
}

.user-name { 
  font-size: 40rpx; 
  font-weight: 700; 
  color: #1A1A1A; 
}

.user-school { 
  font-size: 26rpx; 
  color: #666666; 
  margin-top: 8rpx; 
}

.user-tags {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
}

.user-tag {
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.6);
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
}

.tag-icon {
  width: 24rpx;
  height: 24rpx;
  margin-right: 8rpx;
}

.tag-text {
  font-size: 22rpx;
  color: #666666;
}

.user-arrow {
  font-size: 32rpx;
  color: #CCCCCC;
  position: absolute;
  right: 24rpx;
  top: 50%;
  transform: translateY(-50%);
}

/* ========== 卡片通用样式 ========== */
.section-card { 
  background: #FFFFFF; 
  border-radius: 24rpx; 
  padding: 24rpx; 
  margin-top: 24rpx; 
}

.section-title { 
  font-size: 30rpx; 
  font-weight: 700; 
  color: #1A1A1A; 
  margin-bottom: 20rpx; 
}

/* ========== 列表项（带值）========== */
.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 0;
  border-bottom: 2rpx solid #F5F5F5;
}

.menu-item:last-child { 
  border-bottom: none; 
}

.menu-text { 
  font-size: 28rpx; 
  color: #1A1A1A; 
}

.menu-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.menu-value {
  font-size: 28rpx;
  color: #999999;
}

.menu-arrow { 
  font-size: 28rpx; 
  color: #CCCCCC; 
}

/* ========== 功能网格 ========== */
.function-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 24rpx;
  padding: 16rpx 0;
}

.function-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.function-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.icon-text {
  font-size: 40rpx;
}

.function-name {
  font-size: 24rpx;
  color: #666666;
}

/* ========== 底部安全区域 ========== */
.bottom-safe {
  height: 40rpx;
}

<!--pages/mine/mine.wxml-->
<view class="status-bar" style="height: {{statusBarHeight}}px;"></view>
<view class="custom-nav">
  <view class="nav-left" bindtap="goBack">
    <text class="back-icon">&lt;</text>
  </view>
  <view class="nav-title">我的</view>
</view>
<scroll-view class="scroll-content" scroll-y>
  <!-- 用户信息卡片 -->
  <view class="user-card">
    <image class="user-avatar" src="/images/mascot1.png" mode="aspectFit"></image>
    <view class="user-info">
      <view class="user-name">{{userInfo.name || '未登录'}}</view>
      <view class="user-school">{{userInfo.school}}</view>
      <view class="user-tags">
        <view class="user-tag">
          <image class="tag-icon" src="/images/icon-id.png" mode="aspectFit"></image>
          <text class="tag-text">学号</text>
        </view>
        <view class="user-tag">
          <image class="tag-icon" src="/images/icon-calendar.png" mode="aspectFit"></image>
          <text class="tag-text">已连续使用0天</text>
        </view>
      </view>
    </view>
    <text class="user-arrow">&gt;</text>
  </view>

  <!-- 个人信息 -->
  <view class="section-card">
    <view class="section-title">个人信息</view>
    <view class="menu-list">
      <!-- 新增：姓名 -->
      <view class="menu-item" bindtap="editInfo" data-field="name">
        <text class="menu-text">姓名</text>
        <view class="menu-right">
          <text class="menu-value">{{userInfo.name || '未填写'}}</text>
          <text class="menu-arrow">&gt;</text>
        </view>
      </view>
      <!-- 年级 -->
      <view class="menu-item" bindtap="editInfo" data-field="grade">
        <text class="menu-text">年级</text>
        <view class="menu-right">
          <text class="menu-value">{{userInfo.grade || '未填写'}}</text>
          <text class="menu-arrow">&gt;</text>
        </view>
      </view>
      <!-- 新增：学院 -->
      <view class="menu-item" bindtap="editInfo" data-field="college">
        <text class="menu-text">学院</text>
        <view class="menu-right">
          <text class="menu-value">{{userInfo.college || '未填写'}}</text>
          <text class="menu-arrow">&gt;</text>
        </view>
      </view>
      <!-- 专业 -->
      <view class="menu-item" bindtap="editInfo" data-field="major">
        <text class="menu-text">专业</text>
        <view class="menu-right">
          <text class="menu-value">{{userInfo.major || '未填写'}}</text>
          <text class="menu-arrow">&gt;</text>
        </view>
      </view>
      <!-- 入学年份 -->
      <view class="menu-item" bindtap="editInfo" data-field="enrollYear">
        <text class="menu-text">入学年份</text>
        <view class="menu-right">
          <text class="menu-value">{{userInfo.enrollYear || '未填写'}}</text>
          <text class="menu-arrow">&gt;</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 我的功能 -->
  <view class="section-card">
    <view class="section-title">我的功能</view>
    <view class="function-grid">
      <view class="function-item" bindtap="goToMemory">
        <view class="function-icon" style="background: #E8F4FD;">
          <text class="icon-text">⭐</text>
        </view>
        <text class="function-name">我的记忆</text>
      </view>
      <view class="function-item" bindtap="goToTasks">
        <view class="function-icon" style="background: #FFF7E6;">
          <text class="icon-text">📋</text>
        </view>
        <text class="function-name">我的任务</text>
      </view>
      <view class="function-item" bindtap="goToMessages">
        <view class="function-icon" style="background: #E6F7E6;">
          <text class="icon-text">💬</text>
        </view>
        <text class="function-name">我的消息</text>
      </view>
      <view class="function-item" bindtap="goToSettings">
        <view class="function-icon" style="background: #F0E6FF;">
          <text class="icon-text">⚙️</text>
        </view>
        <text class="function-name">设置中心</text>
      </view>
    </view>
  </view>

  <!-- 关于我们 -->
  <view class="section-card">
    <view class="section-title">关于我们</view>
    <view class="menu-list">
      <view class="menu-item" bindtap="goToHelp">
        <text class="menu-text">帮助与反馈</text>
        <text class="menu-arrow">&gt;</text>
      </view>
      <view class="menu-item" bindtap="goToAbout">
        <text class="menu-text">关于 iCampus</text>
        <text class="menu-arrow">&gt;</text>
      </view>
    </view>
  </view>

  <!-- 底部留白 -->
  <view class="bottom-safe"></view>
</scroll-view>

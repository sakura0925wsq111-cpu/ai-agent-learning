page {
  background: #FFFFFF;
  height: 100vh;
}

.container {
  height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
}

.logout-loading {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.spinner {
  width: 80rpx;
  height: 80rpx;
  border: 6rpx solid #E8F4FD;
  border-top-color: #4A90D9;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-bottom: 40rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 36rpx;
  color: #1A1A1A;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.loading-sub {
  font-size: 26rpx;
  color: #999999;
}

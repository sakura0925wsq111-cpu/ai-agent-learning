page {
  background: #F5F7FA;
  font-family: -apple-system, BlinkMacSystemFont, '.萍方-简', 'Microsoft YaHei', sans-serif;
}

.status-bar {
  background: #FFFFFF;
}

.custom-nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  padding: 0 24rpx;
  background: #FFFFFF;
  flex-shrink: 0;
}

.back-icon {
  font-size: 48rpx;
  color: #1A1A1A;
  padding: 0 16rpx;
}

.nav-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #1A1A1A;
}

.more-icon {
  font-size: 40rpx;
  padding: 0 16rpx;
}

.memory-container {
  padding: 0 32rpx;
  height: calc(100vh - 88rpx - 44rpx);
  box-sizing: border-box;
  overflow-x: hidden;
}

/* 记忆摘要 */
.memory-summary {
  background: linear-gradient(135deg, #667EEA 0%, #764BA2 100%);
  border-radius: 24rpx;
  padding: 32rpx;
  margin-top: 24rpx;
  color: #FFFFFF;
}

.summary-header {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.summary-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  background: rgba(255,255,255,0.2);
}

.summary-title {
  font-size: 32rpx;
  font-weight: 600;
  display: block;
}

.summary-count {
  font-size: 24rpx;
  opacity: 0.8;
  margin-top: 4rpx;
  display: block;
}

.summary-stats {
  display: flex;
  gap: 32rpx;
  margin-top: 12rpx;
}

.stat-item {
  font-size: 26rpx;
  color: #4A90D9;
  background: #EBF5FF;
  padding: 6rpx 20rpx;
  border-radius: 20rpx;
}

.summary-desc {
  font-size: 26rpx;
  opacity: 0.9;
  line-height: 1.5;
}

/* 记忆列表 */
.memory-list {
  margin-top: 24rpx;
}

.memory-item {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 16rpx;
  position: relative;
}

.memory-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.memory-tag {
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  font-weight: 500;
}

.memory-time {
  font-size: 22rpx;
  color: #999999;
}

.memory-key {
  font-size: 28rpx;
  color: #666666;
  display: block;
  margin-bottom: 8rpx;
}

.memory-value {
  font-size: 32rpx;
  color: #1A1A1A;
  font-weight: 500;
  display: block;
  word-break: break-all;
}

.memory-edit-hint {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 2rpx solid #F0F0F0;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.edit-icon {
  font-size: 24rpx;
  color: #999999;
}

.memory-edit-hint text:last-child {
  font-size: 22rpx;
  color: #999999;
}

/* 添加记忆按钮 */
.add-memory-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  margin-top: 32rpx;
  padding: 28rpx;
  background: #FFFFFF;
  border-radius: 20rpx;
  border: 2rpx dashed #CCCCCC;
}

.add-icon {
  font-size: 32rpx;
  color: #667EEA;
}

.add-memory-btn text:last-child {
  font-size: 28rpx;
  color: #667EEA;
  font-weight: 500;
}
page {
  background: #F5F7FA;
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow-x: hidden;
  font-family: -apple-system, BlinkMacSystemFont, '.萍方-简', 'Microsoft YaHei', sans-serif;
}

/* ========== 固定顶部 ========== */
.fixed-header {
  flex-shrink: 0;
  background: #FFFFFF;
  width: 100%;
}

.status-bar {
  width: 100%;
}

.custom-nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  padding: 0 20rpx;
  width: 100%;
  box-sizing: border-box;
}

.back-icon {
  font-size: 48rpx;
  color: #1A1A1A;
  padding: 0 16rpx;
}

.nav-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #1A1A1A;
}

.more-icon {
  font-size: 40rpx;
  padding: 0 16rpx;
}

/* ========== 可滚动内容 ========== */
.scroll-content {
  flex: 1;
  overflow-y: auto;
  padding: 0 24rpx;
  width: 100%;
  box-sizing: border-box;
}

.scroll-content::-webkit-scrollbar {
  display: none;
}

/* ========== 日期选择区 ========== */
.date-section {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 32rpx 20rpx;
  margin-top: 24rpx;
  width: 100%;
  box-sizing: border-box;
}

.date-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.date-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1A1A1A;
}

.date-picker {
  font-size: 28rpx;
  color: #666666;
  display: flex;
  align-items: center;
}

.month-nav {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.month-nav-btn {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #4A90D9;
  background: #F2F7FC;
  font-size: 36rpx;
  line-height: 1;
}

.month-nav-btn:active {
  background: #E2EEF9;
}

.dropdown {
  margin-left: 8rpx;
  font-size: 24rpx;
}

/* 星期标题 */
.week-row-header {
  display: flex;
  justify-content: space-around;
  margin-bottom: 16rpx;
}

.week-header-item {
  width: 80rpx;
  text-align: center;
}

.week-header-text {
  font-size: 24rpx;
  color: #999999;
}

/* 日历网格 */
.calendar-grid {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 8rpx 0;
}

.week-view {
  gap: 8rpx 0;
}

/* 日期格子 */
.day-cell {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100rpx;
  width: 100%;
  max-width: 100rpx;
  margin: 0 auto;
  border-radius: 16rpx;
  position: relative;
  transition: all 0.2s ease;
}

.day-cell:active {
  background: #F0F0F0;
}

/* 非当月 */
.day-cell.other-month .day-num {
  color: #CCCCCC;
}

/* 今天 */
.day-cell.today {
  background: #4A90D9;
}

.day-cell.today .day-num {
  color: #FFFFFF;
  font-weight: 700;
}

/* 选中日 */
.day-cell.selected:not(.today) {
  background: #E8F4FD;
}

/* 周末 */
.day-cell.weekend {
  background: #F8F8F8;
}

.day-cell.weekend.other-month {
  background: transparent;
}

/* 日期数字 */
.day-num {
  font-size: 28rpx;
  color: #666666;
  line-height: 1;
  margin-bottom: 8rpx;
}

/* 事件圆点 */
.day-dots {
  display: flex;
  gap: 6rpx;
  align-items: center;
  justify-content: center;
  height: 12rpx;
}

.dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
}

.dot-course {
  background: #4A90D9;
}

.dot-exam {
  background: #E74C3C;
}

.dot-todo {
  background: #8E8E93;
}

.dot-ai_plan {
  background: #F39C12;
}

/* 操作栏 */
.calendar-actions {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 40rpx;
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 2rpx solid #F0F0F0;
}

.action-btn {
  padding: 12rpx 24rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.action-icon {
  font-size: 32rpx;
  color: #666666;
  font-weight: 700;
}

.today-btn {
  font-size: 26rpx;
  color: #999999;
  background: #F5F5F5;
  padding: 12rpx 32rpx;
}

.today-btn.active {
  color: #FFFFFF;
  background: #4A90D9;
}

/* ========== 时间轴 ========== */
.timeline-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  margin-top: 24rpx;
  padding: 32rpx 24rpx;
  width: 100%;
  box-sizing: border-box;
}

.timeline-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.timeline-date {
  font-size: 30rpx;
  font-weight: 600;
  color: #1A1A1A;
}

.timeline-count {
  font-size: 26rpx;
  color: #999999;
}

/* 加载中 */
.timeline-loading {
  display: flex;
  justify-content: center;
  padding: 60rpx 0;
}

.loading-dots {
  display: flex;
  gap: 12rpx;
}

.loading-dots .dot {
  width: 16rpx;
  height: 16rpx;
  background: #4A90D9;
  border-radius: 50%;
  animation: dot-pulse 1.4s infinite ease-in-out both;
}

.loading-dots .dot:nth-child(1) { animation-delay: -0.32s; }
.loading-dots .dot:nth-child(2) { animation-delay: -0.16s; }

@keyframes dot-pulse {
  0%, 80%, 100% { transform: scale(0); opacity: 0.5; }
  40% { transform: scale(1); opacity: 1; }
}

/* 空状态 */
.timeline-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 16rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999999;
  margin-bottom: 12rpx;
}

.empty-hint {
  font-size: 24rpx;
  color: #CCCCCC;
}

/* 时间轴列表 */
.timeline-list {
  width: 100%;
  display: flex;
  flex-direction: column;
}

.timeline-item {
  display: flex;
  align-items: flex-start;
  position: relative;
}

.time {
  width: 100rpx;
  font-size: 26rpx;
  color: #999999;
  text-align: right;
  padding-right: 24rpx;
  flex-shrink: 0;
  padding-top: 4rpx;
  line-height: 32rpx;
}

.timeline-axis {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex-shrink: 0;
  width: 16rpx;
  position: relative;
  padding-top: 8rpx;
}

.timeline-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #4A90D9;
  flex-shrink: 0;
}

.timeline-line {
  width: 2rpx;
  height: 100%;
  min-height: 60rpx;
  background: #EEEEEE;
  flex: 1;
}

.event-main {
  flex: 1;
  padding-left: 24rpx;
  padding-bottom: 40rpx;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.timeline-item:last-child .event-main {
  padding-bottom: 0;
}

.event-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.event-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1A1A1A;
  line-height: 1.4;
  flex: 1;
  min-width: 0;
}

.event-status-wrap {
  flex-shrink: 0;
  margin-left: 16rpx;
  display: flex;
  align-items: center;
}

.status-badge {
  font-size: 24rpx;
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
  background: #F5F5F5;
  color: #999999;
}

.status-badge.active {
  background: #E8F4FD;
  color: #4A90D9;
}

.event-location {
  font-size: 26rpx;
  color: #999999;
  margin-top: 8rpx;
}

.event-tags {
  display: flex;
  gap: 12rpx;
  margin-top: 12rpx;
}

.tag {
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
}

.tag.todo {
  background: #E8F4FD;
  color: #4A90D9;
}

/* 事件类型颜色 */
.timeline-item.type-course .timeline-dot { background: #4A90D9; }
.timeline-item.type-course .event-title { color: #2B6CB0; }
.timeline-item.type-exam .timeline-dot { background: #E53E3E; }
.timeline-item.type-exam .event-title { color: #C53030; font-weight: bold; }
.timeline-item.type-todo .timeline-dot { background: #48BB78; }
.timeline-item.type-todo .event-title { color: #2F855A; }
.timeline-item.type-aiplan .timeline-dot { background: #9F7AEA; }
.timeline-item.type-aiplan .event-title { color: #6B46C1; }

/* ========== AI建议 ========== */
.ai-tip {
  background: #EBF5FF;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-top: 24rpx;
  width: 100%;
  box-sizing: border-box;
}

.ai-tip-header {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.ai-tip-icon {
  width: 40rpx;
  height: 40rpx;
  margin-right: 12rpx;
}

.ai-tip-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1A1A1A;
}

.ai-loading {
  display: flex;
  justify-content: center;
  padding: 20rpx 0;
}

.ai-loading-text {
  font-size: 28rpx;
  color: #999999;
}

.ai-error {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 0;
}

.ai-error-text {
  font-size: 28rpx;
  color: #999999;
  margin-bottom: 12rpx;
}

.ai-retry {
  font-size: 26rpx;
  color: #4A90D9;
}

.ai-tip-content {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
}

.ai-tip-text-full {
  flex: 1;
  font-size: 28rpx;
  color: #666666;
  line-height: 1.8;
  word-wrap: break-word;
  word-break: break-all;
}


/* AI计划标签 */
.tag.ai-plan {
  background: #FFF7E6;
  color: #F39C12;
}

/* 已结束状态 */
.status-badge.ended {
  background: #F0F0F0;
  color: #999999;
}

/* 时间轴空状态优化 */
.timeline-empty .empty-hint {
  font-size: 24rpx;
  color: #4A90D9;
  margin-top: 16rpx;
}

.timeline-empty .empty-hint:active {
  opacity: 0.7;
}

/* ========== FAB 悬浮按钮（卡片式菜单）========== */
.fab-container {
  position: fixed;
  right: 40rpx;
  bottom: 140rpx;
  z-index: 100;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

/* 遮罩层 */
.fab-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0);
  z-index: -1;
  animation: maskFadeIn 0.2s ease forwards;
}

@keyframes maskFadeIn {
  from { background: rgba(0, 0, 0, 0); }
  to { background: rgba(0, 0, 0, 0.5); }
}

/* 子菜单容器 */
.fab-menu {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  margin-bottom: 16rpx;
  margin-right: 0;
  opacity: 0;
  transform: translateY(20rpx) scale(0.95);
  pointer-events: none;
  transition: all 0.3s ease;
  transform-origin: bottom right;
}

.fab-container.open .fab-menu {
  opacity: 1;
  transform: translateY(0) scale(1);
  pointer-events: auto;
}

/* 白色大卡片 - 宽度自适应内容，去除右侧留白 */
.fab-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 16rpx 0;
  /* 宽度改为自适应内容，不再固定宽度 */
  width: auto;
  min-width: 280rpx;
  /* 最大宽度限制，防止过长 */
  max-width: 400rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.12);
  overflow: hidden;
}

/* 卡片项 - 去除右侧多余padding */
.fab-card-item {
  display: flex;
  align-items: center;
  /* 左侧保持28rpx，右侧减小到16rpx */
  padding: 20rpx 16rpx 20rpx 24rpx;
  transition: background 0.2s ease;
  /* 防止内容撑开 */
  white-space: nowrap;
}

.fab-card-item:active {
  background: #F5F7FA;
}

/* 图标容器 */
.fab-card-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  flex-shrink: 0;
  margin-right: 16rpx;
}

/* 标签文字 */
.fab-card-label {
  font-size: 30rpx;
  color: #1A1A1A;
  font-weight: 500;
  /* 防止文字被压缩 */
  flex-shrink: 0;
}

/* 分隔线 - 宽度与内容对齐 */
.fab-card-divider {
  height: 2rpx;
  background: #F0F0F0;
  /* 左侧与图标对齐，右侧到边缘 */
  margin: 0 16rpx 0 24rpx;
}

/* 主按钮 */
.fab-main {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #4A90D9;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(74, 144, 217, 0.4);
  transition: all 0.3s ease;
  position: relative;
  z-index: 2;
  /* 与卡片右对齐 */
  margin-right: 0;
}

.fab-main:active {
  transform: scale(0.95);
  opacity: 0.9;
}

.fab-icon {
  font-size: 48rpx;
  color: #FFFFFF;
  font-weight: 300;
  line-height: 1;
  transition: transform 0.3s ease;
  display: inline-block;
}

.fab-icon.rotate {
  transform: rotate(45deg);
}

/* 关闭动画 */
.fab-container:not(.open) .fab-card {
  transition-delay: 0ms;
}


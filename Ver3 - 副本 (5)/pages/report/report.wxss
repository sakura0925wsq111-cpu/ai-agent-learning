page {
  background: #F5F7FA;
  font-family: -apple-system, BlinkMacSystemFont, '.萍方-简', 'Microsoft YaHei', sans-serif;
}

.status-bar {
  background: #FFFFFF;
}

.custom-nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  padding: 0 24rpx;
  background: #FFFFFF;
  flex-shrink: 0;
}

.back-icon {
  font-size: 48rpx;
  color: #1A1A1A;
  padding: 0 16rpx;
}

.nav-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #1A1A1A;
}

.share-btn {
  padding: 16rpx;
}

.share-icon {
  font-size: 36rpx;
}

/* 只修改 report-container，其他不变 */
.report-container {
  padding: 0 32rpx;
  height: calc(100vh - 88rpx - 44rpx - 120rpx);
  width: 100%;
  box-sizing: border-box;
  overflow-x: hidden;
}

/* 报告头部 */
.report-header {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 40rpx 32rpx;
  margin-top: 24rpx;
  text-align: center;
}

.report-badge {
  display: inline-block;
  background: linear-gradient(135deg, #667EEA 0%, #764BA2 100%);
  color: #FFFFFF;
  font-size: 22rpx;
  padding: 8rpx 24rpx;
  border-radius: 8rpx;
  margin-bottom: 24rpx;
}

.report-title {
  font-size: 40rpx;
  font-weight: 600;
  color: #1A1A1A;
  display: block;
}

.report-date {
  font-size: 24rpx;
  color: #999999;
  margin-top: 12rpx;
  display: block;
}

.report-actions {
  display: flex;
  justify-content: center;
  gap: 32rpx;
  margin-top: 32rpx;
  padding-top: 32rpx;
  border-top: 2rpx solid #F0F0F0;
}

.action-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.action-icon {
  font-size: 40rpx;
}

.action-label {
  font-size: 24rpx;
  color: #666666;
}

/* 报告区块 */
.report-section {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 32rpx;
  margin-top: 24rpx;
}

.section-header {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.section-line {
  width: 6rpx;
  height: 32rpx;
  border-radius: 4rpx;
  margin-right: 16rpx;
}

.section-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #1A1A1A;
}

/* 摘要框 */
.summary-box {
  border-radius: 16rpx;
  padding: 24rpx;
}

.summary-text {
  font-size: 28rpx;
  color: #333333;
  line-height: 1.8;
}

/* 文本内容 */
.section-text {
  font-size: 28rpx;
  color: #333333;
  line-height: 1.8;
  display: block;
}

/* 列表 */
.list-item {
  display: flex;
  align-items: flex-start;
  margin-bottom: 16rpx;
}

.list-bullet {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  margin-right: 16rpx;
  margin-top: 14rpx;
  flex-shrink: 0;
}

.list-text {
  font-size: 28rpx;
  color: #333333;
  line-height: 1.6;
  flex: 1;
}

/* 时间线 */
.timeline {
  position: relative;
  padding-left: 24rpx;
}

.timeline::before {
  content: '';
  position: absolute;
  left: 7rpx;
  top: 16rpx;
  bottom: 16rpx;
  width: 2rpx;
  background: #E8E8E8;
}

.timeline-item {
  position: relative;
  padding-bottom: 32rpx;
}

.timeline-dot {
  position: absolute;
  left: -20rpx;
  top: 8rpx;
  width: 20rpx;
  height: 20rpx;
  background: #FFFFFF;
  border-radius: 50%;
  border: 4rpx solid;
}

.timeline-content {
  padding-left: 16rpx;
}

.timeline-time {
  font-size: 26rpx;
  font-weight: 500;
  color: #1A1A1A;
  display: block;
}

.timeline-desc {
  font-size: 26rpx;
  color: #666666;
  margin-top: 8rpx;
  line-height: 1.5;
  display: block;
}

/* 数据卡片 - 修复溢出 */
.stats-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
  width: 100%;
  box-sizing: border-box;
}

.stat-card {
  background: #F8F9FA;
  border-radius: 16rpx;
  padding: 24rpx 16rpx;
  text-align: center;
  min-width: 0;
  overflow: hidden;
}

.stat-value {
  font-size: 36rpx;
  font-weight: 600;
  display: block;
  word-break: break-all;
  line-height: 1.2;
}

.stat-label {
  font-size: 22rpx;
  color: #666666;
  margin-top: 8rpx;
  display: block;
  word-break: break-all;
  line-height: 1.3;
}

/* 底部 */
.report-footer {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 0;
}

.footer-logo {
  width: 48rpx;
  height: 48rpx;
  opacity: 0.5;
}

.footer-text {
  font-size: 22rpx;
  color: #BBBBBB;
  margin-top: 12rpx;
}

/* ========== 修改：底部固定栏（三按钮布局）========== */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #FFFFFF;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  display: flex;
  gap: 16rpx;
  box-shadow: 0 -4rpx 20rpx rgba(0,0,0,0.05);
}

.btn-secondary {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 80rpx;
  border-radius: 16rpx;
  background: #F5F5F5;
  color: #666666;
  font-size: 26rpx;
}

.btn-primary {
  flex: 1.5;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 80rpx;
  border-radius: 16rpx;
  background: linear-gradient(135deg, #667EEA 0%, #764BA2 100%);
  color: #FFFFFF;
  font-size: 26rpx;
  font-weight: 500;
}

/* 新增：同步按钮 */
.btn-sync {
  flex: 1.5;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 80rpx;
  border-radius: 16rpx;
  background: #4A90D9;
  color: #FFFFFF;
  font-size: 26rpx;
  font-weight: 500;
}

.btn-sync:active {
  opacity: 0.9;
}
/* ========== 修改结束 ========== */

/* ========== 新增：同步弹窗样式 ========== */
.sync-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
}

.sync-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  animation: fadeIn 0.2s ease;
}

.sync-content {
  position: relative;
  background: #FFFFFF;
  border-radius: 32rpx 32rpx 0 0;
  padding: 32rpx 0 calc(32rpx + env(safe-area-inset-bottom));
  animation: slideUp 0.3s ease;
  max-height: 70vh;
  display: flex;
  flex-direction: column;
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes slideUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

.sync-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 32rpx 24rpx;
  border-bottom: 2rpx solid #F0F0F0;
}

.sync-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1A1A1A;
}

.sync-close {
  font-size: 32rpx;
  color: #999999;
  padding: 8rpx;
}

.sync-body {
  padding: 24rpx 32rpx;
  flex: 1;
  overflow-y: auto;
}

.sync-desc {
  font-size: 26rpx;
  color: #666666;
  margin-bottom: 24rpx;
  display: block;
}

/* 阶段选项 */
.phase-option {
  display: flex;
  align-items: center;
  padding: 24rpx;
  border-radius: 16rpx;
  margin-bottom: 16rpx;
  background: #F8F9FA;
  transition: all 0.2s;
}

.phase-option:active {
  background: #F0F2F5;
}

.phase-option.selected {
  background: #E8F4FD;
  border: 2rpx solid #4A90D9;
}

.phase-option.disabled {
  opacity: 0.5;
  background: #F5F5F5;
}

.phase-radio {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  border: 4rpx solid #CCCCCC;
  margin-right: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.phase-option.selected .phase-radio {
  border-color: #4A90D9;
}

.radio-inner {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: #4A90D9;
}

.phase-info {
  flex: 1;
}

.phase-name {
  font-size: 30rpx;
  font-weight: 500;
  color: #1A1A1A;
  display: block;
}

.phase-count {
  font-size: 24rpx;
  color: #999999;
  margin-top: 4rpx;
  display: block;
}

.phase-synced-tag {
  font-size: 22rpx;
  color: #52C41A;
  background: #E6F9ED;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  flex-shrink: 0;
}

/* 弹窗底部按钮 */
.sync-footer {
  display: flex;
  gap: 24rpx;
  padding: 24rpx 32rpx 0;
  border-top: 2rpx solid #F0F0F0;
}

.sync-btn-cancel {
  flex: 1;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  background: #F5F5F5;
  color: #666666;
  font-size: 28rpx;
}

.sync-btn-confirm {
  flex: 2;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  background: #4A90D9;
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 500;
}

.sync-btn-confirm.disabled {
  background: #B0C4DE;
  color: #FFFFFF;
}

.sync-btn-confirm:active:not(.disabled) {
  opacity: 0.9;
}
/* ========== 新增结束 ========== */

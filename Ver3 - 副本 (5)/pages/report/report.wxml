<view class="status-bar" style="height: {{statusBarHeight}}px;"></view>

<view class="custom-nav">
  <view class="nav-left" bindtap="goBack"><text class="back-icon">‹</text></view>
  <view class="nav-title">规划报告</view>
  <view class="nav-right"><button class="share-btn" open-type="share"><text class="share-icon">↗</text></button></view>
</view>

<view class="report-state" wx:if="{{loading}}">
  <text class="report-state-title">正在加载规划报告...</text>
</view>
<view class="report-state" wx:elif="{{error}}">
  <text class="report-state-title">报告加载失败</text>
  <text class="report-state-desc">报告可能仍在生成，或当前网络不可用</text>
  <button class="report-retry-btn" bindtap="loadReport">重新加载</button>
</view>
<scroll-view class="report-container" wx:else scroll-y enhanced show-scrollbar="{{false}}">
  <view class="report-header">
    <view class="report-badge">AI 生成</view>
    <text class="report-title">{{reportTitle}}</text>
    <text class="report-date">生成于 {{createTime}}</text>
  </view>

  <view class="report-section">
    <view class="section-header">
      <view class="section-line" style="background: {{themeColor}}"></view>
      <text class="section-name">执行摘要</text>
    </view>
    <view class="summary-box" style="background: {{themeColor}}08"><text class="summary-text">{{summary}}</text></view>
  </view>

  <view class="report-section" wx:for="{{sections}}" wx:key="title">
    <view class="section-header">
      <view class="section-line" style="background: {{themeColor}}"></view>
      <text class="section-name">{{item.title}}</text>
    </view>
    <block wx:if="{{item.type === 'text'}}"><text class="section-text">{{item.content}}</text></block>
    <block wx:elif="{{item.type === 'list'}}">
      <view class="list-item" wx:for="{{item.items}}" wx:for-item="li" wx:key="*this">
        <view class="list-bullet" style="background: {{themeColor}}"></view><text class="list-text">{{li}}</text>
      </view>
    </block>
    <block wx:elif="{{item.type === 'timeline'}}">
      <view class="timeline">
        <view class="timeline-item" wx:for="{{item.events}}" wx:for-item="event" wx:key="time">
          <view class="timeline-dot" style="border-color: {{themeColor}}"></view>
          <view class="timeline-content"><text class="timeline-time">{{event.time}}</text><text class="timeline-desc">{{event.description}}</text></view>
        </view>
      </view>
    </block>
  </view>

  <view class="report-footer">
    <image class="footer-logo" src="/images/mascotsmall.png"></image>
    <text class="footer-text">本报告由 iCampus AI 生成，仅供参考</text>
  </view>
  <view class="report-safe-space"></view>
</scroll-view>

<view class="bottom-bar" wx:if="{{!loading && !error}}">
  <view class="btn-secondary" bindtap="continueCoach"><text>继续跟进</text></view>
  <view class="btn-primary" wx:if="{{planStarted}}" bindtap="viewTasks"><text>查看执行进度</text></view>
  <view class="btn-primary" wx:else bindtap="startExecution"><text>{{syncing ? '正在加入...' : '开始执行'}}</text></view>
</view>

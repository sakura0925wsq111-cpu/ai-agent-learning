<!-- 固定顶部区域 -->
<view class="fixed-header">
  <!-- 状态栏占位 -->
  <view class="status-bar" style="height: {{statusBarHeight}}px;"></view>
  
  <!-- 自定义导航栏 -->
  <view class="custom-nav">
    <view class="nav-left" bindtap="goBack">
      <text class="back-icon">‹</text>
    </view>
    <picker class="city-picker" mode="selector" range="{{cityOptions}}" bindchange="onCityChange">
      <view class="nav-title">{{city}} <text class="city-arrow">⌄</text></view>
    </picker>
    <view class="nav-right"></view>
  </view>
</view>

<view class="weather-state" wx:if="{{loading}}">
  <view class="weather-spinner"></view>
  <text>正在获取天气</text>
</view>

<view class="weather-state" wx:elif="{{hasError}}">
  <text class="error-icon">📡</text>
  <text class="error-title">天气加载失败</text>
  <text class="error-desc">{{errorMsg}}</text>
  <button class="retry-btn" bindtap="retryWeather">重新加载</button>
</view>

<!-- 天气内容区 -->
<view class="weather-content" wx:else>
  
  <!-- 温度显示 -->
  <view class="temp-section">
    <view class="temp-num">{{weather.temp}}</view>
    <view class="temp-unit">°C</view>
  </view>
  
  <!-- 天气状况 -->
  <view class="condition-section">
    <text class="condition-icon">{{weather.icon}}</text>
    <text class="condition-text">{{weather.condition}}</text>
  </view>
  
  <!-- 生活建议卡片 -->
  <view class="advice-card">
    <view class="advice-title">生活建议</view>
    <view class="advice-content">{{weather.advice}}</view>
  </view>
  
</view>

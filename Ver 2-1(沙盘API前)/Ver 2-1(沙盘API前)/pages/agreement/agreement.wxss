page { background: #F5F7FA; font-family: -apple-system, BlinkMacSystemFont, 'Microsoft YaHei', sans-serif; }
.status-bar { background: #FFFFFF; }
.nav-bar { display: flex; align-items: center; justify-content: space-between; height: 88rpx; padding: 0 24rpx; background: #FFFFFF; }
.nav-back { font-size: 30rpx; color: #4A90D9; }
.back-icon { padding: 0 8rpx; }
.nav-title { font-size: 34rpx; font-weight: 600; color: #1A1A1A; }
.nav-placeholder { width: 80rpx; }
.content { padding: 32rpx; height: calc(100vh - 88rpx - 44rpx); box-sizing: border-box; }
.text-block { background: #FFFFFF; border-radius: 20rpx; padding: 32rpx; }
.title { font-size: 36rpx; font-weight: 700; color: #1A1A1A; margin-bottom: 32rpx; text-align: center; }
.para { font-size: 28rpx; color: #444444; line-height: 1.8; margin-bottom: 24rpx; }
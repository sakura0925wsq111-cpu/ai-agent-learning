page {
  height: 100vh;
  background: linear-gradient(180deg, #F0F7FF 0%, #FFFFFF 100%);
  font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Text', 'PingFang SC', sans-serif;
}

.launch-page {
  display: flex;
  flex-direction: column;
  align-items: center;
  height: 100%;
  padding: 0 60rpx;
  box-sizing: border-box;
}

.logo-section {
  margin-top: 200rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.logo {
  width: 120rpx;
  height: 120rpx;
}

.app-name {
  font-size: 48rpx;
  font-weight: 700;
  color: #1A1A1A;
  margin-top: 24rpx;
}

.app-slogan {
  font-size: 28rpx;
  color: #999999;
  margin-top: 12rpx;
}

.mascot {
  width: 300rpx;
  height: 300rpx;
  margin-top: 60rpx;
}

.login-section {
  margin-top: auto;
  margin-bottom: 60rpx;
  width: 100%;
}

.login-btn, .enter-btn {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  background: #4A90D9;
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 48rpx;
  border: none;
}

.login-btn::after, .enter-btn::after {
  border: none;
}

.agreement {
  display: flex;
  align-items: center;
  margin-bottom: 40rpx;
  font-size: 24rpx;
}

.agree-check {
  transform: scale(0.8);
  margin-right: 8rpx;
}

.agree-text {
  color: #999999;
}

.agree-link {
  color: #4A90D9;
}

<view class="launch-page">
  <!-- Logo区域 -->
  <view class="logo-section">
    <image class="logo" src="/images/mascot.png" mode="aspectFit"></image>
    <view class="app-name">iCampus</view>
    <view class="app-slogan">你的校园AI伙伴</view>
  </view>
  
  <!-- 吉祥物 -->
  <image class="mascot" src="/images/mascot.png" mode="aspectFit"></image>
  
  <!-- 登录区域 -->
  <view class="login-section">
    <button 
      class="login-btn" 
      open-type="getPhoneNumber" 
      bind:getphonenumber="onGetPhoneNumber"
      wx:if="{{!isLoggedIn}}"
    >
      微信一键登录
    </button>
    
    <button 
      class="enter-btn" 
      bindtap="enterApp"
      wx:if="{{isLoggedIn}}"
    >
      进入校园
    </button>
  </view>
  
  <!-- 用户协议 -->
  <view class="agreement">
    <checkbox class="agree-check" checked="{{agreed}}" bindtap="toggleAgree"/>
    <text class="agree-text">我已阅读并同意</text>
    <text class="agree-link" bindtap="showAgreement">《用户协议》</text>
    <text class="agree-text">和</text>
    <text class="agree-link" bindtap="showPrivacy">《隐私政策》</text>
  </view>
</view>
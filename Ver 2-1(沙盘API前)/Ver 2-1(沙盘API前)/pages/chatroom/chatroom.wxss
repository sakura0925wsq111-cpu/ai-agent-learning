page {
  background: #F5F7FA;
  height: 100vh;
  display: flex;
  flex-direction: column;
  font-family: -apple-system, BlinkMacSystemFont, '.萍方-简', 'Microsoft YaHei', sans-serif;
}

.status-bar {
  background: #FFFFFF;
  flex-shrink: 0;
}

.custom-nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  padding: 0 24rpx;
  background: #FFFFFF;
  flex-shrink: 0;
}

.back-icon {
  font-size: 48rpx;
  color: #1A1A1A;
  padding: 0 16rpx;
}

.nav-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #1A1A1A;
}

.more-icon {
  font-size: 40rpx;
  padding: 0 16rpx;
}

/* 消息列表 */
.message-list {
  flex: 1;
  padding: 24rpx;
  overflow-y: auto;
  box-sizing: border-box;
  width: 100%;
}

/* 消息项 */
.message-item {
  display: flex;
  margin-bottom: 32rpx;
  align-items: flex-start;
  width: 100%;
  box-sizing: border-box;
}

.message-item.assistant {
  justify-content: flex-start;
}

.message-item.user {
  justify-content: flex-end;
}

/* 头像 */
.avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.ai-avatar {
  margin-right: 16rpx;
}

.user-avatar {
  margin-left: 16rpx;
  background: #4A90D9;
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
}

/* 气泡 */
.message-bubble {
  max-width: 70%;
  padding: 24rpx;
  border-radius: 24rpx;
  word-break: break-all;
  box-sizing: border-box;
}

.message-bubble.assistant {
  background: #FFFFFF;
  border-top-left-radius: 4rpx;
}

.message-bubble.user {
  background: #4A90D9;
  color: #FFFFFF;
  border-top-right-radius: 4rpx;
}

.message-text {
  font-size: 30rpx;
  line-height: 1.6;
}

/* 加载中 */
.loading-item {
  display: flex;
  align-items: flex-start;
  margin-bottom: 32rpx;
  width: 100%;
  box-sizing: border-box;
}

.loading-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.loading-bubble {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 32rpx 40rpx;
  display: flex;
  gap: 16rpx;
}

.loading-dot {
  width: 16rpx;
  height: 16rpx;
  background: #CCCCCC;
  border-radius: 50%;
  animation: bounce 1.4s ease-in-out infinite;
}

.loading-dot:nth-child(2) {
  animation-delay: 0.2s;
}

.loading-dot:nth-child(3) {
  animation-delay: 0.4s;
}

@keyframes bounce {
  0%, 80%, 100% { transform: scale(0.6); opacity: 0.5; }
  40% { transform: scale(1); opacity: 1; }
}

/* 快捷选项 */
.quick-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  padding: 0 24rpx 16rpx;
  flex-shrink: 0;
  width: 100%;
  box-sizing: border-box;
}

.quick-tag {
  background: #FFFFFF;
  color: #4A90D9;
  font-size: 26rpx;
  padding: 16rpx 32rpx;
  border-radius: 32rpx;
  border: 2rpx solid #E8F4FD;
  box-sizing: border-box;
}

/* 输入区 */
.input-area {
  background: #FFFFFF;
  padding: 16rpx 24rpx 32rpx;
  flex-shrink: 0;
  width: 100%;
  box-sizing: border-box;
}

.input-box {
  display: flex;
  align-items: center;
  background: #F5F5F5;
  border-radius: 48rpx;
  padding: 12rpx 16rpx;
  width: 100%;
  box-sizing: border-box;
}

.input-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.message-input {
  flex: 1;
  font-size: 30rpx;
  color: #1A1A1A;
  height: 64rpx;
  min-width: 0;
}

.voice-btn {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 8rpx;
  flex-shrink: 0;
}

.mic-icon {
  font-size: 36rpx;
}

/* 内联方向卡片 */
.cards-section {
  padding: 16rpx 24rpx;
  flex-shrink: 0;
  width: 100%;
  box-sizing: border-box;
}

.cards-title {
  font-size: 26rpx;
  color: #999999;
  margin-bottom: 16rpx;
  padding-left: 8rpx;
}

.direction-card {
  display: flex;
  align-items: center;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  border: 4rpx solid transparent;
  width: 100%;
  box-sizing: border-box;
}

.direction-card.card-recommended {
  position: relative;
}

.card-icon-img {
  width: 72rpx;
  height: 72rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.card-body {
  flex: 1;
  min-width: 0;
}

.card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.card-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1A1A1A;
}

.card-score {
  font-size: 24rpx;
  font-weight: 600;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  background: rgba(0,0,0,0.06);
}

.card-insight {
  font-size: 26rpx;
  color: #555555;
  line-height: 1.5;
  display: block;
  margin-bottom: 8rpx;
}

.card-meta {
  display: flex;
  gap: 24rpx;
}

.card-meta-item {
  font-size: 22rpx;
  color: #888888;
}

.card-arrow {
  font-size: 32rpx;
  margin-left: 12rpx;
  font-weight: 300;
  flex-shrink: 0;
}

/* 路径多选卡片 */
.card-checkbox {
  font-size: 36rpx;
  margin-right: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  height: 48rpx;
  flex-shrink: 0;
}

.card-selected {
  border-width: 3rpx !important;
  box-shadow: 0 0 12rpx rgba(74, 144, 217, 0.3);
}

.confirm-path-btn {
  margin-top: 24rpx;
  background: linear-gradient(135deg, #4A90D9, #7B68EE);
  color: #FFFFFF;
  border-radius: 24rpx;
  font-size: 28rpx;
  padding: 12rpx 0;
  text-align: center;
  width: 100%;
}

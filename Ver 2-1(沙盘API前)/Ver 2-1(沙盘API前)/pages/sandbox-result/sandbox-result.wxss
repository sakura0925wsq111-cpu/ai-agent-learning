page {
  background: #F5F7FA;
  font-family: -apple-system, BlinkMacSystemFont, '.萍方-简', 'Microsoft YaHei', sans-serif;
}

.status-bar {
  background: #FFFFFF;
}

.custom-nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  padding: 0 24rpx;
  background: #FFFFFF;
  flex-shrink: 0;
}

.back-icon {
  font-size: 48rpx;
  color: #1A1A1A;
  padding: 0 16rpx;
}

.nav-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #1A1A1A;
}

.more-icon {
  font-size: 40rpx;
  padding: 0 16rpx;
}

.result-container {
  padding: 0 32rpx;
  height: calc(100vh - 88rpx - 44rpx);
  width: 100%;
  box-sizing: border-box;   /* 新增 */
  overflow-x: hidden;        /* 新增 */
}


.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1A1A1A;
  margin: 40rpx 0 24rpx;
}

/* 总结卡片 */
.summary-card {
  background: linear-gradient(135deg, #667EEA 0%, #764BA2 100%);
  border-radius: 24rpx;
  padding: 32rpx;
  margin-top: 24rpx;
  color: #FFFFFF;
}

.summary-header {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.summary-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  background: rgba(255,255,255,0.2);
}

.summary-title {
  font-size: 32rpx;
  font-weight: 600;
  display: block;
}

.summary-subtitle {
  font-size: 24rpx;
  opacity: 0.8;
  margin-top: 4rpx;
  display: block;
}

.summary-text {
  font-size: 28rpx;
  line-height: 1.7;
  opacity: 0.95;
}

/* 关键洞察 */
.insight-list {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 16rpx 0;
}

.insight-item {
  display: flex;
  align-items: flex-start;
  padding: 20rpx 28rpx;
}

.insight-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  margin-top: 10rpx;
  flex-shrink: 0;
}

.insight-label {
  font-size: 26rpx;
  color: #666666;
  display: block;
}

.insight-value {
  font-size: 30rpx;
  color: #1A1A1A;
  font-weight: 500;
  margin-top: 6rpx;
  display: block;
}

/* 推荐卡片 */
.recommend-card {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 28rpx;
  position: relative;
  overflow: hidden;
}

.recommend-badge {
  position: absolute;
  top: 0;
  right: 0;
  padding: 8rpx 20rpx;
  border-bottom-left-radius: 20rpx;
  font-size: 22rpx;
  color: #FFFFFF;
  font-weight: 500;
}

.recommend-main {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.recommend-icon {
  width: 80rpx;
  height: 80rpx;
  margin-right: 24rpx;
}

.recommend-name {
  font-size: 34rpx;
  font-weight: 600;
  color: #1A1A1A;
  display: block;
}

.recommend-reason {
  font-size: 26rpx;
  color: #666666;
  margin-top: 8rpx;
  display: block;
}

.recommend-action {
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #667EEA 0%, #764BA2 100%);
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 500;
  padding: 24rpx;
  border-radius: 16rpx;
}

.action-arrow {
  margin-left: 12rpx;
}

/* 方向列表 */
.direction-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.direction-card {
  border-radius: 20rpx;
  padding: 28rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border: 4rpx solid transparent;
  width: 100%;           /* 新增 */
  box-sizing: border-box; /* 新增 */
}

.direction-card.recommended {
  position: relative;
}

.direction-main {
  display: flex;
  align-items: center;
  flex: 1;
}

.direction-icon {
  width: 64rpx;
  height: 64rpx;
  margin-right: 24rpx;
}

.direction-info {
  flex: 1;
}

.direction-name-wrap {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.direction-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1A1A1A;
}

.direction-match {
  font-size: 22rpx;
  font-weight: 500;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  background: rgba(0,0,0,0.05);
}

.direction-desc {
  font-size: 26rpx;
  color: #666666;
  margin-top: 8rpx;
  display: block;
}

.direction-arrow {
  font-size: 32rpx;
  margin-left: 16rpx;
}

/* 重新分析按钮 */
.reanalyze-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 40rpx;
  padding: 28rpx;
  color: #666666;
  font-size: 28rpx;
}

.reanalyze-icon {
  margin-right: 12rpx;
  font-size: 28rpx;
}

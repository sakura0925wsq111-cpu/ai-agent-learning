<!-- 状态栏占位 -->
<view class="status-bar" style="height: {{statusBarHeight}}px;"></view>

<!-- 自定义导航栏 -->
<view class="custom-nav">
  <view class="nav-left" bindtap="goBack">
    <text class="back-icon">‹</text>
  </view>
  <view class="nav-title">分析结果</view>
  <view class="nav-right">
    <text class="more-icon">⋯</text>
  </view>
</view>

<scroll-view class="result-container" scroll-y enhanced show-scrollbar="{{false}}">
  <!-- 顶部总结卡片 -->
  <view class="summary-card">
    <view class="summary-header">
      <image class="summary-avatar" src="/images/icon-avatar.png"></image>
      <view class="summary-title-wrap">
        <text class="summary-title">你的决策画像</text>
        <text class="summary-subtitle">基于 {{messageCount}} 轮对话生成</text>
      </view>
    </view>
    <view class="summary-content">
      <text class="summary-text">{{summary}}</text>
    </view>
  </view>

  <!-- 关键洞察 -->
  <view class="section-title">关键洞察</view>
  <view class="insight-list">
    <view class="insight-item" wx:for="{{insights}}" wx:key="index">
      <view class="insight-dot" style="background: {{item.color}}"></view>
      <view class="insight-content">
        <text class="insight-label">{{item.label}}</text>
        <text class="insight-value">{{item.value}}</text>
      </view>
    </view>
  </view>

  <!-- 方向推荐 -->
  <view class="section-title">推荐方向</view>
  <view 
    class="recommend-card" 
    wx:if="{{recommendation}}"
    bindtap="startRecommendedAgent"
  >
    <view class="recommend-badge" style="background: {{recommendation.color}}">
      最匹配
    </view>
    <view class="recommend-main">
      <image class="recommend-icon" src="{{recommendation.icon}}"></image>
      <view class="recommend-info">
        <text class="recommend-name">{{recommendation.name}}</text>
        <text class="recommend-reason">{{recommendation.reason}}</text>
      </view>
    </view>
    <view class="recommend-action">
      <text>开始规划</text>
      <text class="action-arrow">→</text>
    </view>
  </view>

  <!-- 所有可选方向 -->
  <view class="section-title">选择你的方向</view>
  <view class="direction-list">
    <view 
      class="direction-card {{item.recommended ? 'recommended' : ''}}"
      wx:for="{{directions}}"
      wx:key="type"
      style="border-color: {{item.recommended ? item.color : 'transparent'}}; background: {{item.bgColor}}"
      data-type="{{item.type}}"
      bindtap="selectDirection"
    >
      <view class="direction-main">
        <image class="direction-icon" src="{{item.icon}}"></image>
        <view class="direction-info">
          <view class="direction-name-wrap">
            <text class="direction-name">{{item.name}}</text>
            <view class="direction-match" wx:if="{{item.matchScore}}" style="color: {{item.color}}">
              {{item.matchScore}}% 匹配
            </view>
          </view>
          <text class="direction-desc">{{item.description}}</text>
        </view>
      </view>
      <view class="direction-arrow" style="color: {{item.color}}">→</view>
    </view>
  </view>

  <!-- 不满意？重新分析 -->
  <view class="reanalyze-btn" bindtap="reanalyze">
    <text class="reanalyze-icon">↻</text>
    <text>重新分析，纠正方向</text>
  </view>

  <!-- 底部安全区域 -->
  <view style="height: 48rpx;"></view>
</scroll-view>
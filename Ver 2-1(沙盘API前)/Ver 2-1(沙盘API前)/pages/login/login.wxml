<!-- 状态栏占位 -->
<view class="status-bar" style="height: {{statusBarHeight}}px;"></view>

<!-- 返回按钮 -->
<view class="nav-back" bindtap="goBack">
  <text class="back-icon">‹</text>
</view>

<!-- 主内容区 -->
<view class="login-content">
  
  <!-- 标题区 -->
  <view class="header-section">
    <view class="title">欢迎使用 iCampus</view>
    <view class="subtitle">登录账号，开启你的校园AI之旅</view>
  </view>
  
  <!-- 吉祥物 -->
  <image class="mascot" src="/images/mascot.png" mode="aspectFit"></image>
  
  <!-- 登录表单 -->
  <view class="form-section">
    <!-- 学号登录 -->
    <view class="input-group">
      <view class="input-icon">
      </view>
      <input 
        class="form-input" 
        placeholder="请输入学号"
        value="{{studentId}}"
        bindinput="onStudentIdInput"
      />
    </view>
    
    <!-- 密码 -->
    <view class="input-group">
      <view class="input-icon">
      </view>
      <input 
        class="form-input" 
        type="password"
        placeholder="请输入密码"
        value="{{password}}"
        bindinput="onPasswordInput"
      />
    </view>
    
    <!-- 登录按钮 -->
    <button class="submit-btn {{canLogin ? 'active' : ''}}" bindtap="doLogin">登录</button>
    
    <!-- 其他登录方式 -->
    <view class="divider">
      <view class="line"></view>
      <text class="divider-text">其他登录方式</text>
      <view class="line"></view>
    </view>
    
    <button class="wechat-btn" open-type="getPhoneNumber" bind:getphonenumber="onWechatLogin">
      <text>微信一键登录</text>
    </button>
  </view>
  
  <!-- 底部链接 -->
  <view class="bottom-links">
    <text class="link-text" bindtap="goRegister">还没有账号？</text>
    <text class="link-action" bindtap="goRegister">去注册</text>
  </view>
</view>
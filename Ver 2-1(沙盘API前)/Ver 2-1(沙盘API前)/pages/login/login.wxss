page {
  background: #FFFFFF;
  height: 100vh;
  font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Text', 'PingFang SC', sans-serif;
}

.status-bar {
  width: 100%;
}

.nav-back {
  padding: 20rpx 32rpx;
}

.back-icon {
  font-size: 48rpx;
  color: #1A1A1A;
}

.login-content {
  padding: 0 48rpx;
}

.header-section {
  margin-top: 40rpx;
}

.title {
  font-size: 44rpx;
  font-weight: 700;
  color: #1A1A1A;
}

.subtitle {
  font-size: 28rpx;
  color: #999999;
  margin-top: 16rpx;
}

.mascot {
  width: 200rpx;
  height: 200rpx;
  display: block;
  margin: 40rpx auto;
}

.form-section {
  margin-top: 60rpx;
}

.input-group {
  display: flex;
  align-items: center;
  background: #F8F9FA;
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 24rpx;
}

.input-icon {
  width: 40rpx;
  height: 40rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.input-icon image {
  width: 100%;
  height: 100%;
}

.form-input {
  flex: 1;
  font-size: 30rpx;
  color: #1A1A1A;
  min-width: 0;
}

.submit-btn {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  background: #FA8C16;  /* 直接橙色 */
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 48rpx;
  border: none;
  margin-top: 40rpx;
}

.submit-btn.active {
  background: #FA8C16;
}

.submit-btn::after {
  border: none;
}

.divider {
  display: flex;
  align-items: center;
  margin: 48rpx 0;
}

.line {
  flex: 1;
  height: 2rpx;
  background: #EEEEEE;
}

.divider-text {
  font-size: 24rpx;
  color: #999999;
  padding: 0 24rpx;
}

.wechat-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #F6F6F6;
  border-radius: 16rpx;
  height: 96rpx;
  border: none;
}

.wechat-btn::after {
  border: none;
}

.wechat-icon {
  width: 44rpx;
  height: 44rpx;
  margin-right: 12rpx;
}

.wechat-btn text {
  font-size: 30rpx;
  color: #1A1A1A;
}

.bottom-links {
  position: fixed;
  bottom: 60rpx;
  left: 0;
  right: 0;
  text-align: center;
}

.link-text {
  font-size: 28rpx;
  color: #999999;
}

.link-action {
  font-size: 28rpx;
  color: #FA8C16;
  margin-left: 8rpx;
}

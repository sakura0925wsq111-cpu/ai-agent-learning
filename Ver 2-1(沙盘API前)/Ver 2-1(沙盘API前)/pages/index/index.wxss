/* ========== Base Variables ========== */
page {
  --primary: #4A90D9;
  --primary-light: #EBF5FF;
  --text-primary: #1A1A1A;
  --text-secondary: #666666;
  --text-tertiary: #999999;
  --bg: #F5F7FA;
  --card-bg: #FFFFFF;
  --card-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.06);
  
  background: var(--bg);
  font-family: -apple-system, BlinkMacSystemFont, "Microsoft YaHei", sans-serif;
  overflow-x: hidden;
  width: 100%;
  height: 100vh;
  display: flex;
  flex-direction: column;
}

/* ========== Fixed Header ========== */
.fixed-header { flex-shrink: 0; background: var(--bg); padding: 0 32rpx; width: 100%; box-sizing: border-box; }
.status-bar { width: 100%; }
.brand-bar { display: flex; align-items: center; justify-content: space-between; height: 72rpx; width: 100%; margin-top: 8rpx; }
.brand-left { display: flex; align-items: center; }
.app-name { font-size: 48rpx; font-weight: 700; color: var(--text-primary); }
.brand-star { font-size: 24rpx; margin-left: 6rpx; }
.brand-right { width: 64rpx; height: 64rpx; display: flex; align-items: center; justify-content: center; background: #F5F5F5; border-radius: 50%; }
.chat-icon { font-size: 32rpx; }
.brand-subtitle { font-size: 24rpx; color: var(--text-tertiary); margin-bottom: 24rpx; margin-top: 4rpx; }

/* ========== Scroll Content ========== */
.scroll-content { flex: 1; overflow-y: auto; padding: 0 32rpx; width: 100%; box-sizing: border-box; }
.scroll-content::-webkit-scrollbar { display: none; }

/* ========== Welcome ========== */
.welcome-section { display: flex; justify-content: space-between; align-items: flex-start; position: relative; margin-bottom: 24rpx; margin-top: 8rpx; }
.welcome-text { flex: 1; min-width: 0; }
.greeting { font-size: 40rpx; font-weight: 700; color: var(--text-primary); line-height: 1.4; }
.sub-greeting { font-size: 26rpx; color: var(--text-secondary); margin-top: 12rpx; }
.mascot { width: 320rpx; height: 320rpx; position: absolute; right: -70rpx; top: -30rpx; }

/* ========== Continue Banner ========== */
.continue-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: linear-gradient(135deg, #EBF5FF, #E6F2FF);
  border-radius: 20rpx;
  padding: 20rpx 28rpx;
  margin-bottom: 24rpx;
  border: 2rpx solid #D6E9FF;
}
.continue-left { display: flex; align-items: center; }
.continue-dot { width: 16rpx; height: 16rpx; background: var(--primary); border-radius: 50%; margin-right: 16rpx; animation: pulse 2s infinite; }
@keyframes pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.4; } }
.continue-text { font-size: 26rpx; color: var(--primary); font-weight: 500; }
.continue-arrow { font-size: 24rpx; color: var(--primary); background: #fff; padding: 8rpx 20rpx; border-radius: 20rpx; font-weight: 500; }

/* ========== Weather ========== */
.weather-card-wrapper { display: flex; justify-content: flex-start; margin-bottom: 32rpx; }
.weather-card { display: flex; align-items: center; justify-content: space-between; background: var(--card-bg); border-radius: 24rpx; padding: 24rpx 28rpx; box-shadow: var(--card-shadow); width: 72%; box-sizing: border-box; }
.weather-left { display: flex; flex-direction: column; }
.weather-icon-temp { display: flex; align-items: center; margin-bottom: 12rpx; }
.weather-icon { font-size: 48rpx; margin-right: 16rpx; }
.weather-temp { font-size: 48rpx; font-weight: 700; color: var(--text-primary); margin-right: 16rpx; }
.weather-condition { font-size: 28rpx; color: var(--text-secondary); }
.weather-location-date { font-size: 26rpx; color: var(--text-secondary); margin-left: 64rpx; }
.weather-arrow { font-size: 32rpx; color: var(--text-tertiary); }

/* ========== Common Sections ========== */
.section { margin-top: 40rpx; width: 100%; }
.section-title { font-size: 30rpx; font-weight: 700; color: var(--text-primary); margin-bottom: 20rpx; }

/* ========== Today Overview ========== */
.overview-card { background: var(--card-bg); border-radius: 24rpx; padding: 24rpx; box-shadow: var(--card-shadow); width: 100%; box-sizing: border-box; }
.overview-card .section-title { margin-bottom: 24rpx; }
.overview-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16rpx; width: 100%; }
.overview-item { display: flex; flex-direction: column; align-items: center; min-width: 0; }
.overview-icon-wrap { width: 96rpx; height: 96rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin-bottom: 16rpx; }
.overview-icon-img { width: 80rpx; height: 80rpx; }
.overview-num-wrap { display: flex; align-items: baseline; margin-bottom: 4rpx; }
.overview-num { font-size: 40rpx; font-weight: 700; color: var(--text-primary); line-height: 1; }
.overview-unit { font-size: 26rpx; color: var(--text-primary); margin-left: 4rpx; line-height: 1; }
.overview-suffix-text { font-size: 22rpx; color: var(--text-tertiary); margin-top: 2rpx; line-height: 1.4; }
.overview-label { font-size: 22rpx; color: var(--text-tertiary); margin-top: 4rpx; line-height: 1.4; }

/* ========== AI Suggestion ========== */
.ai-card-wrapper { background: var(--card-bg); border-radius: 24rpx; padding: 24rpx; box-shadow: var(--card-shadow); width: 100%; box-sizing: border-box; }
.ai-card-wrapper .section-title { margin-bottom: 20rpx; }
.ai-content-box { background: var(--primary-light); border-radius: 20rpx; padding: 24rpx; width: 100%; box-sizing: border-box; }
.ai-card { display: flex; width: 100%; box-sizing: border-box; }
.ai-icon-wrap { width: 80rpx; height: 80rpx; background: #E6F2FF; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin-right: 20rpx; flex-shrink: 0; }
.ai-icon-img { width: 48rpx; height: 48rpx; }
.ai-info { flex: 1; min-width: 0; display: flex; flex-direction: column; }
.ai-title { font-size: 28rpx; font-weight: 600; color: var(--text-primary); }
.ai-desc { font-size: 24rpx; color: var(--text-secondary); margin-top: 10rpx; line-height: 1.5; }
.ai-action-btn { display: inline-flex; align-items: center; justify-content: center; background: #FFFFFF; border-radius: 28rpx; padding: 12rpx 28rpx; font-size: 24rpx; color: var(--primary); font-weight: 500; margin-top: 16rpx; }

/* ========== Todo ========== */
.todo-card { background: var(--card-bg); border-radius: 24rpx; padding: 24rpx; box-shadow: var(--card-shadow); width: 100%; box-sizing: border-box; }
.todo-card .section-title { margin-bottom: 8rpx; }
.todo-list { width: 100%; }
.todo-item { display: flex; align-items: center; padding: 28rpx 0; border-bottom: 2rpx solid #F0F0F0; }
.todo-item:last-child { border-bottom: none; }
.checkbox { width: 40rpx; height: 40rpx; border-radius: 50%; border: 4rpx solid #DDDDDD; display: flex; align-items: center; justify-content: center; margin-right: 20rpx; flex-shrink: 0; }
.checkbox.checked { background: var(--primary); border-color: var(--primary); color: white; font-size: 24rpx; }
.todo-content { flex: 1; min-width: 0; }
.todo-title { font-size: 28rpx; color: var(--text-primary); }
.todo-title.done { color: var(--text-tertiary); text-decoration: line-through; }
.todo-time { font-size: 22rpx; color: var(--text-tertiary); margin-top: 6rpx; }
.todo-content.done .todo-title {
  text-decoration: line-through;
  color: #999999;
}

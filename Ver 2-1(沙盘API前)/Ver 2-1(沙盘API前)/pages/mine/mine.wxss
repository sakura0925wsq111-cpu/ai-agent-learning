/* pages/mine/mine.wxss */
page {
  background: #F5F7FA;
  height: 100vh;
  display: flex;
  flex-direction: column;
  font-family: -apple-system, BlinkMacSystemFont, 'Microsoft YaHei', sans-serif;
}
.status-bar { background: #FFFFFF; flex-shrink: 0; }
.custom-nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  padding: 0 24rpx;
  background: #FFFFFF;
  flex-shrink: 0;
}
.back-icon { font-size: 48rpx; color: #1A1A1A; padding: 0 16rpx; }
.nav-title { font-size: 34rpx; font-weight: 600; color: #1A1A1A; }
.scroll-content { flex: 1; overflow-y: auto; padding: 0 24rpx; }
.scroll-content::-webkit-scrollbar { display: none; }
.user-card {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #E8F4FD 0%, #F0F7FF 100%);
  border-radius: 24rpx;
  padding: 32rpx;
  margin-top: 16rpx;
}
.user-avatar { width: 120rpx; height: 120rpx; border-radius: 50%; margin-right: 24rpx; }
.user-name { font-size: 40rpx; font-weight: 700; color: #1A1A1A; }
.user-school { font-size: 26rpx; color: #666666; margin-top: 8rpx; }
.section-card { background: #FFFFFF; border-radius: 24rpx; padding: 24rpx; margin-top: 24rpx; }
.section-title { font-size: 30rpx; font-weight: 700; color: #1A1A1A; margin-bottom: 20rpx; }
.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 2rpx solid #F5F5F5;
}
.menu-item:last-child { border-bottom: none; }
.menu-text { font-size: 28rpx; color: #1A1A1A; }
.menu-arrow { font-size: 28rpx; color: #CCCCCC; }

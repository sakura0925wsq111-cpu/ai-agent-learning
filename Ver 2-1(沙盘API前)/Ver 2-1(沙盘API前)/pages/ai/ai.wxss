page {
  background: #F5F7FA;
  font-family: -apple-system, BlinkMacSystemFont, '.萍方-简', 'Microsoft YaHei', sans-serif;
}

.status-bar {
  background: #FFFFFF;
}

.custom-nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  padding: 0 24rpx;
  background: #FFFFFF;
}

.back-icon {
  font-size: 48rpx;
  color: #1A1A1A;
  padding: 0 16rpx;
}

.nav-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #1A1A1A;
}

.history-icon {
  font-size: 40rpx;
  padding: 0 16rpx;
}

/* 主内容 */
.ai-content {
  padding: 32rpx 24rpx;
}

.ai-header {
  text-align: center;
  margin-bottom: 24rpx;
}

.ai-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #1A1A1A;
}

.ai-subtitle {
  font-size: 28rpx;
  color: #999999;
  margin-top: 12rpx;
}

/* IP形象 */
.mascot-wrap {
  display: flex;
  justify-content: center;
  margin: 16rpx 0;
}

.mascot {
  width: 240rpx;
  height: 240rpx;
}

/* 模式卡片 */
.mode-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.mode-card {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.06);
}

.mode-icon-wrap {
  width: 88rpx;
  height: 88rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.mode-icon {
  font-size: 48rpx;
}

.mode-info {
  flex: 1;
  min-width: 0;
}

.mode-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #1A1A1A;
}

.mode-desc {
  font-size: 26rpx;
  color: #666666;
  margin-top: 8rpx;
}

.mode-detail {
  font-size: 24rpx;
  color: #999999;
  margin-top: 8rpx;
}

.mode-arrow {
  font-size: 36rpx;
  color: #CCCCCC;
  margin-left: 16rpx;
}

page {
  background: #F5F7FA;
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow-x: hidden;
  font-family: -apple-system, BlinkMacSystemFont, '.萍方-简', 'Microsoft YaHei', sans-serif;
}

/* 固定顶部区域 */
.fixed-header {
  flex-shrink: 0;
  background: #FFFFFF;
  width: 100%;
}

.status-bar {
  width: 100%;
}

.custom-nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  padding: 0 20rpx;
  width: 100%;
  box-sizing: border-box;
}

.back-icon {
  font-size: 48rpx;
  color: #1A1A1A;
  padding: 0 16rpx;
}

.nav-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #1A1A1A;
}

.more-icon {
  font-size: 40rpx;
  padding: 0 16rpx;
}

/* 可滚动内容区 */
.scroll-content {
  flex: 1;
  overflow-y: auto;
  padding: 0 24rpx;
  width: 100%;
  box-sizing: border-box;
}

/* 隐藏滚动条 */
.scroll-content::-webkit-scrollbar {
  display: none;
}

/* 日期区 */
.date-section {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 32rpx 20rpx;
  margin-top: 24rpx;
  width: 100%;
  box-sizing: border-box;
}

.date-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.date-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1A1A1A;
}

.date-picker {
  font-size: 28rpx;
  color: #666666;
}

.dropdown {
  margin-left: 8rpx;
}

/* 星期 */
.week-row, .day-row {
  display: flex;
  justify-content: space-around;
}

.week-item, .day-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 80rpx;
}

.week-name {
  font-size: 24rpx;
  color: #999999;
  margin-bottom: 16rpx;
}

.day-num {
  width: 64rpx;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  border-radius: 50%;
  font-size: 28rpx;
  color: #666666;
}

.day-item.today .day-num {
  background: #4A90D9;
  color: #FFFFFF;
}

/* 时间轴大卡片 */

/* 事件类型颜色 */
.timeline-item.type-course .timeline-dot { background: #4A90D9; border-color: #4A90D9; }
.timeline-item.type-course .event-title { color: #2B6CB0; }
.timeline-item.type-exam .timeline-dot { background: #E53E3E; border-color: #E53E3E; }
.timeline-item.type-exam .event-title { color: #C53030; font-weight: bold; }
.timeline-item.type-todo .timeline-dot { background: #48BB78; border-color: #48BB78; }
.timeline-item.type-todo .event-title { color: #2F855A; }
.timeline-item.type-aiplan .timeline-dot { background: #9F7AEA; border-color: #9F7AEA; }
.timeline-item.type-aiplan .event-title { color: #6B46C1; }

.timeline-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  margin-top: 24rpx;
  padding: 32rpx 24rpx;
  width: 100%;
  box-sizing: border-box;
}

.timeline-list {
  width: 100%;
  display: flex;
  flex-direction: column;
}

.timeline-item {
  display: flex;
  align-items: flex-start;
  position: relative;
}

.time {
  width: 100rpx;
  font-size: 26rpx;
  color: #999999;
  text-align: right;
  padding-right: 24rpx;
  flex-shrink: 0;
  padding-top: 4rpx;
  line-height: 32rpx;
}

.timeline-axis {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex-shrink: 0;
  width: 16rpx;
  position: relative;
  padding-top: 8rpx;
}

.timeline-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #4A90D9;
  flex-shrink: 0;
}

.timeline-line {
  width: 2rpx;
  height: 100%;
  min-height: 60rpx;
  background: #EEEEEE;
  flex: 1;
}

.event-main {
  flex: 1;
  padding-left: 24rpx;
  padding-bottom: 40rpx;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.timeline-item:last-child .event-main {
  padding-bottom: 0;
}

.event-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.event-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1A1A1A;
  line-height: 1.4;
  flex: 1;
  min-width: 0;
}

.event-status-wrap {
  flex-shrink: 0;
  margin-left: 16rpx;
  display: flex;
  align-items: center;
}

.status-badge {
  font-size: 24rpx;
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
  background: #F5F5F5;
  color: #999999;
}

.status-badge.active {
  background: #E8F4FD;
  color: #4A90D9;
}

.event-location {
  font-size: 26rpx;
  color: #999999;
  margin-top: 8rpx;
}

.event-tags {
  display: flex;
  gap: 12rpx;
  margin-top: 12rpx;
}

.tag {
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
}

.tag.todo {
  background: #E8F4FD;
  color: #4A90D9;
}

/* AI建议 */
.ai-tip {
  background: #EBF5FF;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-top: 24rpx;
  width: 100%;
  box-sizing: border-box;
}

.ai-tip-header {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.ai-tip-icon {
  width: 40rpx;
  height: 40rpx;
  margin-right: 12rpx;
}

.ai-tip-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1A1A1A;
}

.ai-tip-content {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
}

.ai-tip-text {
  flex: 1;
  font-size: 28rpx;
  color: #666666;
  line-height: 1.6;
}

.ai-tip-mascot {
  width: 180rpx;
  height: 180rpx;
  margin-left: 3rpx;
  flex-shrink: 0;
}

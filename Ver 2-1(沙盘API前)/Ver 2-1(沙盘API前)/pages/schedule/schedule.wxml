<!-- 固定顶部区域 -->
<view class="fixed-header">
  <!-- 状态栏占位 -->
  <view class="status-bar" style="height: {{statusBarHeight}}px;"></view>
  
  <!-- 自定义导航栏 -->
  <view class="custom-nav">
    <view class="nav-left" bindtap="goBack">
      <text class="back-icon">‹</text>
    </view>
    <view class="nav-title">今日模式</view>
    <view class="nav-right">
      <text class="more-icon">⋯</text>
    </view>
  </view>
</view>

<!-- 可滚动内容区 -->
<scroll-view class="scroll-content" scroll-y>

  <!-- 日期选择区 -->
  <view class="date-section">
    <view class="date-header">
      <view class="date-title">今日日程</view>
      <view class="date-picker">
        <text>7月14日 周一</text>
        <text class="dropdown">＞</text>
      </view>
    </view>
    
    <!-- 星期 -->
    <view class="week-row">
      <view class="week-item" wx:for="{{weekDays}}" wx:key="index">
        <text class="week-name">{{item.name}}</text>
      </view>
    </view>
    
    <!-- 日期 -->
    <view class="day-row">
      <view 
        class="day-item {{item.isToday ? 'today' : ''}}" 
        wx:for="{{days}}" 
        wx:key="date"
      >
        <text class="day-num">{{item.date}}</text>
      </view>
    </view>
  </view>

  <!-- 时间轴大卡片 -->
  <view class="timeline-card">
    <view class="timeline-list">
      <view class="timeline-item type-{{item.eventType || course}}" wx:for="{{scheduleList}}" wx:key="id">
        <view class="time">{{item.time}}</view>
        <view class="timeline-axis">
          <view class="timeline-dot"></view>
          <view class="timeline-line" wx:if="{{index < scheduleList.length - 1}}"></view>
        </view>
        <view class="event-main">
          <view class="event-header">
            <view class="event-title">{{item.title}}</view>
            <view class="event-status-wrap">
              <text class="status-badge {{item.status}}">{{item.statusText}}</text>
            </view>
          </view>
          <view class="event-location" wx:if="{{item.location}}">{{item.location}}</view>
          <view class="event-tags" wx:if="{{item.hasTodo}}">
            <text class="tag todo">待办</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- AI建议 -->
  <view class="ai-tip">
    <view class="ai-tip-header">
      <image class="ai-tip-icon" src="/images/icon-ai-bulb.png" mode="aspectFit"></image>
      <text class="ai-tip-title">AI 建议</text>
    </view>
    <view class="ai-tip-content">
      <view class="ai-tip-text">下午有空闲时间，建议安排高数复习，预留1小时效果更好哦~</view>
      <!-- <image class="ai-tip-mascot" src="/images/mascotsmall.png" mode="aspectFit"></image> -->
    </view>
  </view>

  <!-- 底部留白 -->
  <view style="height: 40rpx;"></view>
</scroll-view>

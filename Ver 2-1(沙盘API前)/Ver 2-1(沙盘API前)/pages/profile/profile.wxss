page {
  background: #F5F7FA;
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow-x: hidden;
  font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Text', 'SF Pro Display', 'Helvetica Neue', 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
}

/* 固定顶部区域 */
.fixed-header {
  flex-shrink: 0;
  background: #F5F7FA;
  width: 100%;
}

.status-bar {
  width: 100%;
}

/* 可滚动内容区 */
.scroll-content {
  flex: 1;
  overflow-y: auto;
  padding: 0 24rpx;
  width: 100%;
  box-sizing: border-box;
}

/* 隐藏滚动条 */
.scroll-content::-webkit-scrollbar {
  display: none;
}

/* 用户信息卡片 */
.user-card {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #E8F4FD 0%, #F0F7FF 100%);
  border-radius: 24rpx;
  padding: 32rpx;
  margin-top: 16rpx;
  width: 100%;
  box-sizing: border-box;
  position: relative;
}

.user-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.user-info {
  flex: 1;
  min-width: 0;
}

.user-name-wrap {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.user-name {
  font-size: 40rpx;
  font-weight: 700;
  color: #1A1A1A;
}

.user-star {
  font-size: 28rpx;
  margin-left: 8rpx;
}

.user-school {
  font-size: 26rpx;
  color: #666666;
  margin-bottom: 16rpx;
}

.user-tags {
  display: flex;
  gap: 16rpx;
}

.user-tag {
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.8);
  border-radius: 24rpx;
  padding: 8rpx 20rpx;
}

.tag-icon {
  width: 28rpx;
  height: 28rpx;
  margin-right: 8rpx;
}

.tag-text {
  font-size: 22rpx;
  color: #666666;
}

.user-arrow {
  font-size: 36rpx;
  color: #999999;
  position: absolute;
  right: 32rpx;
  top: 50%;
  transform: translateY(-50%);
}

/* 区块卡片 */
.section-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 24rpx;
  margin-top: 24rpx;
  width: 100%;
  box-sizing: border-box;
}

.section-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1A1A1A;
}

/* 信息列表 */
.info-list {
  width: 100%;
}

.info-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 2rpx solid #F5F5F5;
}

.info-item:last-child {
  border-bottom: none;
}

.info-left {
  display: flex;
  align-items: center;
}

.info-label {
  font-size: 28rpx;
  color: #1A1A1A;
}

.info-right {
  display: flex;
  align-items: center;
}

.info-value {
  font-size: 28rpx;
  color: #999999;
  margin-right: 8rpx;
}

.info-arrow {
  font-size: 32rpx;
  color: #CCCCCC;
}

/* 功能网格 */
.function-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
  width: 100%;
}

.function-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 0;
}

.function-icon-wrap {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12rpx;
}

.function-icon {
  width: 98rpx;
  height: 98rpx;
}

.function-name {
  font-size: 24rpx;
  color: #666666;
}
